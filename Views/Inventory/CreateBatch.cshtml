@model MediGuard.Models.ViewModels.BatchEntryViewModel

@{
    ViewData["Title"] = "Batch Stock Entry";
}

<style>
    .be-page {
        --be-ink: #12302d;
        --be-teal: #0f766e;
        --be-teal-dark: #0b5a54;
        --be-mint: #e6f4f1;
        --be-line: #dce7e5;
        --be-surface: #f6faf9;
        --be-amber: #b45309;
        color: var(--be-ink);
    }

    /* Page header */
    .be-hero {
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        flex-wrap: wrap;
        background: var(--be-ink);
        color: #fff;
        border-radius: 1rem;
        padding: 1.5rem 1.75rem;
        margin-bottom: 1.5rem;
        position: relative;
        overflow: hidden;
    }
    .be-hero::after {
        content: "";
        position: absolute; right: -40px; top: -60px;
        width: 220px; height: 220px; border-radius: 50%;
        border: 28px solid rgba(255,255,255,.06);
    }
    .be-hero-icon {
        width: 52px; height: 52px; border-radius: .85rem;
        background: var(--be-teal); color: #fff;
        display: grid; place-items: center; font-size: 1.5rem; flex-shrink: 0;
    }
    .be-hero h2 { font-size: 1.5rem; font-weight: 700; margin: 0; letter-spacing: -.01em; }
    .be-hero p { margin: .25rem 0 0; color: rgba(255,255,255,.72); font-size: .9rem; max-width: 52ch; }
    .be-hero .btn { position: relative; z-index: 1; }

    /* Panels */
    .be-panel {
        background: #fff;
        border: 1px solid var(--be-line);
        border-radius: 1rem;
        box-shadow: 0 1px 2px rgba(18,48,45,.04);
    }
    .be-section { padding: 1.5rem 1.75rem; border-bottom: 1px solid var(--be-line); }
    .be-section:last-of-type { border-bottom: 0; }
    .be-section-title {
        display: flex; align-items: center; gap: .6rem;
        font-size: 1rem; font-weight: 650; margin-bottom: 1.1rem;
    }
    .be-section-title .be-chip {
        width: 32px; height: 32px; border-radius: .6rem;
        background: var(--be-mint); color: var(--be-teal);
        display: grid; place-items: center; font-size: 1rem;
    }
    .be-section-title small { font-weight: 400; color: #5f7774; margin-left: .25rem; }

    /* Inputs */
    .be-page .form-label { font-size: .85rem; font-weight: 600; margin-bottom: .35rem; }
    .be-page .form-control,
    .be-page .form-select {
        border-color: #cfdcda; border-radius: .6rem; padding: .6rem .85rem; background-color: #fff;
    }
    .be-page .form-select-lg { font-size: 1rem; padding: .75rem 1rem; }
    .be-page .form-control:focus,
    .be-page .form-select:focus {
        border-color: var(--be-teal);
        box-shadow: 0 0 0 .22rem rgba(15,118,110,.18);
    }
    .be-page .input-group-text {
        background: var(--be-mint); border-color: #cfdcda; color: var(--be-teal-dark); font-weight: 600;
        border-radius: .6rem 0 0 .6rem;
    }
    .be-page .input-group .form-control { border-radius: 0 .6rem .6rem 0; }
    .be-page .field-validation-error,
    .be-page .text-danger { display: block; margin-top: .25rem; }
    .be-page .form-control.input-validation-error,
    .be-page .form-select.input-validation-error { border-color: #dc3545; }

    /* Pricing block */
    .be-pricing {
        background: var(--be-surface);
        border: 1px solid var(--be-line);
        border-radius: .85rem;
        padding: 1.1rem;
    }
    .be-margin {
        height: 100%;
        display: flex; flex-direction: column; justify-content: center; align-items: center;
        background: #fff; border: 1px dashed #b9cfcb; border-radius: .75rem;
        padding: .75rem .5rem; min-height: 86px;
    }
    .be-margin .badge { border-radius: 2rem; transition: background-color .25s ease; }

    .be-totals {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; margin-top: 1rem;
    }
    .be-total {
        background: #fff; border: 1px solid var(--be-line); border-radius: .7rem; padding: .65rem .85rem;
    }
    .be-total span { display: block; font-size: .75rem; color: #5f7774; }
    .be-total strong { font-size: 1.05rem; font-variant-numeric: tabular-nums; }

    /* Footer actions */
    .be-actions {
        display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
        padding: 1.1rem 1.75rem; background: var(--be-surface);
        border-top: 1px solid var(--be-line); border-radius: 0 0 1rem 1rem;
    }
    .be-actions .hint { font-size: .8rem; color: #5f7774; }
    .be-page .btn-primary {
        background: var(--be-teal); border-color: var(--be-teal); border-radius: .65rem; font-weight: 600;
    }
    .be-page .btn-primary:hover,
    .be-page .btn-primary:focus { background: var(--be-teal-dark); border-color: var(--be-teal-dark); }
    .be-page .btn-light { border: 1px solid var(--be-line); border-radius: .65rem; }

    /* FEFO side panel */
    .be-side { position: sticky; top: 1rem; }
    .be-side-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 1.1rem 1.25rem; border-bottom: 1px solid var(--be-line);
    }
    .be-side-head h5 { margin: 0; font-size: 1rem; font-weight: 650; display: flex; align-items: center; gap: .5rem; }
    .be-side-head .bi { color: var(--be-amber); }
    .be-count { background: var(--be-teal) !important; min-width: 2rem; }
    .be-side-body { padding: 1.1rem 1.25rem; max-height: 70vh; overflow-y: auto; }
    .be-empty { text-align: center; padding: 2.5rem 1rem; color: #5f7774; }
    .be-empty .be-empty-icon {
        width: 64px; height: 64px; border-radius: 50%; margin: 0 auto 1rem;
        background: var(--be-mint); color: var(--be-teal);
        display: grid; place-items: center; font-size: 1.7rem;
    }
    .be-note {
        background: #fff7e6; border: 1px solid #f3dfb0; color: #7a4a05;
        border-radius: .65rem; padding: .6rem .8rem; font-size: .8rem; margin-bottom: .9rem;
        display: flex; gap: .5rem; align-items: flex-start;
    }

    /* Batch cards injected by batch-entry.js */
    #fefoBatchesList > * {
        border: 1px solid var(--be-line);
        border-left: 4px solid var(--be-teal);
        border-radius: .7rem;
        background: #fff;
        padding: .7rem .85rem;
        font-size: .85rem;
    }
    #fefoBatchesList > *:first-child { border-left-color: var(--be-amber); background: #fffaf0; }

    /* Validation summary */
    #batchValidationSummary {
        border-radius: .75rem; border: 1px solid #f1b8bd; background: #fdf0f1; color: #842029;
    }

    .be-page .btn:focus-visible,
    .be-page a:focus-visible { outline: 3px solid rgba(15,118,110,.45); outline-offset: 2px; }

    @@media (max-width: 575.98px) {
        .be-hero, .be-section, .be-actions { padding-left: 1.1rem; padding-right: 1.1rem; }
        .be-totals { grid-template-columns: 1fr; }
        .be-side { position: static; }
    }
</style>

<div class="container-fluid py-3 be-page">

    <!-- Page header -->
    <div class="be-hero">
        <div class="d-flex align-items-center gap-3" style="position:relative;z-index:1">
            <div class="be-hero-icon"><i class="bi bi-boxes"></i></div>
            <div>
                <h2>Batch Stock Entry</h2>
                <p>Record incoming stock lots. Dispensing follows First-Expiry, First-Out (FEFO), so the earliest-expiring lot is used first.</p>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-light btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to inventory
        </a>
    </div>

    <div class="row g-4">
        <!-- Main form column -->
        <div class="col-lg-8">
            <div class="be-panel">
                <form id="batchEntryForm" asp-action="CreateBatch" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- Client & server error container -->
                    <div class="px-4 pt-4" id="batchValidationWrap">
                        <div id="batchValidationSummary" class="alert alert-danger d-none mb-0" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <span id="batchValidationMessage">Please review the validation errors below.</span>
                            <ul id="batchErrorList" class="mb-0 mt-2 small"></ul>
                        </div>
                    </div>

                    <!-- Medicine -->
                    <div class="be-section">
                        <div class="be-section-title">
                            <span class="be-chip"><i class="bi bi-capsule"></i></span>
                            Medicine
                        </div>
                        <label asp-for="MedicineId" class="form-label"></label>
                        <select asp-for="MedicineId" asp-items="Model.MedicineList" class="form-select form-select-lg" id="medicineSelect">
                            <option value="">Select a medicine</option>
                        </select>
                        <span asp-validation-for="MedicineId" class="text-danger small"></span>
                    </div>

                    <!-- Lot details -->
                    <div class="be-section">
                        <div class="be-section-title">
                            <span class="be-chip"><i class="bi bi-upc-scan"></i></span>
                            Lot details
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="BatchNumber" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-hash"></i></span>
                                    <input asp-for="BatchNumber" class="form-control" id="batchNumberInput" placeholder="e.g. BATCH-2026-001" autocomplete="off" />
                                </div>
                                <span asp-validation-for="BatchNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Quantity" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-stack"></i></span>
                                    <input asp-for="Quantity" class="form-control" type="number" min="1" id="quantityInput" placeholder="100" />
                                </div>
                                <span asp-validation-for="Quantity" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Pricing -->
                    <div class="be-section">
                        <div class="be-section-title">
                            <span class="be-chip"><i class="bi bi-currency-dollar"></i></span>
                            Pricing <small>per unit</small>
                        </div>
                        <div class="be-pricing">
                            <div class="row g-3 align-items-stretch">
                                <div class="col-md-4">
                                    <label asp-for="PurchasePricePerUnit" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="PurchasePricePerUnit" class="form-control" type="number" step="0.01" min="0.01" id="purchasePriceInput" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="PurchasePricePerUnit" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="SellingPricePerUnit" class="form-label"></label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="SellingPricePerUnit" class="form-control" type="number" step="0.01" min="0.01" id="sellingPriceInput" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="SellingPricePerUnit" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <div class="be-margin">
                                        <span class="form-label mb-1">Profit margin</span>
                                        <span id="profitMarginBadge" class="badge bg-secondary fs-6 py-2 px-3">0.0%</span>
                                    </div>
                                </div>
                            </div>

                            <div class="be-totals" aria-live="polite">
                                <div class="be-total"><span>Lot cost</span><strong id="lotCost">$0.00</strong></div>
                                <div class="be-total"><span>Expected revenue</span><strong id="lotRevenue">$0.00</strong></div>
                                <div class="be-total"><span>Expected profit</span><strong id="lotProfit">$0.00</strong></div>
                            </div>
                        </div>
                    </div>

                    <!-- Dates -->
                    <div class="be-section">
                        <div class="be-section-title">
                            <span class="be-chip"><i class="bi bi-calendar-event"></i></span>
                            Dates
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ManufacturingDate" class="form-label"></label>
                                <input asp-for="ManufacturingDate" class="form-control" type="date" id="manufacturingDateInput" />
                                <span asp-validation-for="ManufacturingDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ExpiryDate" class="form-label"></label>
                                <input asp-for="ExpiryDate" class="form-control" type="date" id="expiryDateInput" />
                                <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="be-actions">
                        <span class="hint"><i class="bi bi-shield-check me-1"></i>Expiry must be after the manufacturing date.</span>
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4" id="btnSubmitBatch">
                                <i class="bi bi-plus-circle me-1"></i> Save batch lot
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- FEFO panel -->
        <div class="col-lg-4">
            <div class="be-panel be-side">
                <div class="be-side-head">
                    <h5><i class="bi bi-clock-history"></i> Active batches (FEFO)</h5>
                    <span class="badge rounded-pill be-count" id="batchCountBadge">0</span>
                </div>
                <div class="be-side-body">
                    <div id="fefoPlaceholder" class="be-empty">
                        <div class="be-empty-icon"><i class="bi bi-box-arrow-in-right"></i></div>
                        <p class="mb-0 small">Select a medicine to see its active batches, earliest expiry first.</p>
                    </div>

                    <div id="fefoLoading" class="text-center py-5 d-none">
                        <div class="spinner-border" style="color:var(--be-teal)" role="status">
                            <span class="visually-hidden">Loading batches...</span>
                        </div>
                        <p class="text-muted small mt-2 mb-0">Loading active stock lots...</p>
                    </div>

                    <div id="fefoBatchesContainer" class="d-none">
                        <div class="be-note">
                            <i class="bi bi-info-circle mt-1"></i>
                            <span>Batches are ordered by earliest expiry date. The top batch is dispensed first.</span>
                        </div>
                        <div id="fefoBatchesList" class="vstack gap-2">
                            <!-- FEFO batch items injected via JS -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/batch-entry.js"></script>
    <script>
        // Live lot totals (cost, revenue, profit). Independent of batch-entry.js.
        (function () {
            const qty = document.getElementById('quantityInput');
            const buy = document.getElementById('purchasePriceInput');
            const sell = document.getElementById('sellingPriceInput');
            const cost = document.getElementById('lotCost');
            const rev = document.getElementById('lotRevenue');
            const profit = document.getElementById('lotProfit');
            if (!qty || !buy || !sell) return;

            const fmt = n => '$' + n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            function update() {
                const q = parseFloat(qty.value) || 0;
                const b = parseFloat(buy.value) || 0;
                const s = parseFloat(sell.value) || 0;
                cost.textContent = fmt(q * b);
                rev.textContent = fmt(q * s);
                profit.textContent = fmt(q * (s - b));
                profit.style.color = (s - b) < 0 ? '#b02a37' : '';
            }

            [qty, buy, sell].forEach(el => el.addEventListener('input', update));
            update();
        })();
    </script>
}
