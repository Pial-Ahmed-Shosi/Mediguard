@model MediGuard.Models.ViewModels.PrescriptionReviewViewModel

@{
    var initial = string.IsNullOrWhiteSpace(Model.CustomerName) ? "?" : Model.CustomerName.Trim().Substring(0, 1).ToUpper();
    var rxCount = Model.Items.Count(i => i.RequiresPrescription);
}

<style>
    .mg-review {
        --mg-900: #064e3b;
        --mg-800: #065f46;
        --mg-700: #047857;
        --mg-600: #059669;
        --mg-500: #10b981;
        --mg-100: #d1fae5;
        --mg-50:  #ecfdf5;
        --mg-ink: #1f2937;
        --mg-muted: #6b7280;
        --mg-line: #e3efe9;
        color: var(--mg-ink);
    }

    /* Cards */
    .mg-review .mg-card {
        background: #fff;
        border: 1px solid var(--mg-line);
        border-radius: 14px;
        box-shadow: 0 1px 2px rgba(6, 78, 59, .05), 0 8px 24px rgba(6, 78, 59, .06);
        overflow: hidden;
        margin-bottom: 1.25rem;
    }
    .mg-review .mg-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        padding: 1rem 1.25rem;
        background: var(--mg-50);
        border-bottom: 1px solid var(--mg-line);
    }
    .mg-review .mg-card-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: var(--mg-900);
        display: flex;
        align-items: center;
        gap: .6rem;
    }
    .mg-review .mg-icon-chip {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: var(--mg-600);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .95rem;
    }

    /* Order badge */
    .mg-review .mg-order-badge {
        background: var(--mg-900);
        color: #fff;
        font-weight: 600;
        font-size: .8rem;
        padding: .4rem .75rem;
        border-radius: 999px;
        letter-spacing: .01em;
    }

    /* Customer */
    .mg-review .mg-avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--mg-500), var(--mg-800));
        color: #fff;
        font-size: 1.4rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .mg-review .mg-contact {
        display: flex;
        align-items: center;
        gap: .6rem;
        font-size: .9rem;
        color: var(--mg-muted);
        margin-top: .35rem;
    }
    .mg-review .mg-contact i { color: var(--mg-600); }
    .mg-review .mg-contact span { color: var(--mg-ink); word-break: break-word; }

    /* Table */
    .mg-review .mg-table { margin: 0; }
    .mg-review .mg-table thead th {
        background: #fff;
        color: var(--mg-muted);
        font-size: .78rem;
        font-weight: 600;
        border-bottom: 2px solid var(--mg-100);
        padding: .8rem 1.25rem;
        white-space: nowrap;
    }
    .mg-review .mg-table tbody td {
        padding: .95rem 1.25rem;
        border-color: var(--mg-line);
    }
    .mg-review .mg-table tbody tr:hover { background: var(--mg-50); }
    .mg-review .mg-item-name { font-weight: 700; color: var(--mg-900); }
    .mg-review .mg-item-generic { font-size: .8rem; color: var(--mg-muted); }
    .mg-review .mg-qty {
        display: inline-block;
        min-width: 2rem;
        padding: .15rem .55rem;
        border-radius: 999px;
        background: var(--mg-100);
        color: var(--mg-800);
        font-weight: 700;
        font-size: .8rem;
    }
    .mg-review .mg-rx-tag {
        display: inline-flex;
        align-items: center;
        gap: .25rem;
        margin-top: .35rem;
        padding: .15rem .55rem;
        border-radius: 6px;
        background: #fef3c7;
        color: #92400e;
        font-size: .72rem;
        font-weight: 600;
    }
    .mg-review .mg-total-row {
        background: var(--mg-900);
        color: #fff;
    }
    .mg-review .mg-total-row td {
        padding: 1rem 1.25rem;
        border: 0;
    }
    .mg-review .mg-total-amount { font-size: 1.25rem; font-weight: 800; color: #6ee7b7; }

    /* Decision box */
    .mg-review .mg-decision-note {
        display: flex;
        gap: .6rem;
        align-items: flex-start;
        padding: .75rem 1rem;
        border-radius: 10px;
        background: var(--mg-50);
        border: 1px solid var(--mg-100);
        color: var(--mg-800);
        font-size: .85rem;
        margin-bottom: 1rem;
    }
    .mg-review .btn-mg-approve {
        background: linear-gradient(135deg, var(--mg-600), var(--mg-700));
        border: 0;
        color: #fff;
        font-weight: 700;
        padding: .85rem 1.25rem;
        border-radius: 10px;
        box-shadow: 0 6px 16px rgba(5, 150, 105, .3);
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .mg-review .btn-mg-approve:hover,
    .mg-review .btn-mg-approve:focus-visible {
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 10px 22px rgba(5, 150, 105, .38);
    }
    .mg-review .btn-mg-reject {
        background: #fff;
        border: 2px solid #dc2626;
        color: #b91c1c;
        font-weight: 700;
        padding: .85rem 1.25rem;
        border-radius: 10px;
        transition: background .15s ease, color .15s ease;
    }
    .mg-review .btn-mg-reject:hover,
    .mg-review .btn-mg-reject:focus-visible {
        background: #dc2626;
        color: #fff;
    }

    /* Modal (lives outside .mg-review, so scoped by id) */
    #rejectionModal .modal-content {
        border: 0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(6, 78, 59, .25);
    }
    #rejectionModal .modal-header {
        background: linear-gradient(135deg, #991b1b, #dc2626);
        color: #fff;
        padding: 1rem 1.25rem;
    }
    #rejectionModal .preset-reason-btn {
        border-radius: 999px;
        border: 1px solid #a7f3d0;
        background: #ecfdf5;
        color: #065f46;
        font-weight: 600;
        padding: .3rem .8rem;
    }
    #rejectionModal .preset-reason-btn:hover,
    #rejectionModal .preset-reason-btn.active {
        background: #059669;
        border-color: #059669;
        color: #fff;
    }
    #rejectionModal .form-control:focus {
        border-color: #10b981;
        box-shadow: 0 0 0 .2rem rgba(16, 185, 129, .2);
    }
    #rejectionModal .modal-footer { background: #f8fdfb; border-top: 1px solid #e3efe9; }

    @@media (max-width: 575.98px) {
        .mg-review .mg-table thead th,
        .mg-review .mg-table tbody td,
        .mg-review .mg-total-row td { padding-left: .85rem; padding-right: .85rem; }
    }
</style>

<div class="mg-review">

    <!-- Customer Profile -->
    <div class="mg-card">
        <div class="mg-card-header">
            <h6 class="mg-card-title">
                <span class="mg-icon-chip"><i class="bi bi-person-lines-fill"></i></span>
                Customer Profile
            </h6>
            <span class="mg-order-badge">Order #@Model.OrderNumber</span>
        </div>
        <div class="p-3 p-md-4">
            <div class="d-flex align-items-center gap-3">
                <div class="mg-avatar" aria-hidden="true">@initial</div>
                <div class="flex-grow-1">
                    <div class="fw-bold fs-5" style="color: var(--mg-900);">@Model.CustomerName</div>
                    <div class="mg-contact"><i class="bi bi-envelope-fill"></i><span>@Model.CustomerEmail</span></div>
                    <div class="mg-contact"><i class="bi bi-telephone-fill"></i><span>@(string.IsNullOrEmpty(Model.CustomerPhone) ? "N/A" : Model.CustomerPhone)</span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Line Items -->
    <div class="mg-card">
        <div class="mg-card-header">
            <h6 class="mg-card-title">
                <span class="mg-icon-chip"><i class="bi bi-cart-check"></i></span>
                Order Line Items
            </h6>
            @if (rxCount > 0)
            {
                <span class="mg-rx-tag mt-0"><i class="bi bi-capsule"></i>@rxCount prescription @(rxCount == 1 ? "item" : "items")</span>
            }
        </div>
        <div class="table-responsive">
            <table class="table mg-table align-middle">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Price</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="mg-item-name">@item.BrandName</div>
                                <div class="mg-item-generic">@item.GenericName</div>
                                @if (item.RequiresPrescription)
                                {
                                    <span class="mg-rx-tag"><i class="bi bi-prescription2"></i>Rx required</span>
                                }
                            </td>
                            <td class="text-center"><span class="mg-qty">@item.Quantity</span></td>
                            <td class="text-end text-nowrap">$@item.UnitPrice.ToString("F2")</td>
                            <td class="text-end text-nowrap fw-bold" style="color: var(--mg-800);">$@item.LineTotal.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="mg-total-row">
                        <td colspan="3" class="text-end">Grand total</td>
                        <td class="text-end text-nowrap mg-total-amount">$@Model.TotalAmount.ToString("F2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Verification Action Box -->
    <div class="mg-card">
        <div class="mg-card-header">
            <h6 class="mg-card-title">
                <span class="mg-icon-chip"><i class="bi bi-shield-check"></i></span>
                Pharmacist Verification Decision
            </h6>
        </div>
        <div class="p-3 p-md-4">
            <div class="mg-decision-note">
                <i class="bi bi-info-circle-fill mt-1"></i>
                <div>Check the prescription against the items above. Approving moves the order to fulfilment; rejecting requires a reason that is sent to the customer.</div>
            </div>

            <div id="verification-status-alert" class="d-none alert mb-3"></div>

            <div class="d-grid gap-2 d-md-flex">
                <button type="button" id="btn-approve-rx" class="btn btn-mg-approve btn-lg flex-fill" data-prescription-id="@Model.PrescriptionId">
                    <i class="bi bi-check-circle-fill me-2"></i>Approve prescription
                </button>

                <button type="button" id="btn-reject-rx" class="btn btn-mg-reject btn-lg flex-fill" data-bs-toggle="modal" data-bs-target="#rejectionModal">
                    <i class="bi bi-x-circle-fill me-2"></i>Reject order
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Mandatory Rejection Modal -->
<div class="modal fade" id="rejectionModal" tabindex="-1" aria-labelledby="rejectionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rejectionModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Reject prescription</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="small text-muted mb-3">Enter a reason for rejecting this prescription. It is recorded and sent directly to the customer.</p>

                <label class="form-label fw-bold small">Common reasons</label>
                <div class="mb-3 d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm preset-reason-btn">Illegible Document</button>
                    <button type="button" class="btn btn-sm preset-reason-btn">Expired Prescription Date</button>
                    <button type="button" class="btn btn-sm preset-reason-btn">Mismatched Doctor Name</button>
                </div>

                <div class="mb-1">
                    <label for="rejection-reason-text" class="form-label fw-bold small">Rejection note <span class="text-danger">*</span></label>
                    <textarea id="rejection-reason-text" class="form-control" rows="3" placeholder="Describe why this prescription can't be approved..."></textarea>
                    <div id="modal-validation-error" class="text-danger small d-none mt-1">Rejection reason is required.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btn-confirm-reject" class="btn btn-danger px-4" data-prescription-id="@Model.PrescriptionId">
                    Confirm rejection
                </button>
            </div>
        </div>
    </div>
</div>
