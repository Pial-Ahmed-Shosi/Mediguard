@model MediGuard.Models.Prescription

@{
    ViewData["Title"] = "Prescription Review";
    Layout = "_Layout";
    var isPdf = Model.FileType?.ToLower() == "pdf";
}

@section Styles {
<style>
    :root {
        --rx-teal: #007a78;
        --rx-teal-dark: #005f5d;
        --rx-teal-light: #e6f4f3;
        --rx-danger: #dc3545;
        --rx-success: #198754;
        --rx-border: #e0e7e7;
    }

    .rx-review-page {
        background: #f4f7f6;
        min-height: 100vh;
        padding: 1.5rem 0 4rem;
    }

    /* Page Header */
    .rx-review-header {
        background: linear-gradient(135deg, var(--rx-teal), var(--rx-teal-dark));
        border-radius: 16px;
        padding: 1.5rem 2rem;
        color: #fff;
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .rx-review-header h1 {
        font-size: 1.3rem;
        font-weight: 800;
        margin: 0 0 0.2rem;
    }

    .rx-review-header p {
        margin: 0;
        opacity: 0.85;
        font-size: 0.85rem;
    }

    /* Status badge */
    .rx-status-pill {
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    /* Split-View Layout */
    .rx-split-view {
        display: grid;
        grid-template-columns: 1fr 420px;
        gap: 1.5rem;
        align-items: start;
    }

    @@media (max-width: 991px) {
        .rx-split-view {
            grid-template-columns: 1fr;
        }
    }

    /* Image Viewer Panel */
    .rx-viewer-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,122,120,0.07);
        border: 1px solid var(--rx-border);
        overflow: hidden;
    }

    .rx-viewer-toolbar {
        background: #f8fafa;
        border-bottom: 1px solid var(--rx-border);
        padding: 0.75rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .rx-viewer-toolbar .toolbar-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #4b6060;
        margin-right: auto;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .rx-tool-btn {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid var(--rx-border);
        background: #fff;
        color: var(--rx-teal);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

    .rx-tool-btn:hover {
        background: var(--rx-teal-light);
        border-color: var(--rx-teal);
    }

    .rx-viewer-body {
        padding: 1.5rem;
        min-height: 420px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fafbfb;
        overflow: hidden;
    }

    #rxPrescriptionImg {
        max-width: 100%;
        max-height: 520px;
        object-fit: contain;
        border-radius: 8px;
        transition: transform 0.3s ease;
        transform-origin: center center;
        cursor: zoom-in;
    }

    .rx-pdf-viewer {
        width: 100%;
        height: 520px;
        border: none;
        border-radius: 8px;
    }

    /* Right Panel */
    .rx-right-panel {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .rx-panel-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,122,120,0.06);
        border: 1px solid var(--rx-border);
        padding: 1.5rem;
    }

    .rx-panel-card h3 {
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #4b6060;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    /* Details Rows */
    .rx-detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.55rem 0;
        border-bottom: 1px dashed #eef2f2;
        font-size: 0.85rem;
    }

    .rx-detail-row:last-child {
        border-bottom: none;
    }

    .rx-detail-label {
        color: #6b7280;
        font-weight: 500;
    }

    .rx-detail-value {
        font-weight: 600;
        color: #111827;
        max-width: 60%;
        text-align: right;
    }

    .rx-rejection-box {
        background: #fff5f5;
        border: 1px solid #fca5a5;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 0.83rem;
        color: #7f1d1d;
    }

    /* Order Items */
    .rx-order-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.55rem 0;
        border-bottom: 1px dashed #eef2f2;
        font-size: 0.85rem;
    }

    .rx-order-item:last-child { border-bottom: none; }

    /* Action Buttons */
    .btn-rx-approve {
        background: var(--rx-success);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.7rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 700;
        transition: all 0.2s ease;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .btn-rx-approve:hover:not(:disabled) {
        background: #146c43;
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(25, 135, 84, 0.3);
        color: #fff;
    }

    .btn-rx-reject {
        background: var(--rx-danger);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.7rem 1.5rem;
        font-size: 0.9rem;
        font-weight: 700;
        transition: all 0.2s ease;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .btn-rx-reject:hover:not(:disabled) {
        background: #b02a37;
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(220, 53, 69, 0.3);
        color: #fff;
    }

    .btn-rx-approve:disabled,
    .btn-rx-reject:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    /* Success/Error banners */
    .rx-action-result {
        border-radius: 10px;
        padding: 0.75rem 1rem;
        font-size: 0.85rem;
        font-weight: 600;
        display: none;
        margin-top: 0.5rem;
    }
</style>
}

<div class="rx-review-page">
    <div class="container-fluid px-lg-5">

        <!-- Page Header -->
        <div class="rx-review-header">
            <div>
                <h1>
                    <i class="bi bi-file-earmark-medical me-2"></i>
                    Prescription Review
                </h1>
                <p>Order <strong>#@Model.OrderId.ToString().Substring(0, 8).ToUpper()</strong> &bull; Submitted @Model.CreatedAt.ToString("dd MMM yyyy")</p>
            </div>
            @{
                var pillClass = Model.Status switch
                {
                    "APPROVED" => "bg-success text-white",
                    "REJECTED" => "bg-danger text-white",
                    _ => "bg-warning text-dark"
                };
            }
            <span class="rx-status-pill @pillClass">@Model.Status</span>
        </div>

        <!-- Split View -->
        <div class="rx-split-view">

            <!-- LEFT: Interactive Image Viewer -->
            <div class="rx-viewer-card">
                <div class="rx-viewer-toolbar">
                    <span class="toolbar-label"><i class="bi bi-zoom-in me-1"></i> Document Viewer</span>

                    @if (!isPdf)
                    {
                        <button type="button" class="rx-tool-btn" id="btnZoomIn" title="Zoom In" aria-label="Zoom in">
                            <i class="bi bi-zoom-in"></i>
                        </button>
                        <button type="button" class="rx-tool-btn" id="btnZoomOut" title="Zoom Out" aria-label="Zoom out">
                            <i class="bi bi-zoom-out"></i>
                        </button>
                        <button type="button" class="rx-tool-btn" id="btnRotate" title="Rotate" aria-label="Rotate image">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        <button type="button" class="rx-tool-btn" id="btnFullscreen" title="Fullscreen" aria-label="View fullscreen">
                            <i class="bi bi-fullscreen"></i>
                        </button>
                    }
                </div>

                <div class="rx-viewer-body" id="rxViewerBody">
                    @if (isPdf)
                    {
                        <iframe class="rx-pdf-viewer"
                                src="@Model.FilePath"
                                title="Prescription PDF"
                                aria-label="Uploaded prescription PDF document">
                        </iframe>
                    }
                    else
                    {
                        <img id="rxPrescriptionImg"
                             src="@Model.FilePath"
                             alt="Uploaded prescription"
                             loading="eager" />
                    }
                </div>
            </div>

            <!-- RIGHT: Order Info + Verification -->
            <div class="rx-right-panel">

                <!-- Prescription Details -->
                <div class="rx-panel-card">
                    <h3><i class="bi bi-info-circle"></i> Prescription Details</h3>
                    @await Html.PartialAsync("_PrescriptionDetails", Model)
                </div>

                <!-- Order Line Items -->
                @if (Model.Order?.OrderItems != null && Model.Order.OrderItems.Any())
                {
                    <div class="rx-panel-card">
                        <h3><i class="bi bi-cart3"></i> Order Items</h3>
                        @foreach (var item in Model.Order.OrderItems)
                        {
                            <div class="rx-order-item">
                                <span>@(item.Medicine?.BrandName ?? item.MedicineId.ToString().Substring(0, 8))</span>
                                <span class="fw-semibold">Qty: @item.Quantity &nbsp;&bull;&nbsp; ৳@item.UnitPrice.ToString("N2")</span>
                            </div>
                        }
                        <div class="rx-order-item">
                            <span class="fw-bold">Order Total</span>
                            <span class="fw-bold text-success">৳@Model.Order.TotalAmount.ToString("N2")</span>
                        </div>
                    </div>
                }

                <!-- Customer Info -->
                @if (Model.Customer != null)
                {
                    <div class="rx-panel-card">
                        <h3><i class="bi bi-person-circle"></i> Customer</h3>
                        <div class="rx-detail-row">
                            <span class="rx-detail-label">Name</span>
                            <span class="rx-detail-value">@(Model.Customer.FullName ?? Model.Customer.UserName)</span>
                        </div>
                        <div class="rx-detail-row">
                            <span class="rx-detail-label">Email</span>
                            <span class="rx-detail-value">@Model.Customer.Email</span>
                        </div>
                    </div>
                }

                <!-- Verification Action Box -->
                @if (Model.Status == "PENDING")
                {
                    <div class="rx-panel-card" id="rxActionBox">
                        <h3><i class="bi bi-shield-check"></i> Verification Decision</h3>

                        <div id="rxActionResult" class="rx-action-result" role="alert" aria-live="assertive"></div>

                        <button type="button"
                                id="btnApprove"
                                class="btn-rx-approve"
                                data-prescription-id="@Model.Id">
                            <i class="bi bi-check2-circle"></i>
                            Approve Prescription
                        </button>

                        <button type="button"
                                id="btnReject"
                                class="btn-rx-reject"
                                data-bs-toggle="modal"
                                data-bs-target="#rejectModal"
                                data-prescription-id="@Model.Id">
                            <i class="bi bi-x-circle"></i>
                            Reject Prescription
                        </button>
                    </div>
                }
                else
                {
                    <div class="rx-panel-card text-center py-3">
                        <i class="bi @(Model.Status == "APPROVED" ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger") fs-2"></i>
                        <div class="mt-2 fw-semibold">This prescription has already been @Model.Status.ToLower().</div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<!-- Rejection Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px; overflow:hidden;">
            <div class="modal-header border-0 pb-0" style="background:#fff5f5;">
                <h5 class="modal-title fw-bold text-danger" id="rejectModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Reject Prescription
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2" style="background:#fff5f5;">
                <p class="text-muted small mb-3">
                    Please provide a reason for rejection. This message will be sent to the customer.
                </p>
                <label for="rejectReasonInput" class="form-label fw-semibold">Rejection Reason <span class="text-danger">*</span></label>
                <textarea id="rejectReasonInput"
                          class="form-control"
                          rows="4"
                          maxlength="500"
                          placeholder="e.g. Illegible Document, Expired Prescription Date, Mismatched Doctor Name..."
                          style="border-radius:10px;"></textarea>
                <div id="rejectReasonError" class="text-danger small mt-1" hidden>A rejection reason is required.</div>

                <!-- Quick-pick suggestions -->
                <div class="mt-2 d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary rx-reason-chip" data-reason="Illegible Document">Illegible Document</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rx-reason-chip" data-reason="Expired Prescription Date">Expired Prescription Date</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rx-reason-chip" data-reason="Mismatched Doctor Name">Mismatched Doctor Name</button>
                </div>
            </div>
            <div class="modal-footer border-0 bg-white">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnConfirmReject" class="btn btn-danger fw-bold px-4"
                        data-prescription-id="@Model.Id">
                    <i class="bi bi-x-circle me-1"></i> Confirm Rejection
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/prescription-review.js" asp-append-version="true"></script>
}
