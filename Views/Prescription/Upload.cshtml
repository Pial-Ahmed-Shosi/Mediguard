@model MediGuard.Models.ViewModels.PrescriptionUploadViewModel

@{
    ViewData["Title"] = "Upload Prescription";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

    .rx-page {
        /* Green palette */
        --g-950: #04261c;
        --g-900: #063a2c;
        --g-800: #0a5340;
        --g-700: #0b6b55;
        --g-600: #12805d;
        --g-500: #1a9a72;
        --g-400: #3fb88c;
        --g-300: #8fd3b6;
        --g-200: #c3e8d6;
        --g-100: #e1f3ea;
        --g-50:  #f1f9f5;
        --ink:   #10241b;
        --muted: #5d7468;
        --line:  #d8e9df;
        --danger: #b42318;

        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
        color: var(--ink);
        background:
            radial-gradient(1000px 380px at 50% -120px, rgba(26, 154, 114, .20), transparent 70%),
            radial-gradient(500px 300px at 100% 40%, rgba(143, 211, 182, .18), transparent 70%),
            linear-gradient(180deg, #eef8f2 0%, #ffffff 460px);
        padding: 2.25rem 0 3.5rem;
        min-height: 100%;
    }

    /* ================= CARD SHELL ================= */
    .rx-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 1.5rem;
        overflow: hidden;
        box-shadow:
            0 40px 70px -40px rgba(6, 58, 44, .55),
            0 6px 18px -10px rgba(6, 58, 44, .18);
    }

    /* ================= HEADER ================= */
    .rx-header {
        position: relative;
        overflow: hidden;
        padding: 1.9rem 2rem 1.7rem;
        color: #fff;
        background: linear-gradient(135deg, #04261c 0%, #0a5340 50%, #12805d 100%);
    }
    .rx-header::before,
    .rx-header::after {
        content: "";
        position: absolute;
        pointer-events: none;
        border-radius: 50%;
    }
    .rx-header::before {
        width: 260px; height: 260px; right: -80px; top: -120px;
        background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, .16), rgba(255, 255, 255, .03));
    }
    .rx-header::after {
        width: 170px; height: 170px; right: 80px; bottom: -100px;
        background: rgba(126, 224, 181, .16);
    }
    .rx-header > * { position: relative; z-index: 1; }

    /* subtle medical cross watermark */
    .rx-cross {
        position: absolute !important;
        right: 1.6rem; bottom: 1.2rem;
        width: 54px; height: 54px;
        opacity: .13;
    }
    .rx-cross::before, .rx-cross::after {
        content: ""; position: absolute; background: #fff; border-radius: 4px;
    }
    .rx-cross::before { left: 20px; top: 0; width: 14px; height: 54px; }
    .rx-cross::after  { left: 0; top: 20px; width: 54px; height: 14px; }

    .rx-head-row { display: flex; align-items: center; gap: 1.05rem; }
    .rx-head-icon {
        width: 58px; height: 58px; flex-shrink: 0;
        border-radius: 1.1rem;
        background: rgba(255, 255, 255, .15);
        border: 1px solid rgba(255, 255, 255, .25);
        backdrop-filter: blur(4px);
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 1.75rem;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .25);
    }
    .rx-head-title {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 1.45rem; font-weight: 700;
        margin: 0 0 .25rem; letter-spacing: -.01em; line-height: 1.2;
    }
    .rx-head-sub { font-size: .85rem; margin: 0; color: rgba(255, 255, 255, .8); line-height: 1.5; }

    .rx-order {
        display: inline-flex; align-items: center; gap: .55rem;
        margin-top: 1.3rem;
        background: rgba(255, 255, 255, .12);
        border: 1px solid rgba(255, 255, 255, .22);
        border-radius: 999px;
        padding: .42rem 1rem;
        font-size: .76rem; color: rgba(255, 255, 255, .85);
    }
    .rx-order i { color: #9ff0cd; }
    .rx-order strong { color: #fff; font-weight: 700; letter-spacing: .03em; }

    /* ================= STEPS ================= */
    .rx-steps {
        list-style: none; margin: 0; padding: 1.1rem 2rem;
        display: flex; align-items: center; gap: .6rem;
        background: var(--g-50);
        border-bottom: 1px solid var(--line);
    }
    .rx-steps li {
        display: inline-flex; align-items: center; gap: .55rem;
        font-size: .76rem; font-weight: 600; color: #7a8f84;
        white-space: nowrap;
    }
    .rx-steps li span {
        width: 26px; height: 26px; border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: .7rem; font-weight: 700;
        background: #fff; border: 1.5px solid #cfe0d6; color: #7a8f84;
    }
    .rx-steps li.active { color: var(--g-700); }
    .rx-steps li.active span {
        background: linear-gradient(145deg, var(--g-500), var(--g-700));
        border-color: transparent; color: #fff;
        box-shadow: 0 0 0 4px rgba(18, 128, 93, .16);
    }
    .rx-steps .rx-line { flex: 1; height: 2px; background: #d6e6dd; border-radius: 2px; min-width: 14px; }

    /* ================= BODY ================= */
    .rx-body { padding: 1.75rem 2rem 1.9rem; }

    .rx-formats {
        display: flex; flex-wrap: wrap; align-items: center; gap: .5rem;
        background: var(--g-50);
        border: 1px solid var(--line);
        border-radius: .95rem;
        padding: .8rem 1rem;
        margin-bottom: 1.35rem;
    }
    .rx-formats .lead-in {
        font-size: .78rem; font-weight: 600; color: var(--g-800);
        margin-right: .3rem; display: inline-flex; align-items: center; gap: .45rem;
    }
    .rx-formats .lead-in i { color: var(--g-600); font-size: 1rem; }
    .rx-chip {
        display: inline-flex; align-items: center; gap: .35rem;
        background: #fff; border: 1px solid var(--line); color: var(--g-800);
        font-size: .7rem; font-weight: 700; letter-spacing: .02em;
        padding: .28rem .7rem; border-radius: 999px;
    }
    .rx-chip i { color: var(--g-600); }
    .rx-chip.size { background: var(--g-700); border-color: var(--g-700); color: #fff; }
    .rx-chip.size i { color: #bff0d9; }

    /* ================= DROP ZONE ================= */
    .rx-drop {
        position: relative;
        text-align: center;
        padding: 2.4rem 1.5rem 2.1rem;
        margin-bottom: 1.1rem;
        border: 2px dashed #8fd3b6;
        border-radius: 1.25rem;
        background:
            radial-gradient(320px 140px at 50% 0, rgba(26, 154, 114, .12), transparent 75%),
            #f6fcf9;
        cursor: pointer;
        transition: border-color .2s, background-color .2s, transform .2s, box-shadow .2s;
    }
    .rx-drop:hover {
        border-color: var(--g-500);
        background-color: #eef9f3;
        box-shadow: 0 18px 34px -24px rgba(6, 58, 44, .65);
        transform: translateY(-1px);
    }
    .rx-drop:focus-within { outline: 3px solid rgba(26, 154, 114, .35); outline-offset: 3px; }
    .rx-drop.drop-zone-active {
        border-color: var(--g-600) !important;
        border-style: solid !important;
        background-color: var(--g-100) !important;
        box-shadow: 0 0 0 .35rem rgba(18, 128, 93, .15) !important;
    }
    .rx-drop-icon {
        position: relative;
        width: 82px; height: 82px; margin: 0 auto 1rem;
        border-radius: 50%;
        background: linear-gradient(145deg, var(--g-100), #fff);
        border: 1px solid #bfe3d0;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 14px 26px -14px rgba(18, 128, 93, .7);
    }
    .rx-drop-icon::after {
        content: "";
        position: absolute; inset: -10px;
        border-radius: 50%;
        border: 1px solid rgba(26, 154, 114, .3);
        animation: rxPulse 2.8s ease-out infinite;
    }
    .rx-drop-icon i { font-size: 2.15rem; color: var(--g-600); line-height: 1; }
    .rx-drop h6 { font-size: 1.02rem; font-weight: 700; margin: 0 0 .3rem; color: var(--ink); }
    .rx-drop .rx-sub { font-size: .8rem; color: var(--muted); display: block; margin-bottom: 1.1rem; }
    .rx-browse {
        display: inline-flex; align-items: center; gap: .5rem;
        background: #fff; color: var(--g-700);
        border: 1.5px solid var(--g-600); border-radius: 999px;
        padding: .5rem 1.3rem;
        font-size: .8rem; font-weight: 700;
        transition: background .2s, color .2s;
    }
    .rx-drop:hover .rx-browse,
    .rx-drop.drop-zone-active .rx-browse { background: var(--g-600); color: #fff; }

    @@keyframes rxPulse {
        0%   { transform: scale(.92); opacity: .9; }
        100% { transform: scale(1.2); opacity: 0; }
    }

    /* ================= PREVIEW ================= */
    .rx-preview {
        border: 1px solid var(--line);
        border-radius: 1.1rem;
        background: #fff;
        margin-bottom: 1.1rem;
        box-shadow: 0 14px 30px -24px rgba(6, 58, 44, .6);
        border-top: 3px solid var(--g-500);
    }
    .rx-preview .card-body { padding: 1.2rem; }
    .rx-preview .btn-close {
        background-color: #fff;
        border-radius: 50%;
        padding: .5rem;
        box-shadow: 0 2px 10px rgba(6, 58, 44, .22);
        opacity: 1;
        z-index: 2;
    }
    .rx-preview .btn-close:hover { background-color: #fde8e8; }
    #image-preview { border-color: var(--line) !important; background: var(--g-50); }
    .rx-pdf {
        padding: 1.4rem;
        background: var(--g-50);
        border: 1px solid var(--line);
        border-radius: .95rem;
    }
    .rx-pdf i { color: #d9534f; }
    .rx-pdf #pdf-file-name { color: var(--ink); }

    /* ================= VALIDATION ================= */
    #file-validation-error {
        border: 1px solid #f3c6c6; background: #fff5f5; color: var(--danger);
        border-radius: .9rem; font-size: .8rem; font-weight: 500;
    }

    /* ================= TIPS ================= */
    .rx-tips {
        margin: 0 0 1.5rem; padding: 1rem 1.1rem;
        list-style: none;
        background: #fff;
        border: 1px solid var(--line);
        border-left: 4px solid var(--g-500);
        border-radius: .9rem;
    }
    .rx-tips-title { font-size: .78rem; font-weight: 700; color: var(--g-800); margin: 0 0 .55rem; }
    .rx-tips li {
        display: flex; align-items: flex-start; gap: .55rem;
        font-size: .78rem; color: var(--muted); line-height: 1.5;
        padding: .15rem 0;
    }
    .rx-tips li i { color: var(--g-500); margin-top: .12rem; flex-shrink: 0; }

    /* ================= NOTES ================= */
    .rx-notes label { font-size: .82rem; font-weight: 700; color: var(--g-800); margin-bottom: .45rem; }
    .rx-notes textarea {
        border: 1px solid var(--line);
        border-radius: .95rem;
        background: #fbfdfc;
        font-size: .88rem;
        padding: .85rem 1rem;
        resize: vertical;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }
    .rx-notes textarea::placeholder { color: #98aea3; }
    .rx-notes textarea:focus {
        border-color: var(--g-500); background: #fff;
        box-shadow: 0 0 0 .25rem rgba(26, 154, 114, .18);
    }

    /* ================= BUTTONS ================= */
    .rx-submit {
        border: 0; border-radius: 1rem;
        padding: .95rem 1.25rem;
        font-size: .98rem; font-weight: 700; color: #fff;
        background: linear-gradient(90deg, var(--g-800), var(--g-500));
        box-shadow: 0 18px 30px -16px rgba(18, 128, 93, .9);
        transition: filter .2s, transform .2s, box-shadow .2s;
    }
    .rx-submit:hover:not(:disabled) { filter: brightness(1.07); transform: translateY(-1px); color: #fff; }
    .rx-submit:active:not(:disabled) { transform: translateY(0); }
    .rx-submit:focus-visible { outline: 3px solid rgba(26, 154, 114, .4); outline-offset: 2px; }
    .rx-submit:disabled {
        background: #e4f1ea;
        color: #3d5a4c;
        border: 1.5px dashed #9fcbb5;
        box-shadow: none;
        cursor: not-allowed;
        opacity: 1;
    }
    .rx-submit:disabled i { color: #5f8a75; }
    .rx-cancel {
        border: 1.5px solid var(--line); border-radius: 1rem;
        background: #fff; color: var(--muted);
        padding: .75rem 1rem; font-size: .88rem; font-weight: 600;
        transition: all .2s;
    }
    .rx-cancel:hover { border-color: var(--g-600); color: var(--g-700); background: var(--g-50); }
    .rx-cancel:focus-visible { outline: 3px solid rgba(26, 154, 114, .35); outline-offset: 2px; }

    /* ================= TRUST FOOTER ================= */
    .rx-assure {
        display: flex; align-items: center; justify-content: center; gap: .55rem;
        margin-top: 1.25rem; font-size: .75rem; color: var(--muted); text-align: center;
    }
    .rx-assure i { color: var(--g-600); font-size: 1rem; }

    .rx-trust {
        display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem 1.25rem;
        padding: 1rem 2rem;
        background: var(--g-50);
        border-top: 1px solid var(--line);
        font-size: .72rem; font-weight: 600; color: var(--g-800);
    }
    .rx-trust span { display: inline-flex; align-items: center; gap: .4rem; }
    .rx-trust i { color: var(--g-600); }

    /* ================= RESPONSIVE ================= */
    @@media (max-width: 575.98px) {
        .rx-page { padding: 1rem 0 2rem; }
        .rx-header { padding: 1.4rem 1.25rem; }
        .rx-head-title { font-size: 1.2rem; }
        .rx-steps { padding: .95rem 1.1rem; overflow-x: auto; }
        .rx-body { padding: 1.35rem 1.15rem 1.5rem; }
        .rx-drop { padding: 1.7rem 1rem 1.6rem; }
        .rx-trust { padding: .9rem 1.1rem; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .rx-page * { transition: none !important; animation: none !important; }
    }
</style>

<div class="rx-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-9 col-lg-7 col-xl-6">
                <div class="rx-card">

                    <!-- ================= HEADER ================= -->
                    <div class="rx-header">
                        <span class="rx-cross" aria-hidden="true"></span>
                        <div class="rx-head-row">
                            <span class="rx-head-icon"><i class="bi bi-file-earmark-medical"></i></span>
                            <div>
                                <h5 class="rx-head-title">Prescription verification</h5>
                                <p class="rx-head-sub">Upload your prescription so our pharmacist can confirm your order.</p>
                            </div>
                        </div>
                        <div class="rx-order">
                            <i class="bi bi-receipt"></i>
                            Order reference <strong>#@(Model.OrderNumber ?? Model.OrderId.ToString().Substring(0, 8))</strong>
                        </div>
                    </div>

                    <!-- ================= STEPS ================= -->
                    <ol class="rx-steps" aria-label="Progress">
                        <li class="active" aria-current="step"><span>1</span> Upload</li>
                        <li class="rx-line" aria-hidden="true"></li>
                        <li><span>2</span> Pharmacist review</li>
                        <li class="rx-line" aria-hidden="true"></li>
                        <li><span>3</span> Order processed</li>
                    </ol>

                    <!-- ================= BODY ================= -->
                    <div class="rx-body">

                        <div class="rx-formats" role="note">
                            <span class="lead-in"><i class="bi bi-info-circle-fill"></i> Accepted formats</span>
                            <span class="rx-chip"><i class="bi bi-file-earmark-image"></i> JPG</span>
                            <span class="rx-chip"><i class="bi bi-file-earmark-image"></i> PNG</span>
                            <span class="rx-chip"><i class="bi bi-file-earmark-pdf"></i> PDF</span>
                            <span class="rx-chip size"><i class="bi bi-hdd"></i> Max 5MB</span>
                        </div>

                        <form asp-controller="Prescription" asp-action="Upload" method="post" enctype="multipart/form-data" id="prescription-upload-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="OrderId" />

                            <!-- Drag and Drop Zone -->
                            <div id="drop-zone" class="rx-drop">
                                <div class="rx-drop-icon"><i class="bi bi-cloud-arrow-up"></i></div>
                                <h6>Drag and drop your prescription here</h6>
                                <span class="rx-sub">or click to browse from your device</span>
                                <span class="rx-browse"><i class="bi bi-folder2-open"></i> Browse files</span>
                                <input type="file" asp-for="PrescriptionFile" class="d-none" accept=".jpg,.jpeg,.png,.pdf,image/jpeg,image/png,application/pdf" />
                            </div>

                            <!-- Live File Preview Container -->
                            <div id="preview-container" class="card rx-preview d-none">
                                <div class="card-body text-center position-relative">
                                    <button type="button" id="remove-file-btn" class="btn-close position-absolute top-0 end-0 m-2" aria-label="Remove file"></button>

                                    <!-- Image Preview -->
                                    <img id="image-preview" src="#" alt="Prescription Preview" class="img-fluid rounded border d-none" style="max-height: 260px; object-fit: contain;" />

                                    <!-- PDF Preview -->
                                    <div id="pdf-preview" class="rx-pdf d-none">
                                        <i class="bi bi-file-earmark-pdf display-3"></i>
                                        <p id="pdf-file-name" class="fw-bold mb-0 mt-2 text-truncate"></p>
                                        <span id="pdf-file-size" class="text-muted small"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Validation Error Display -->
                            <div id="file-validation-error" class="alert alert-danger small d-none mb-3" role="alert"></div>
                            <span asp-validation-for="PrescriptionFile" class="text-danger small d-block mb-3"></span>

                            <!-- Tips for a successful review -->
                            <div class="rx-tips">
                                <p class="rx-tips-title">For a faster review, make sure your prescription shows:</p>
                                <ul class="list-unstyled mb-0 p-0">
                                    <li><i class="bi bi-check-circle-fill"></i> The doctor's name, signature and date</li>
                                    <li><i class="bi bi-check-circle-fill"></i> Medicine names and dosages, clearly readable</li>
                                    <li><i class="bi bi-check-circle-fill"></i> The full page, with no cropped edges or glare</li>
                                </ul>
                            </div>

                            <!-- Notes Field for Inspecting Pharmacist -->
                            <div class="rx-notes mb-4">
                                <label asp-for="Notes" class="form-label"></label>
                                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Add any optional notes for the reviewing pharmacist..."></textarea>
                                <span asp-validation-for="Notes" class="text-danger small"></span>
                            </div>

                            <!-- Action Buttons -->
                            <div class="d-grid gap-2">
                                <button type="submit" id="submit-upload-btn" class="btn rx-submit" disabled>
                                    <i class="bi bi-upload me-2"></i>Submit prescription
                                </button>
                                <a asp-controller="Home" asp-action="Index" class="btn rx-cancel">Cancel</a>
                            </div>
                        </form>

                        <div class="rx-assure">
                            <i class="bi bi-shield-check"></i>
                            A licensed pharmacist reviews your prescription before your order is processed.
                        </div>
                    </div>

                    <!-- ================= TRUST STRIP ================= -->
                    <div class="rx-trust">
                        <span><i class="bi bi-lock-fill"></i> Encrypted upload</span>
                        <span><i class="bi bi-person-badge-fill"></i> Licensed pharmacists</span>
                        <span><i class="bi bi-eye-slash-fill"></i> Kept private</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/prescription-upload.js"></script>
}
