@model MediGuard.Models.ViewModels.PrescriptionUploadViewModel

@{
    ViewData["Title"] = "Upload Prescription";
    Layout = "_Layout";
}

@section Styles {
<style>
    :root {
        --rx-teal: #007a78;
        --rx-teal-dark: #005f5d;
        --rx-teal-light: #e6f4f3;
        --rx-danger: #dc3545;
        --rx-border: #e0e7e7;
    }

    .rx-upload-page {
        background: linear-gradient(135deg, #f0f7f7 0%, #fafbfb 100%);
        min-height: 100vh;
        padding: 2rem 0 4rem;
    }

    .rx-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(0, 122, 120, 0.08);
        border: 1px solid var(--rx-border);
        overflow: hidden;
    }

    .rx-card-header {
        background: linear-gradient(135deg, var(--rx-teal), var(--rx-teal-dark));
        padding: 2rem 2.5rem;
        color: #fff;
    }

    .rx-card-header h1 {
        font-size: 1.5rem;
        font-weight: 800;
        margin: 0 0 0.35rem;
    }

    .rx-card-header p {
        margin: 0;
        opacity: 0.85;
        font-size: 0.9rem;
    }

    .rx-card-body {
        padding: 2rem 2.5rem;
    }

    /* Drop Zone */
    .rx-dropzone {
        border: 2.5px dashed #b2d8d7;
        border-radius: 14px;
        background: var(--rx-teal-light);
        padding: 2.5rem 1rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.25s ease;
        position: relative;
    }

    .rx-dropzone.drag-over {
        border-color: var(--rx-teal);
        background: #d0eeec;
        transform: scale(1.01);
    }

    .rx-dropzone .rx-drop-icon {
        font-size: 3rem;
        color: var(--rx-teal);
        margin-bottom: 0.75rem;
        display: block;
        transition: transform 0.3s ease;
    }

    .rx-dropzone:hover .rx-drop-icon {
        transform: translateY(-4px);
    }

    .rx-dropzone h5 {
        font-size: 1rem;
        font-weight: 700;
        color: #2d6160;
        margin-bottom: 0.35rem;
    }

    .rx-dropzone p {
        font-size: 0.82rem;
        color: #6b7280;
        margin-bottom: 0.75rem;
    }

    .rx-dropzone input[type="file"] {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
        width: 100%;
        height: 100%;
    }

    .rx-constraints {
        font-size: 0.78rem;
        color: #6b7280;
        margin-top: 0.6rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    /* Preview Box */
    .rx-preview-box {
        border: 1px solid var(--rx-border);
        border-radius: 14px;
        padding: 1.25rem;
        background: #fafafa;
        display: none;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
    }

    .rx-preview-box.visible {
        display: flex;
    }

    .rx-preview-thumb {
        width: 90px;
        height: 90px;
        border-radius: 10px;
        object-fit: cover;
        border: 1px solid var(--rx-border);
        background: #fff;
    }

    .rx-pdf-thumb {
        width: 90px;
        height: 90px;
        border-radius: 10px;
        background: #fff5f5;
        border: 1px solid #fca5a5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        color: var(--rx-danger);
    }

    .rx-preview-meta strong {
        font-size: 0.9rem;
        display: block;
        margin-bottom: 0.2rem;
        color: #111827;
    }

    .rx-preview-meta span {
        font-size: 0.78rem;
        color: #6b7280;
    }

    .rx-remove-btn {
        margin-left: auto;
        color: var(--rx-danger);
        background: none;
        border: none;
        font-size: 1.2rem;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
        transition: background 0.2s;
    }

    .rx-remove-btn:hover {
        background: #fee2e2;
    }

    /* File error */
    .rx-file-error {
        color: var(--rx-danger);
        font-size: 0.82rem;
        margin-top: 0.5rem;
        display: none;
    }

    /* Order reference badge */
    .rx-order-badge {
        background: var(--rx-teal-light);
        color: var(--rx-teal-dark);
        border: 1px solid #b2d8d7;
        border-radius: 8px;
        padding: 0.6rem 1rem;
        font-size: 0.85rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
    }

    /* Label */
    .rx-label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #4b6060;
        margin-bottom: 0.45rem;
        display: block;
    }

    /* Submit Button */
    .btn-rx-submit {
        background: linear-gradient(135deg, var(--rx-teal), var(--rx-teal-dark));
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 0.75rem 2rem;
        font-size: 0.95rem;
        font-weight: 700;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-rx-submit:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 122, 120, 0.3);
        color: #fff;
    }

    .btn-rx-submit:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-rx-cancel {
        background: transparent;
        color: #6b7280;
        border: 1.5px solid #e0e7e7;
        border-radius: 10px;
        padding: 0.75rem 1.5rem;
        font-size: 0.95rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .btn-rx-cancel:hover {
        border-color: var(--rx-teal);
        color: var(--rx-teal);
    }

    .rx-info-banner {
        background: #fffbe6;
        border: 1px solid #f5d020;
        border-radius: 10px;
        padding: 0.9rem 1.1rem;
        font-size: 0.83rem;
        color: #7d5a00;
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        margin-bottom: 1.5rem;
    }
</style>
}

<div class="rx-upload-page">
    <div class="container" style="max-width: 680px;">

        <div class="rx-card">
            <!-- Header -->
            <div class="rx-card-header">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-file-earmark-medical fs-4"></i>
                    <h1>Upload Prescription</h1>
                </div>
                <p>Submit a valid prescription photo or PDF for Rx-designated items in your order.</p>
            </div>

            <div class="rx-card-body">

                <!-- Order Reference -->
                <div class="rx-order-badge">
                    <i class="bi bi-receipt"></i>
                    Order Reference: <strong>@Model.OrderReference</strong>
                </div>

                <!-- Info Banner -->
                <div class="rx-info-banner">
                    <i class="bi bi-info-circle-fill flex-shrink-0" style="color:#e6a817;"></i>
                    <span>Your prescription will be reviewed by a licensed pharmacist before your order is processed. Please ensure it is legible and not expired.</span>
                </div>

                <!-- Form -->
                <form asp-action="Upload"
                      asp-controller="Prescription"
                      method="post"
                      enctype="multipart/form-data"
                      id="rxUploadForm"
                      novalidate>

                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OrderId" />

                    <!-- Drop-zone -->
                    <div class="mb-4">
                        <label class="rx-label">
                            <i class="bi bi-upload me-1"></i> Prescription File
                        </label>

                        <div class="rx-dropzone" id="rxDropzone">
                            <input type="file"
                                   id="rxFileInput"
                                   name="PrescriptionFile"
                                   accept=".jpg,.jpeg,.png,.pdf"
                                   aria-label="Upload prescription file" />
                            <i class="bi bi-cloud-arrow-up rx-drop-icon"></i>
                            <h5>Drag & Drop your file here</h5>
                            <p>or click to browse your device</p>
                            <span class="badge bg-light text-dark border" style="font-size:0.78rem;">
                                <i class="bi bi-paperclip me-1"></i> Accepted formats: JPG, PNG, PDF
                            </span>
                        </div>

                        <!-- Constraints message -->
                        <p class="rx-constraints">
                            <i class="bi bi-info-circle"></i>
                            Accepted formats: JPG, PNG, PDF. Maximum file size: 5 MB.
                        </p>

                        <!-- File error message -->
                        <div id="rxFileError" class="rx-file-error"></div>

                        <!-- Preview -->
                        <div id="rxPreviewBox" class="rx-preview-box" role="status" aria-live="polite">
                            <div id="rxThumbContainer"></div>
                            <div class="rx-preview-meta">
                                <strong id="rxFileName">—</strong>
                                <span id="rxFileSize">—</span>
                            </div>
                            <button type="button" class="rx-remove-btn" id="rxRemoveBtn"
                                    aria-label="Remove selected file">
                                <i class="bi bi-x-circle-fill"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Pharmacist Notes -->
                    <div class="mb-4">
                        <label class="rx-label" for="PharmacistNotes">
                            <i class="bi bi-chat-text me-1"></i>
                            Notes for Pharmacist <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <textarea asp-for="PharmacistNotes"
                                  id="PharmacistNotes"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="e.g. This is a repeat prescription for chronic medication. The prescribing doctor is Dr. Smith."
                                  style="border-radius:10px; font-size:0.875rem;"></textarea>
                        <span asp-validation-for="PharmacistNotes" class="text-danger small"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-3 flex-wrap">
                        <button type="submit" id="rxSubmitBtn" class="btn-rx-submit" disabled>
                            <i class="bi bi-send-check"></i>
                            Submit Prescription
                        </button>
                        <a asp-controller="Storefront" asp-action="Index" class="btn btn-rx-cancel">
                            <i class="bi bi-arrow-left me-1"></i> Back to Store
                        </a>
                    </div>

                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/prescription-upload.js" asp-append-version="true"></script>
}
