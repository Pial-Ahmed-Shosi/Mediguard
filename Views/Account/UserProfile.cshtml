@model MediGuard.Models.ViewModels.CustomerProfileViewModel
@{
    ViewData["Title"] = "My Dashboard - MediGuard";
    var initials = string.Concat(
        (Model.User.FullName ?? Model.User.Email ?? "CU")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(p => char.ToUpperInvariant(p[0])));
    if (string.IsNullOrWhiteSpace(initials)) initials = "CU";
}

<div class="container py-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ============ 1. CUSTOMER HERO PROFILE HEADER ============ -->
    <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden" style="background: linear-gradient(135deg, #0b2545 0%, #1e3a8a 60%, #0b6e5f 100%);">
        <div class="card-body p-4 p-md-5 text-white">
            <div class="row align-items-center g-4">
                <div class="col-auto">
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow"
                         style="width: 84px; height: 84px; background: linear-gradient(135deg, #e0f2fe, #bae6fd); color: #0b2545; font-size: 2rem;">
                        @initials
                    </div>
                </div>
                <div class="col">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h2 class="h3 fw-bold mb-0">@Model.User.FullName</h2>
                        <span class="badge bg-info text-dark px-2.5 py-1 rounded-pill">
                            <i class="bi bi-patch-check-fill text-primary"></i> Customer Account
                        </span>
                        @if (Model.User.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill">
                                Active &amp; Verified
                            </span>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-3 text-light opacity-75 small">
                        <span><i class="bi bi-envelope me-1"></i> @Model.User.Email</span>
                        @if (!string.IsNullOrWhiteSpace(Model.User.PhoneNumber))
                        {
                            <span><i class="bi bi-telephone me-1"></i> @Model.User.PhoneNumber</span>
                        }
                        <span><i class="bi bi-calendar-check me-1"></i> Member since @Model.User.CreatedAt.ToString("MMM yyyy")</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.DeliveryAddress))
                    {
                        <div class="mt-2 text-light small opacity-90">
                            <i class="bi bi-geo-alt-fill text-warning me-1"></i> <strong>Default Delivery Address:</strong> @Model.DeliveryAddress
                        </div>
                    }
                </div>
                <div class="col-12 col-md-auto d-flex flex-wrap gap-2">
                    <a asp-controller="Storefront" asp-action="Index" class="btn btn-light text-primary fw-semibold px-4 py-2 rounded-pill shadow-sm">
                        <i class="bi bi-bag-plus me-1"></i> Order Medicines
                    </a>
                    <a asp-controller="Prescription" asp-action="Upload" class="btn btn-outline-light fw-semibold px-4 py-2 rounded-pill">
                        <i class="bi bi-cloud-arrow-up me-1"></i> Upload Rx
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ 2. METRIC KPI CARDS ============ -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-3 shadow-sm p-3 h-100 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">Active Orders</span>
                    <span class="p-2 rounded-circle bg-primary-subtle text-primary">
                        <i class="bi bi-truck fs-5"></i>
                    </span>
                </div>
                <h3 class="fw-bold mb-0 text-primary">@Model.ActiveOrdersCount</h3>
                <small class="text-muted">In transit / processing</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-3 shadow-sm p-3 h-100 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">Total Orders</span>
                    <span class="p-2 rounded-circle bg-success-subtle text-success">
                        <i class="bi bi-receipt-cutoff fs-5"></i>
                    </span>
                </div>
                <h3 class="fw-bold mb-0 text-dark">@Model.TotalOrdersCount</h3>
                <small class="text-muted">Lifetime purchases</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-3 shadow-sm p-3 h-100 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">Prescriptions</span>
                    <span class="p-2 rounded-circle bg-warning-subtle text-warning">
                        <i class="bi bi-file-earmark-medical fs-5"></i>
                    </span>
                </div>
                <h3 class="fw-bold mb-0 text-dark">@Model.RecentPrescriptions.Count</h3>
                <small class="text-muted">@(Model.PendingPrescriptionsCount > 0 ? $"{Model.PendingPrescriptionsCount} pending review" : "All verified")</small>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 rounded-3 shadow-sm p-3 h-100 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">Saved Address</span>
                    <span class="p-2 rounded-circle bg-info-subtle text-info">
                        <i class="bi bi-house-door fs-5"></i>
                    </span>
                </div>
                <h6 class="fw-bold mb-1 text-truncate" title="@(Model.DeliveryAddress ?? "Not provided")">
                    @(string.IsNullOrWhiteSpace(Model.DeliveryAddress) ? "None set" : Model.DeliveryAddress)
                </h6>
                <a href="#profileEditModal" data-bs-toggle="modal" class="small text-decoration-none text-teal fw-semibold">
                    Edit Details &raquo;
                </a>
            </div>
        </div>
    </div>

    <!-- ============ 3. TABBED CONTENT SECTION ============ -->
    <div class="card border-0 rounded-4 shadow-sm bg-white">
        <div class="card-header bg-white border-bottom p-3">
            <ul class="nav nav-pills card-header-pills" id="dashboardTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-semibold" id="orders-tab" data-bs-toggle="pill" data-bs-target="#orders" type="button" role="tab">
                        <i class="bi bi-bag-check me-1"></i> Order History (@Model.RecentOrders.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="prescriptions-tab" data-bs-toggle="pill" data-bs-target="#prescriptions" type="button" role="tab">
                        <i class="bi bi-file-medical me-1"></i> Uploaded Prescriptions (@Model.RecentPrescriptions.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="profile-tab" data-bs-toggle="pill" data-bs-target="#profile" type="button" role="tab">
                        <i class="bi bi-person-gear me-1"></i> Account Details
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-4">
            <div class="tab-content" id="dashboardTabsContent">

                <!-- TAB 1: ORDER HISTORY -->
                <div class="tab-pane fade show active" id="orders" role="tabpanel" aria-labelledby="orders-tab">
                    @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order #</th>
                                        <th>Date</th>
                                        <th>Items</th>
                                        <th>Total Amount</th>
                                        <th>Payment</th>
                                        <th>Delivery Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.RecentOrders)
                                    {
                                        <tr>
                                            <td class="fw-bold text-primary">@order.OrderNumber</td>
                                            <td class="text-muted small">@order.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                            <td>
                                                <span class="badge bg-light text-dark border">
                                                    @(order.OrderItems?.Count ?? 0) items
                                                </span>
                                            </td>
                                            <td class="fw-bold">৳@order.TotalAmount.ToString("N2")</td>
                                            <td>
                                                @if (order.PaymentStatus == "PAID" || order.PaymentStatus == "SUCCESS")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        <i class="bi bi-check-circle me-1"></i> Paid
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                                        <i class="bi bi-hourglass-split me-1"></i> @order.PaymentStatus
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (order.DeliveryStatus == "DONE" || order.DeliveryStatus == "COMPLETED")
                                                {
                                                    <span class="badge bg-success"><i class="bi bi-box-seam me-1"></i> Delivered</span>
                                                }
                                                else if (order.DeliveryStatus == "IN_TRANSIT")
                                                {
                                                    <span class="badge bg-primary"><i class="bi bi-truck me-1"></i> On the Way</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@order.DeliveryStatus</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="Checkout" asp-action="Confirmation" asp-route-orderId="@order.Id"
                                                   class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                    Details
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-cart-x fs-1 text-muted"></i>
                            <h5 class="mt-3 text-secondary">No Orders Yet</h5>
                            <p class="text-muted small">You haven't placed any medicine orders yet. Explore our verified pharmacies!</p>
                            <a asp-controller="Storefront" asp-action="Index" class="btn btn-teal-solid rounded-pill px-4 mt-2">
                                <i class="bi bi-shop me-1"></i> Browse Storefront
                            </a>
                        </div>
                    }
                </div>

                <!-- TAB 2: PRESCRIPTIONS -->
                <div class="tab-pane fade" id="prescriptions" role="tabpanel" aria-labelledby="prescriptions-tab">
                    @if (Model.RecentPrescriptions != null && Model.RecentPrescriptions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Document</th>
                                        <th>Uploaded On</th>
                                        <th>Linked Order</th>
                                        <th>Verification Status</th>
                                        <th>Pharmacist Note</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rx in Model.RecentPrescriptions)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-file-earmark-medical text-teal fs-4"></i>
                                                    <div>
                                                        <span class="fw-semibold text-dark">Prescription</span>
                                                        <small class="d-block text-muted">@rx.FileType.ToUpper() format</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-muted small">@rx.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                            <td>
                                                @if (rx.Order != null)
                                                {
                                                    <span class="fw-semibold text-primary">@rx.Order.OrderNumber</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Unlinked (General)</span>
                                                }
                                            </td>
                                            <td>
                                                @if (rx.Status == "APPROVED")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Approved
                                                    </span>
                                                }
                                                else if (rx.Status == "REJECTED")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                        <i class="bi bi-x-circle-fill me-1"></i> Rejected
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                                        <i class="bi bi-clock-history me-1"></i> Under Review
                                                    </span>
                                                }
                                            </td>
                                            <td class="small text-muted">
                                                @(string.IsNullOrWhiteSpace(rx.RejectionReason) ? "No notes" : rx.RejectionReason)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-file-earmark-medical fs-1 text-muted"></i>
                            <h5 class="mt-3 text-secondary">No Prescriptions Uploaded</h5>
                            <p class="text-muted small">Some medicines require a prescription. You can upload prescription photos or PDFs anytime.</p>
                            <a asp-controller="Prescription" asp-action="Upload" class="btn btn-teal-outline rounded-pill px-4 mt-2">
                                <i class="bi bi-cloud-arrow-up me-1"></i> Upload Prescription
                            </a>
                        </div>
                    }
                </div>

                <!-- TAB 3: ACCOUNT DETAILS -->
                <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
                    <form asp-controller="Account" asp-action="UpdateProfile" method="post" style="max-width: 600px;">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email Address (Login ID)</label>
                            <input type="text" class="form-control bg-light" value="@Model.User.Email" readonly disabled />
                            <small class="text-muted">Your email address is your primary MediGuard identifier and cannot be changed.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Full Name</label>
                            <input type="text" name="fullName" class="form-control" value="@Model.User.FullName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Contact Phone Number</label>
                            <input type="tel" name="phoneNumber" class="form-control" value="@Model.User.PhoneNumber" placeholder="e.g. +8801700000000" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Default Delivery Address</label>
                            <textarea name="deliveryAddress" class="form-control" rows="3" placeholder="House, Road, Area, City...">@Model.DeliveryAddress</textarea>
                            <small class="text-muted">Used as the prefilled delivery address for all your storefront medicine orders.</small>
                        </div>
                        <button type="submit" class="btn btn-teal-solid rounded-pill px-4">
                            <i class="bi bi-save me-1"></i> Save Profile Details
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>

</div>

<!-- Modal for Quick Profile Edit -->
<div class="modal fade" id="profileEditModal" tabindex="-1" aria-labelledby="profileEditModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="profileEditModalLabel">Edit Delivery Address &amp; Contact</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Account" asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Full Name</label>
                        <input type="text" name="fullName" class="form-control" value="@Model.User.FullName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Phone Number</label>
                        <input type="tel" name="phoneNumber" class="form-control" value="@Model.User.PhoneNumber" placeholder="+880..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Default Delivery Address</label>
                        <textarea name="deliveryAddress" class="form-control" rows="3">@Model.DeliveryAddress</textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-teal-solid rounded-pill px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
