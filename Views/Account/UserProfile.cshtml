@model MediGuard.Models.ViewModels.CustomerProfileViewModel
@{
    ViewData["Title"] = "Customer Dashboard - MediGuard";
    var initials = string.Concat(
        (Model.User.FullName ?? Model.User.Email ?? "CU")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(p => char.ToUpperInvariant(p[0])));
    if (string.IsNullOrWhiteSpace(initials)) initials = "CU";
}

<div class="container py-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ============ 1. CUSTOMER HERO PROFILE HEADER ============ -->
    <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden" style="background: linear-gradient(135deg, #0b2545 0%, #1e3a8a 60%, #0b6e5f 100%);">
        <div class="card-body p-4 p-md-5 text-white">
            <div class="row align-items-center g-4">
                <div class="col-auto">
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(Model.User.ProfileImageUrl))
                        {
                            <img src="@Model.User.ProfileImageUrl" alt="@Model.User.FullName"
                                 class="rounded-circle shadow object-fit-cover border border-3 border-white"
                                 style="width: 96px; height: 96px;" />
                        }
                        else
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow border border-3 border-white"
                                 style="width: 96px; height: 96px; background: linear-gradient(135deg, #e0f2fe, #bae6fd); color: #0b2545; font-size: 2.2rem;">
                                @initials
                            </div>
                        }
                        <button type="button" class="btn btn-sm btn-light position-absolute bottom-0 end-0 rounded-circle shadow p-1"
                                style="width: 32px; height: 32px;" data-bs-toggle="modal" data-bs-target="#avatarModal" title="Upload or Change Photo">
                            <i class="bi bi-camera-fill text-primary"></i>
                        </button>
                    </div>
                </div>
                <div class="col">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h2 class="h3 fw-bold mb-0">@Model.User.FullName</h2>
                        <span class="badge bg-info text-dark px-2.5 py-1 rounded-pill">
                            <i class="bi bi-patch-check-fill text-primary"></i> Customer Account
                        </span>
                        @if (Model.User.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill">
                                Active &amp; Verified
                            </span>
                        }
                    </div>
                    <div class="d-flex flex-wrap gap-3 text-light opacity-75 small">
                        <span><i class="bi bi-envelope me-1"></i> @Model.User.Email</span>
                        @if (!string.IsNullOrWhiteSpace(Model.User.PhoneNumber))
                        {
                            <span><i class="bi bi-telephone me-1"></i> @Model.User.PhoneNumber</span>
                        }
                        <span><i class="bi bi-calendar-check me-1"></i> Member since @Model.User.CreatedAt.ToString("MMM yyyy")</span>
                    </div>

                    <div class="row g-2 mt-2">
                        <div class="col-md-6">
                            <div class="text-light small opacity-90">
                                <i class="bi bi-geo-alt-fill text-warning me-1"></i>
                                <strong>Delivery Address:</strong> @(string.IsNullOrWhiteSpace(Model.DeliveryAddress) ? "None set" : Model.DeliveryAddress)
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-light small opacity-90">
                                <i class="bi bi-telephone-plus-fill text-danger me-1"></i>
                                <strong>Emergency Contact:</strong> @(string.IsNullOrWhiteSpace(Model.EmergencyContact) ? "Not specified" : Model.EmergencyContact)
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-auto d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-light text-primary fw-semibold px-3 py-2 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#profileEditModal">
                        <i class="bi bi-pencil-square me-1"></i> Edit Profile
                    </button>
                    <a asp-controller="Storefront" asp-action="Index" class="btn btn-teal-solid text-white fw-semibold px-3 py-2 rounded-pill shadow-sm">
                        <i class="bi bi-shop me-1"></i> Browse Medicines
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ 2. NOTIFICATIONS & KPI BAR ============ -->
    <div class="row g-3 mb-4">
        <!-- Live Notifications Banner Card -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm p-3 h-100 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom">
                    <span class="fw-bold text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-bell-fill text-warning fs-5"></i> Live Updates &amp; Alerts
                    </span>
                    <span class="badge bg-light text-muted border">@Model.Notifications.Count Notifications</span>
                </div>
                <div class="vstack gap-2" style="max-height: 180px; overflow-y: auto;">
                    @foreach (var n in Model.Notifications)
                    {
                        <div class="d-flex align-items-start gap-3 p-2 rounded-3 bg-light">
                            <span class="badge @n.BadgeClass p-2 rounded-circle mt-1">
                                <i class="bi @n.IconClass text-white"></i>
                            </span>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong class="text-dark small">@n.Title</strong>
                                    <small class="text-muted" style="font-size: 0.75rem;">@n.TimeAgo</small>
                                </div>
                                <p class="text-muted small mb-0">@n.Message</p>
                            </div>
                            @if (!string.IsNullOrEmpty(n.ActionUrl))
                            {
                                <a href="@n.ActionUrl" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-0.5" style="font-size: 0.75rem;">View</a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Quick Metrics -->
        <div class="col-12 col-lg-4">
            <div class="row g-2 h-100">
                <div class="col-6">
                    <div class="card border-0 rounded-4 shadow-sm p-3 text-center h-100 bg-white">
                        <span class="p-2 rounded-circle bg-primary-subtle text-primary d-inline-block mx-auto mb-2">
                            <i class="bi bi-truck fs-5"></i>
                        </span>
                        <h4 class="fw-bold mb-0 text-primary">@Model.ActiveOrdersCount</h4>
                        <small class="text-muted">Active Orders</small>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 rounded-4 shadow-sm p-3 text-center h-100 bg-white">
                        <span class="p-2 rounded-circle bg-success-subtle text-success d-inline-block mx-auto mb-2">
                            <i class="bi bi-bag-check fs-5"></i>
                        </span>
                        <h4 class="fw-bold mb-0 text-dark">@Model.TotalOrdersCount</h4>
                        <small class="text-muted">Total Orders</small>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 rounded-4 shadow-sm p-3 text-center h-100 bg-white">
                        <span class="p-2 rounded-circle bg-warning-subtle text-warning d-inline-block mx-auto mb-2">
                            <i class="bi bi-file-earmark-medical fs-5"></i>
                        </span>
                        <h4 class="fw-bold mb-0 text-dark">@Model.RecentPrescriptions.Count</h4>
                        <small class="text-muted">Prescriptions</small>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card border-0 rounded-4 shadow-sm p-3 text-center h-100 bg-white">
                        <span class="p-2 rounded-circle bg-info-subtle text-info d-inline-block mx-auto mb-2">
                            <i class="bi bi-credit-card fs-5"></i>
                        </span>
                        <h4 class="fw-bold mb-0 text-dark">@Model.SavedPaymentMethods.Count</h4>
                        <small class="text-muted">Saved Methods</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============ 3. TABBED CONTENT SECTION ============ -->
    <div class="card border-0 rounded-4 shadow-sm bg-white mb-5">
        <div class="card-header bg-white border-bottom p-3">
            <ul class="nav nav-pills card-header-pills" id="dashboardTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-semibold" id="orders-tab" data-bs-toggle="pill" data-bs-target="#orders" type="button" role="tab">
                        <i class="bi bi-bag-check me-1"></i> Orders &amp; Real-Time Tracking (@Model.RecentOrders.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="prescriptions-tab" data-bs-toggle="pill" data-bs-target="#prescriptions" type="button" role="tab">
                        <i class="bi bi-file-medical me-1"></i> Prescription Portal (@Model.RecentPrescriptions.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="payments-tab" data-bs-toggle="pill" data-bs-target="#payments" type="button" role="tab">
                        <i class="bi bi-wallet2 me-1"></i> Payment Methods &amp; Invoices
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-semibold" id="profile-tab" data-bs-toggle="pill" data-bs-target="#profile" type="button" role="tab">
                        <i class="bi bi-person-gear me-1"></i> Account Details
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-4">
            <div class="tab-content" id="dashboardTabsContent">

                <!-- ==================== TAB 1: ORDER TRACKING & HISTORY ==================== -->
                <div class="tab-pane fade show active" id="orders" role="tabpanel" aria-labelledby="orders-tab">
                    @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                    {
                        <div class="vstack gap-4">
                            @foreach (var order in Model.RecentOrders)
                            {
                                int currentStep = 1;
                                string orderStat = (order.Status ?? "").ToUpperInvariant();
                                string delStat = (order.DeliveryStatus ?? "").ToUpperInvariant();

                                if (delStat == "DONE" || delStat == "COMPLETED" || orderStat == "COMPLETED") currentStep = 5;
                                else if (delStat == "IN_TRANSIT" || delStat == "OUT_FOR_DELIVERY" || orderStat == "IN_TRANSIT") currentStep = 4;
                                else if (orderStat == "IN_PREPARATION" || orderStat == "PREPARING" || delStat == "IN_PREPARATION") currentStep = 3;
                                else if (orderStat == "APPROVED") currentStep = 2;
                                else currentStep = 1;

                                <div class="card border rounded-4 shadow-sm overflow-hidden">
                                    <!-- Order Header Banner -->
                                    <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center p-3 gap-2 border-bottom">
                                        <div>
                                            <span class="fw-bold text-primary fs-6">Order #@order.OrderNumber</span>
                                            <span class="text-muted small ms-2"><i class="bi bi-clock me-1"></i>@order.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                            <span class="badge bg-secondary ms-2">@(order.Pharmacy?.Name ?? "MediGuard Partner")</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (order.PaymentStatus == "PAID" || order.PaymentStatus == "SUCCESS")
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Paid (৳@order.TotalAmount.ToString("N2"))
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1">
                                                    <i class="bi bi-cash-coin me-1"></i> COD Pending (৳@order.TotalAmount.ToString("N2"))
                                                </span>
                                            }

                                            <!-- Re-Order One Click Button -->
                                            <form asp-controller="Checkout" asp-action="ReOrder" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderId" value="@order.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 shadow-sm fw-semibold">
                                                    <i class="bi bi-arrow-repeat me-1"></i> Re-Order
                                                </button>
                                            </form>

                                            <!-- Download Itemized Invoice Button -->
                                            <a asp-controller="Checkout" asp-action="Invoice" asp-route-orderId="@order.Id" target="_blank"
                                               class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 fw-semibold shadow-sm">
                                                <i class="bi bi-receipt me-1"></i> Invoice
                                            </a>
                                        </div>
                                    </div>

                                    <div class="card-body p-3 p-md-4">
                                        <!-- Real-Time Status Progress Bar (5 Steps) -->
                                        <div class="mb-4">
                                            <div class="d-flex justify-content-between text-center position-relative mb-2">
                                                <div class="position-absolute top-50 start-0 translate-middle-y w-100 bg-secondary-subtle" style="height: 4px; z-index: 1;"></div>
                                                <div class="position-absolute top-50 start-0 translate-middle-y bg-success"
                                                     style="height: 4px; z-index: 1; width: @((currentStep - 1) * 25)%; transition: width 0.4s ease;"></div>

                                                <!-- Step 1 -->
                                                <div class="position-relative" style="z-index: 2;">
                                                    <span class="badge rounded-circle @(currentStep >= 1 ? "bg-success" : "bg-secondary") text-white p-2">
                                                        <i class="bi bi-receipt"></i>
                                                    </span>
                                                    <div class="small fw-semibold mt-1 @(currentStep >= 1 ? "text-success" : "text-muted")">1. Pending Approval</div>
                                                </div>

                                                <!-- Step 2 -->
                                                <div class="position-relative" style="z-index: 2;">
                                                    <span class="badge rounded-circle @(currentStep >= 2 ? "bg-success" : "bg-secondary") text-white p-2">
                                                        <i class="bi bi-check2-circle"></i>
                                                    </span>
                                                    <div class="small fw-semibold mt-1 @(currentStep >= 2 ? "text-success" : "text-muted")">2. Approved</div>
                                                </div>

                                                <!-- Step 3 -->
                                                <div class="position-relative" style="z-index: 2;">
                                                    <span class="badge rounded-circle @(currentStep >= 3 ? "bg-success" : "bg-secondary") text-white p-2">
                                                        <i class="bi bi-box-seam"></i>
                                                    </span>
                                                    <div class="small fw-semibold mt-1 @(currentStep >= 3 ? "text-success" : "text-muted")">3. In Preparation</div>
                                                </div>

                                                <!-- Step 4 -->
                                                <div class="position-relative" style="z-index: 2;">
                                                    <span class="badge rounded-circle @(currentStep >= 4 ? "bg-success" : "bg-secondary") text-white p-2">
                                                        <i class="bi bi-truck"></i>
                                                    </span>
                                                    <div class="small fw-semibold mt-1 @(currentStep >= 4 ? "text-success" : "text-muted")">4. Out for Delivery</div>
                                                </div>

                                                <!-- Step 5 -->
                                                <div class="position-relative" style="z-index: 2;">
                                                    <span class="badge rounded-circle @(currentStep >= 5 ? "bg-success" : "bg-secondary") text-white p-2">
                                                        <i class="bi bi-house-check"></i>
                                                    </span>
                                                    <div class="small fw-semibold mt-1 @(currentStep >= 5 ? "text-success" : "text-muted")">5. Completed</div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Delivery Personnel Info Card (once dispatched) -->
                                        @if (currentStep >= 4)
                                        {
                                            var rider = order.AssignedDeliveryman ?? order.Deliveryman;
                                            <div class="alert alert-info border-0 rounded-4 shadow-sm p-3 mb-3" style="background-color: #f0fdfa;">
                                                <div class="d-flex align-items-center gap-3">
                                                    @if (!string.IsNullOrEmpty(rider?.ProfileImageUrl))
                                                    {
                                                        <img src="@rider.ProfileImageUrl" alt="Rider" class="rounded-circle object-fit-cover shadow-sm border border-2 border-white" style="width: 54px; height: 54px;" />
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-circle bg-teal text-white fw-bold d-flex align-items-center justify-content-center shadow-sm" style="width: 54px; height: 54px; background-color: #0b6e5f;">
                                                            <i class="bi bi-person-badge fs-4"></i>
                                                        </div>
                                                    }
                                                    <div class="flex-grow-1">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-0.5 small">Courier Assigned</span>
                                                            <strong class="text-dark">@(rider?.FullName ?? "Assigned Delivery Courier")</strong>
                                                        </div>
                                                        <div class="d-flex flex-wrap gap-3 small text-muted mt-1">
                                                            <span><i class="bi bi-telephone-fill text-teal me-1"></i> <a href="tel:@(rider?.PhoneNumber ?? "+8801700000000")" class="text-decoration-none fw-semibold">@(rider?.PhoneNumber ?? "+8801700000000")</a></span>
                                                            <span><i class="bi bi-bicycle text-primary me-1"></i> Vehicle: @(rider?.VehicleDetails ?? "Express Motorcycle (Dhaka Metro-1234)")</span>
                                                            <span><i class="bi bi-geo-alt-fill text-danger me-1"></i> Delivery to: @(order.ShippingAddress ?? Model.DeliveryAddress ?? "Customer Address")</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <!-- Order Items Summary List -->
                                        <div class="table-responsive">
                                            <table class="table table-sm table-borderless align-middle mb-0">
                                                <thead class="table-light text-muted small">
                                                    <tr>
                                                        <th>Item Name</th>
                                                        <th class="text-center">Quantity</th>
                                                        <th class="text-center">Unit Price</th>
                                                        <th class="text-end">Subtotal</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var itm in order.OrderItems)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <span class="fw-semibold text-dark">@(itm.Medicine?.BrandName ?? "Prescribed Medicine")</span>
                                                            </td>
                                                            <td class="text-center">@itm.Quantity</td>
                                                            <td class="text-center">৳@itm.UnitPrice.ToString("N2")</td>
                                                            <td class="text-end fw-semibold">৳@itm.TotalPrice.ToString("N2")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-cart-x fs-1 text-muted"></i>
                            <h5 class="mt-3 text-secondary">No Orders Placed Yet</h5>
                            <p class="text-muted small">Search our verified partner pharmacies and place your first medicine order today!</p>
                            <a asp-controller="Storefront" asp-action="Index" class="btn btn-teal-solid rounded-pill px-4 mt-2">
                                <i class="bi bi-shop me-1"></i> Browse Medicine Catalog
                            </a>
                        </div>
                    }
                </div>

                <!-- ==================== TAB 2: PRESCRIPTION PORTAL ==================== -->
                <div class="tab-pane fade" id="prescriptions" role="tabpanel" aria-labelledby="prescriptions-tab">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0 text-dark">Prescription Management &amp; Verification</h5>
                        <button type="button" class="btn btn-teal-solid rounded-pill px-3 py-1.5 fw-semibold" data-bs-toggle="modal" data-bs-target="#uploadRxModal">
                            <i class="bi bi-cloud-arrow-up me-1"></i> Upload Prescription
                        </button>
                    </div>

                    @if (Model.RecentPrescriptions != null && Model.RecentPrescriptions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Document</th>
                                        <th>Uploaded On</th>
                                        <th>Linked Order</th>
                                        <th>Verification Status</th>
                                        <th>Pharmacist Review Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rx in Model.RecentPrescriptions)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-file-earmark-medical text-teal fs-4"></i>
                                                    <div>
                                                        <a href="@rx.FilePath" target="_blank" class="fw-semibold text-primary text-decoration-none">
                                                            Prescription Document <i class="bi bi-box-arrow-up-right small"></i>
                                                        </a>
                                                        <small class="d-block text-muted">@rx.FileType.ToUpper() format</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-muted small">@rx.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                            <td>
                                                @if (rx.Order != null)
                                                {
                                                    <span class="fw-semibold text-primary">@rx.Order.OrderNumber</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Unlinked (General Rx)</span>
                                                }
                                            </td>
                                            <td>
                                                @if (rx.Status == "APPROVED")
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Approved
                                                    </span>
                                                }
                                                else if (rx.Status == "REJECTED")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-x-circle-fill me-1"></i> Rejected
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1.5 rounded-pill">
                                                        <i class="bi bi-clock-history me-1"></i> Under Review
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(rx.RejectionReason))
                                                {
                                                    <div class="p-2 rounded-3 bg-danger-subtle text-danger small">
                                                        <i class="bi bi-info-circle-fill me-1"></i> @rx.RejectionReason
                                                    </div>
                                                }
                                                else if (rx.Status == "APPROVED")
                                                {
                                                    <span class="text-success small"><i class="bi bi-shield-check me-1"></i> Verified by Licensed Pharmacist</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">Pharmacist is currently reviewing items against Rx requirements.</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-file-earmark-medical fs-1 text-muted"></i>
                            <h5 class="mt-3 text-secondary">No Prescriptions Uploaded</h5>
                            <p class="text-muted small">Upload your doctor's prescription in JPEG, PNG, or PDF format to purchase Rx-restricted medicines.</p>
                            <button type="button" class="btn btn-teal-solid rounded-pill px-4 mt-2" data-bs-toggle="modal" data-bs-target="#uploadRxModal">
                                <i class="bi bi-cloud-arrow-up me-1"></i> Upload Prescription Now
                            </button>
                        </div>
                    }
                </div>

                <!-- ==================== TAB 3: PAYMENT METHODS & BILLING ==================== -->
                <div class="tab-pane fade" id="payments" role="tabpanel" aria-labelledby="payments-tab">
                    <div class="row g-4">
                        <!-- Saved Fast Checkout Methods -->
                        <div class="col-12 col-lg-6">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold mb-0">Saved Payment Methods</h6>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addPaymentModal">
                                    <i class="bi bi-plus-lg me-1"></i> Add Method
                                </button>
                            </div>

                            @if (Model.SavedPaymentMethods != null && Model.SavedPaymentMethods.Any())
                            {
                                <div class="vstack gap-2">
                                    @foreach (var method in Model.SavedPaymentMethods)
                                    {
                                        <div class="card border rounded-3 p-3 shadow-sm d-flex flex-row justify-content-between align-items-center">
                                            <div class="d-flex align-items-center gap-3">
                                                @if (method.Type == "BKASH")
                                                {
                                                    <span class="badge bg-danger p-2 rounded-circle fs-6">bK</span>
                                                }
                                                else if (method.Type == "NAGAD")
                                                {
                                                    <span class="badge bg-warning text-dark p-2 rounded-circle fs-6">Ng</span>
                                                }
                                                else if (method.Type == "ROCKET")
                                                {
                                                    <span class="badge bg-primary p-2 rounded-circle fs-6">Rk</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary p-2 rounded-circle fs-6"><i class="bi bi-credit-card"></i></span>
                                                }
                                                <div>
                                                    <strong class="d-block text-dark">@method.Title</strong>
                                                    <small class="text-muted">@method.AccountNumber @(string.IsNullOrEmpty(method.Expiry) ? "" : $"• Exp: {method.Expiry}")</small>
                                                </div>
                                            </div>
                                            <form asp-controller="Account" asp-action="DeletePaymentMethod" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@method.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger border-0 rounded-circle" title="Remove method">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="p-4 rounded-3 border bg-light text-center">
                                    <i class="bi bi-credit-card-2-front fs-2 text-muted"></i>
                                    <p class="text-muted small mt-2 mb-0">No saved cards or MFS accounts. Save your bKash, Nagad, or Cards for 1-click checkout!</p>
                                </div>
                            }
                        </div>

                        <!-- Billing & PDF Invoice History -->
                        <div class="col-12 col-lg-6">
                            <h6 class="fw-bold mb-3">Billing History &amp; Receipts</h6>
                            @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                            {
                                <div class="vstack gap-2" style="max-height: 280px; overflow-y: auto;">
                                    @foreach (var ord in Model.RecentOrders)
                                    {
                                        <div class="p-3 border rounded-3 bg-white shadow-sm d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong class="text-dark small d-block">Order #@ord.OrderNumber</strong>
                                                <small class="text-muted">@ord.CreatedAt.ToString("MMM dd, yyyy") • ৳@ord.TotalAmount.ToString("N2") • @ord.PaymentMethod</small>
                                            </div>
                                            <a asp-controller="Checkout" asp-action="Invoice" asp-route-orderId="@ord.Id" target="_blank"
                                               class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                <i class="bi bi-file-earmark-pdf me-1"></i> Invoice PDF
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small">No billing transactions recorded yet.</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- ==================== TAB 4: ACCOUNT DETAILS ==================== -->
                <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
                    <form asp-controller="Account" asp-action="UpdateProfile" method="post" style="max-width: 600px;">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email Address (Login Identifier)</label>
                            <input type="text" class="form-control bg-light" value="@Model.User.Email" readonly disabled />
                            <small class="text-muted">Your email address is your verified MediGuard login identifier.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Full Name</label>
                            <input type="text" name="fullName" class="form-control" value="@Model.User.FullName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Phone Number</label>
                            <input type="tel" name="phoneNumber" class="form-control" value="@Model.User.PhoneNumber" placeholder="e.g. +8801700000000" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Emergency Contact Name &amp; Phone</label>
                            <input type="text" name="emergencyContact" class="form-control" value="@Model.EmergencyContact" placeholder="e.g. Brother: +8801800000000" />
                            <small class="text-muted">Used in medical emergencies or critical medication delivery situations.</small>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Default Delivery Address</label>
                            <textarea name="deliveryAddress" class="form-control" rows="3" placeholder="House, Road, Area, City...">@Model.DeliveryAddress</textarea>
                            <small class="text-muted">Prefilled automatically at checkout for all medicine purchases.</small>
                        </div>
                        <button type="submit" class="btn btn-teal-solid rounded-pill px-4">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>

</div>

<!-- ============ MODALS ============ -->

<!-- 1. Profile Avatar Upload Modal -->
<div class="modal fade" id="avatarModal" tabindex="-1" aria-labelledby="avatarModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="avatarModalLabel">Customer Profile Photo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-controller="Account" asp-action="UploadProfileImage" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3 text-center">
                        @if (!string.IsNullOrEmpty(Model.User.ProfileImageUrl))
                        {
                            <img src="@Model.User.ProfileImageUrl" alt="Current Avatar" class="rounded-circle shadow object-fit-cover mb-3" style="width: 100px; height: 100px;" />
                        }
                        <input type="file" name="profilePhoto" class="form-control" accept="image/jpeg,image/png,image/webp" required />
                        <small class="text-muted d-block mt-2">Accepted formats: JPG, PNG, WEBP (Max 5MB)</small>
                    </div>
                    <div class="d-flex justify-content-between pt-2 border-top">
                        @if (!string.IsNullOrEmpty(Model.User.ProfileImageUrl))
                        {
                            <button type="submit" asp-controller="Account" asp-action="DeleteProfileImage" class="btn btn-outline-danger rounded-pill px-3 btn-sm">
                                <i class="bi bi-trash me-1"></i> Delete Photo
                            </button>
                        }
                        else
                        {
                            <div></div>
                        }
                        <button type="submit" class="btn btn-teal-solid rounded-pill px-4">Upload Photo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- 2. Profile Details Edit Modal -->
<div class="modal fade" id="profileEditModal" tabindex="-1" aria-labelledby="profileEditModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="profileEditModalLabel">Edit Customer Account Information</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Account" asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Full Name</label>
                        <input type="text" name="fullName" class="form-control" value="@Model.User.FullName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Phone Number</label>
                        <input type="tel" name="phoneNumber" class="form-control" value="@Model.User.PhoneNumber" placeholder="+880..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Emergency Contact</label>
                        <input type="text" name="emergencyContact" class="form-control" value="@Model.EmergencyContact" placeholder="Name & Phone Number" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Default Delivery Address</label>
                        <textarea name="deliveryAddress" class="form-control" rows="3">@Model.DeliveryAddress</textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-teal-solid rounded-pill px-4">Save Profile</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 3. Upload Prescription Modal -->
<div class="modal fade" id="uploadRxModal" tabindex="-1" aria-labelledby="uploadRxModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="uploadRxModalLabel">Upload Medical Prescription</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Prescription" asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p class="text-muted small">Select your doctor's prescription file or snapshot. Our licensed pharmacist will review and verify it.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Prescription File (JPEG, PNG, or PDF)</label>
                        <input type="file" name="prescriptionFile" class="form-control" accept="image/jpeg,image/png,application/pdf" required />
                    </div>
                    <div class="alert alert-light border small text-muted">
                        <i class="bi bi-shield-check text-success me-1"></i> File will be safely encrypted and checked under healthcare privacy standards.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-teal-solid rounded-pill px-4">Upload Rx</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 4. Add Payment Method Modal -->
<div class="modal fade" id="addPaymentModal" tabindex="-1" aria-labelledby="addPaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="addPaymentModalLabel">Add Payment Method</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Account" asp-action="SavePaymentMethod" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Payment Type</label>
                        <select name="type" class="form-select">
                            <option value="BKASH">bKash Mobile Financial Service</option>
                            <option value="NAGAD">Nagad MFS</option>
                            <option value="ROCKET">Rocket MFS</option>
                            <option value="CARD">Credit / Debit Card</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Title / Nickname</label>
                        <input type="text" name="title" class="form-control" placeholder="e.g. Personal bKash or Visa Card" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account / Card Number</label>
                        <input type="text" name="accountNumber" class="form-control" placeholder="e.g. 017XXXXXXXX or **** 4242" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Expiry (if card)</label>
                        <input type="text" name="expiry" class="form-control" placeholder="MM/YY" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-teal-solid rounded-pill px-4">Save Method</button>
                </div>
            </form>
        </div>
    </div>
</div>
