@model MediGuard.Models.ViewModels.RoleAssignmentViewModel

<style>
    /* Scoped styles for the role assignment modal — prefixed with .mg- to avoid leaking */
    #roleAssignmentModal .modal-content {
        border-radius: 18px;
        overflow: hidden;
        border: none;
    }

    #roleAssignmentModal .mg-header {
        background: linear-gradient(120deg, #3B1370 0%, #5B21B6 55%, #6D28D9 100%);
        padding: 1.5rem 1.75rem;
        position: relative;
    }

    #roleAssignmentModal .mg-header::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 88% 20%, rgba(255,255,255,0.10) 0%, transparent 45%);
        pointer-events: none;
    }

    #roleAssignmentModal .mg-header-icon {
        width: 40px;
        height: 40px;
        border-radius: 11px;
        background: rgba(255,255,255,0.14);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    #roleAssignmentModal .mg-body {
        background-color: #F6F7FB;
        padding: 1.75rem;
    }

    #roleAssignmentModal .mg-staff-card {
        border: 1px solid #EEF0F6;
        border-radius: 14px;
        background: #FFFFFF;
        padding: 0.9rem 1.1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.35rem;
    }

    #roleAssignmentModal .mg-avatar {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: linear-gradient(135deg, #059669, #10B981);
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    #roleAssignmentModal .mg-tenant-badge {
        font-size: 0.78rem;
        font-weight: 600;
        color: #4C1D95;
        background: #F1EAFB;
        border: 1px solid #E4D6F8;
        padding: 0.4rem 0.85rem;
        border-radius: 999px;
    }

    #roleAssignmentModal .mg-category-card {
        border: 1px solid #EEF0F6;
        border-radius: 14px;
        background: #FFFFFF;
        padding: 1.1rem 1.15rem 0.5rem;
        height: 100%;
    }

    #roleAssignmentModal .mg-category-head {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.85rem;
    }

    #roleAssignmentModal .mg-category-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        flex-shrink: 0;
    }

    #roleAssignmentModal .mg-category-title {
        font-weight: 700;
        font-size: 0.92rem;
        color: #1E2333;
        margin: 0;
    }

    /* Permission row rendered as a toggle pill instead of a plain checkbox */
    #roleAssignmentModal .mg-perm-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.6rem 0.15rem;
        border-bottom: 1px solid #F3F4F8;
    }

    #roleAssignmentModal .mg-perm-row:last-child {
        border-bottom: none;
    }

    #roleAssignmentModal .mg-perm-label {
        font-size: 0.88rem;
        font-weight: 500;
        color: #333A4D;
        margin: 0;
        cursor: pointer;
    }

    /* Custom switch look, built on the real checkbox input for full a11y + JS compatibility */
    #roleAssignmentModal .mg-switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 22px;
        flex-shrink: 0;
    }

    #roleAssignmentModal .mg-switch input {
        opacity: 0;
        width: 100%;
        height: 100%;
        margin: 0;
        position: absolute;
        cursor: pointer;
        z-index: 2;
    }

    #roleAssignmentModal .mg-switch-track {
        position: absolute;
        inset: 0;
        background: #DDE1EA;
        border-radius: 999px;
        transition: background 0.18s ease;
    }

    #roleAssignmentModal .mg-switch-track::before {
        content: "";
        position: absolute;
        top: 2px;
        left: 2px;
        width: 18px;
        height: 18px;
        background: #fff;
        border-radius: 50%;
        box-shadow: 0 1px 2px rgba(0,0,0,0.25);
        transition: transform 0.18s ease;
    }

    #roleAssignmentModal .mg-switch input:checked ~ .mg-switch-track {
        background: #059669;
    }

    #roleAssignmentModal .mg-switch input:checked ~ .mg-switch-track::before {
        transform: translateX(18px);
    }

    #roleAssignmentModal .mg-switch input:focus-visible ~ .mg-switch-track {
        outline: 2px solid #6D28D9;
        outline-offset: 2px;
    }

    #roleAssignmentModal .mg-switch input:disabled ~ .mg-switch-track {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Medi+ premium card */
    #roleAssignmentModal .mg-premium-card {
        border-radius: 14px;
        background: linear-gradient(135deg, #0B5E56 0%, #0D9488 100%);
        position: relative;
        overflow: hidden;
        color: #fff;
    }

    #roleAssignmentModal .mg-premium-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 92% 0%, rgba(255,255,255,0.16) 0%, transparent 40%),
                           radial-gradient(circle at 4% 100%, rgba(255,255,255,0.08) 0%, transparent 45%);
        pointer-events: none;
    }

    #roleAssignmentModal .mg-premium-chip {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        color: #1E2333;
        background: #FBBF24;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
    }

    #roleAssignmentModal #mediPlusSwitchWrapper .mg-switch-track {
        background: rgba(255,255,255,0.28);
    }

    #roleAssignmentModal #mediPlusSwitchWrapper .mg-switch input:checked ~ .mg-switch-track {
        background: #FBBF24;
    }

    #roleAssignmentModal .mg-footer {
        background: #FFFFFF;
        border-top: 1px solid #EEF0F6;
        padding: 1rem 1.75rem;
    }

    #roleAssignmentModal .mg-btn-save {
        background: #059669;
        border-color: #059669;
        font-weight: 600;
        border-radius: 10px;
        padding: 0.55rem 1.4rem;
    }

    #roleAssignmentModal .mg-btn-save:hover {
        background: #047857;
        border-color: #047857;
    }

    #roleAssignmentModal .mg-btn-cancel {
        border-radius: 10px;
        font-weight: 600;
        padding: 0.55rem 1.4rem;
    }
</style>

<div class="modal fade" id="roleAssignmentModal" tabindex="-1" aria-labelledby="roleAssignmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg">

            <!-- Modal Header -->
            <div class="modal-header mg-header text-white border-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="mg-header-icon">
                        <i class="bi bi-shield-lock-fill" style="font-size: 1.1rem;"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="roleAssignmentModalLabel">Assign Roles &amp; Permissions</h5>
                        <small class="text-white-50" id="modalUserSubtitle">Managing access for pharmacy staff member</small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body mg-body">

                <!-- Async Loader -->
                <div id="permissionModalLoader" class="text-center py-5 d-none">
                    <div class="spinner-border" role="status" style="color: #6D28D9;">
                        <span class="visually-hidden">Loading permissions...</span>
                    </div>
                    <p class="mt-2 text-muted fw-medium">Loading user permissions...</p>
                </div>

                <!-- Form Content -->
                <form id="roleAssignmentForm" class="needs-validation" novalidate>
                    <input type="hidden" id="modalUserId" name="UserId" value="" />

                    <!-- Staff Summary Card -->
                    <div class="mg-staff-card">
                        <div class="d-flex align-items-center gap-3">
                            <div class="mg-avatar" id="modalUserAvatar">--</div>
                            <div>
                                <h6 class="mb-0 fw-bold text-dark" id="modalUserName">User Name</h6>
                                <small class="text-muted" id="modalUserRole">Staff Member</small>
                            </div>
                        </div>
                        <span class="mg-tenant-badge" id="tenantStatusBadge">
                            <i class="bi bi-building me-1"></i>Pharmacy Tenant
                        </span>
                    </div>

                    <div class="row g-3">
                        <!-- Category 1: POS Controls -->
                        <div class="col-md-6">
                            <div class="mg-category-card">
                                <div class="mg-category-head">
                                    <div class="mg-category-icon" style="background:#EEF0FE; color:#4F46E5;">
                                        <i class="bi bi-calculator"></i>
                                    </div>
                                    <p class="mg-category-title">POS Controls</p>
                                </div>

                                <div class="mg-perm-row">
                                    <label class="mg-perm-label" for="perm_pos_sell">Sell</label>
                                    <span class="mg-switch">
                                        <input class="perm-checkbox" type="checkbox" value="pos.sell" id="perm_pos_sell">
                                        <span class="mg-switch-track"></span>
                                    </span>
                                </div>
                                <div class="mg-perm-row">
                                    <label class="mg-perm-label" for="perm_pos_discount">Apply Discount</label>
                                    <span class="mg-switch">
                                        <input class="perm-checkbox" type="checkbox" value="pos.discount" id="perm_pos_discount">
                                        <span class="mg-switch-track"></span>
                                    </span>
                                </div>
                                <div class="mg-perm-row">
                                    <label class="mg-perm-label" for="perm_pos_void">Void Sale</label>
                                    <span class="mg-switch">
                                        <input class="perm-checkbox" type="checkbox" value="pos.void_sale" id="perm_pos_void">
                                        <span class="mg-switch-track"></span>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Category 2: Inventory Controls -->
                        <div class="col-md-6">
                            <div class="mg-category-card">
                                <div class="mg-category-head">
                                    <div class="mg-category-icon" style="background:#E8F7F2; color:#0D9488;">
                                        <i class="bi bi-boxes"></i>
                                    </div>
                                    <p class="mg-category-title">Inventory Controls</p>
                                </div>

                                <div class="mg-perm-row">
                                    <label class="mg-perm-label" for="perm_inv_add">Add Inventory</label>
                                    <span class="mg-switch">
                                        <input class="perm-checkbox" type="checkbox" value="inventory.add" id="perm_inv_add">
                                        <span class="mg-switch-track"></span>
                                    </span>
                                </div>
                                <div class="mg-perm-row">
                                    <label class="mg-perm-label" for="perm_inv_edit">Edit Inventory</label>
                                    <span class="mg-switch">
                                        <input class="perm-checkbox" type="checkbox" value="inventory.edit" id="perm_inv_edit">
                                        <span class="mg-switch-track"></span>
                                    </span>
                                </div>
                                <div class="mg-perm-row">
                                    <label class="mg-perm-label" for="perm_inv_adjust">Adjust Batch</label>
                                    <span class="mg-switch">
                                        <input class="perm-checkbox" type="checkbox" value="inventory.adjust_batch" id="perm_inv_adjust">
                                        <span class="mg-switch-track"></span>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Category 3: Delivery Controls -->
                        <div class="col-12">
                            <div class="mg-category-card">
                                <div class="mg-category-head">
                                    <div class="mg-category-icon" style="background:#FFF4E5; color:#D97706;">
                                        <i class="bi bi-truck"></i>
                                    </div>
                                    <p class="mg-category-title">Delivery Controls</p>
                                </div>

                                <div class="row">
                                    <div class="col-sm-6">
                                        <div class="mg-perm-row">
                                            <label class="mg-perm-label" for="perm_del_view">View Assigned Deliveries</label>
                                            <span class="mg-switch">
                                                <input class="perm-checkbox" type="checkbox" value="delivery.view_assigned" id="perm_del_view">
                                                <span class="mg-switch-track"></span>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="mg-perm-row">
                                            <label class="mg-perm-label" for="perm_del_update">Update Delivery Status</label>
                                            <span class="mg-switch">
                                                <input class="perm-checkbox" type="checkbox" value="delivery.update_status" id="perm_del_update">
                                                <span class="mg-switch-track"></span>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Category 4: Advanced B2B Controls (Medi+ Card) -->
                        <div class="col-12 mt-1">
                            <div class="mg-premium-card" id="mediPlusCard">
                                <div class="card-body p-3 p-md-4 position-relative">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="pe-3">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <span class="mg-premium-chip">Special Feature</span>
                                            </div>
                                            <h6 class="mb-1 fw-bold fs-5 text-white">Medi+ B2B Access</h6>
                                            <p class="mb-0 text-white-50 small" style="max-width: 420px;">
                                                Lets this staff member use Medi+ B2B features, cross-pharmacy stock transfers, and automated bulk procurement.
                                            </p>
                                        </div>

                                        <!-- Wrapper for Bootstrap Tooltip support on disabled switch -->
                                        <div id="mediPlusSwitchWrapper" tabindex="0">
                                            <span class="mg-switch" style="width:46px; height:25px;">
                                                <input type="checkbox" value="b2b.mediplus.access" id="perm_b2b_mediplus">
                                                <span class="mg-switch-track"></span>
                                            </span>
                                            <label class="visually-hidden" for="perm_b2b_mediplus">Enable Medi+ B2B Access</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer mg-footer border-0">
                <button type="button" class="btn btn-outline-secondary mg-btn-cancel" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary mg-btn-save" id="btnSavePermissions">
                    <span id="saveBtnSpinner" class="spinner-border spinner-border-sm me-1 d-none" role="status" aria-hidden="true"></span>
                    <span id="saveBtnText"><i class="bi bi-check2-circle me-1"></i>Save Changes</span>
                </button>
            </div>
        </div>
    </div>
</div>
