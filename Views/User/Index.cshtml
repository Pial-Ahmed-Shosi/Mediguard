@model MediGuard.Models.ViewModels.UserManagementViewModel
@{
    ViewData["Title"] = "Staff Management";
    var staffCount = Model.Users?.Count() ?? 0;
}

<style>
    :root {
        --mg-ink: #12313a; 
        --mg-muted: #6b7f86;
        --mg-teal: #0f766e;
        --mg-teal-dark: #0b5a54;
        --mg-mint: #e6f4f1;
        --mg-line: #e3ebed;
        --mg-bg: #f5f8f9;
    }

    .mg-page { background: var(--mg-bg); min-height: 100vh;}

    /* Header banner */
    .mg-hero {
        background: linear-gradient(120deg, var(--mg-teal-dark), var(--mg-teal));
        border-radius: 1rem;
        color: #fff;
        padding: 1.75rem 2rem;
        position: relative;
        overflow: hidden;
    }
    .mg-hero::after {
        content: "\F4D9"; /* bi-heart-pulse */
        font-family: "bootstrap-icons";
        position: absolute;
        right: 2rem; top: 50%;
        transform: translateY(-50%);
        font-size: 8rem;
        opacity: .08;
        pointer-events: none;
    }
    .mg-hero h2 { font-weight: 700; letter-spacing: -.01em; }
    .mg-hero p { color: rgba(255,255,255,.8); max-width: 34rem; }
    .mg-count {
        background: rgba(255,255,255,.15);
        border-radius: 999px;
        padding: .35rem .9rem;
        font-size: .85rem;
    }
    .mg-hero .btn-light { color: var(--mg-teal-dark); font-weight: 600; border-radius: .65rem; padding: .6rem 1.1rem; }
    .mg-hero .btn-light:hover { background: var(--mg-mint); }

    /* Filter bar */
    .mg-filters { border: 1px solid var(--mg-line); border-radius: 1rem; background: #fff; }
    #roleFilterTabs { background: var(--mg-bg); border-radius: .75rem; padding: .3rem; display: inline-flex; flex-wrap: wrap; gap: .2rem; }
    #roleFilterTabs .nav-link {
        color: var(--mg-muted);
        font-weight: 500;
        font-size: .9rem;
        border-radius: .55rem; 
        padding: .45rem .95rem;
        transition: background .15s, color .15s;
    }
    #roleFilterTabs .nav-link:hover { color: var(--mg-ink); }
    #roleFilterTabs .nav-link.active {
        background: #fff;
        color: var(--mg-teal-dark);
        box-shadow: 0 1px 3px rgba(18,49,58,.12);
    } 
    .mg-search .input-group-text { background: var(--mg-bg); border: 1px solid var(--mg-line); border-right: 0; color: var(--mg-muted); border-radius: .65rem 0 0 .65rem;}
    .mg-search .form-control { background: var(--mg-bg); border: 1px solid var(--mg-line); border-left: 0; border-radius: 0 .65rem .65rem 0; padding: .6rem .9rem;} 
    .mg-search .form-control:focus, .mg-field:focus {
        box-shadow: 0 0 0 .2rem rgba(15,118,110,.15);
        border-color: var(--mg-teal);
        background: #fff;
    }

    /* Table card (partial renders inside) */
    #userTableContainer {
        border: 1px solid var(--mg-line) !important;
        border-radius: 1rem;
        background: #fff;
        overflow: hidden;
    }
    #userTableContainer .table { margin-bottom: 0; }
    #userTableContainer thead th {
        background: var(--mg-bg);
        color: var(--mg-muted);
        font-weight: 600;
        font-size: .8rem;
        border-bottom: 1px solid var(--mg-line);
        padding: .9rem 1.25rem;
        white-space: nowrap;
    }
    #userTableContainer tbody td { padding: .95rem 1.25rem; vertical-align: middle; border-color: var(--mg-line); }
    #userTableContainer tbody tr:hover { background: #fafcfc; }

    /* Offcanvas form */
    #addStaffOffcanvas { width: 420px; border: 0; box-shadow: -12px 0 40px rgba(18,49,58,.15); }
    #addStaffOffcanvas .offcanvas-header { padding: 1.5rem; background: var(--mg-mint); border-bottom: 1px solid var(--mg-line); }
    #addStaffOffcanvas .offcanvas-body { padding: 1.5rem; }
    .mg-offc-icon {
        width: 2.6rem; height: 2.6rem;
        border-radius: .75rem;
        background: var(--mg-teal);
        color: #fff;
        display: grid; place-items: center;
        font-size: 1.2rem; 
    }
    .mg-field { border: 1px solid var(--mg-line); border-radius: .65rem; padding: .65rem .9rem; }
    .mg-label { font-weight: 600; font-size: .85rem; color: var(--mg-ink); margin-bottom: .35rem; }
    .btn-mg { background: var(--mg-teal); border-color: var(--mg-teal); color: #fff; font-weight: 600; border-radius: .65rem; padding: .7rem 1rem; }
    .btn-mg:hover, .btn-mg:focus { background: var(--mg-teal-dark); border-color: var(--mg-teal-dark); color: #fff; }

    @@media (max-width: 575.98px) {
        .mg-hero { padding: 1.35rem; }
        #addStaffOffcanvas { width: 100%; }
    }
    @@media (prefers-reduced-motion: reduce) {
        * { transition: none !important; }
    }
</style>

<div class="container-fluid py-4 mg-page">

    <!-- Header -->
    <div class="mg-hero mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h2 class="h3 mb-2">Staff &amp; Delivery Management</h2>
            <p class="mb-3">Manage your pharmacy team, assign roles and keep delivery staff up to date.</p>
            <span class="mg-count"><i class="bi bi-people-fill me-2"></i>@staffCount team members</span>
        </div>
        <div>
            <button class="btn btn-light shadow-sm" type="button" data-bs-toggle="offcanvas" data-bs-target="#addStaffOffcanvas">
                <i class="bi bi-person-plus-fill me-2"></i>Add new employee
            </button>
        </div>
    </div>

    <!-- Quick Filters & Search -->
    <div class="mg-filters shadow-sm mb-4">
        <div class="p-3 row g-3 align-items-center">
            <div class="col-lg-8">
                <ul class="nav nav-pills" id="roleFilterTabs">
                    <li class="nav-item"><button class="nav-link active" data-role="All"><i class="bi bi-grid-fill me-2"></i>All staff</button></li>
                    <li class="nav-item"><button class="nav-link" data-role="Pharmacy Manager"><i class="bi bi-capsule me-2"></i>Pharmacy managers</button></li>
                    <li class="nav-item"><button class="nav-link" data-role="Deliveryman"><i class="bi bi-bicycle me-2"></i>Deliverymen</button></li>
                    <li class="nav-item"><button class="nav-link" data-status="Inactive"><i class="bi bi-person-dash me-2"></i>Inactive</button></li>
                </ul>
            </div>
            <div class="col-lg-4">
                <div class="input-group mg-search">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" id="userSearchInput" class="form-control" placeholder="Search by name or email" aria-label="Search staff">
                </div>
            </div>
        </div>
    </div> 

    <!-- AJAX Table Container -->
    <div id="userTableContainer" class="shadow-sm">
        @await Html.PartialAsync("_UserListTable", Model.Users)
    </div>
</div>

<!-- Offcanvas: Add Staff (Ticket 4) -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="addStaffOffcanvas" aria-labelledby="addStaffTitle">
    <div class="offcanvas-header">
        <div class="d-flex align-items-center gap-3">
            <div class="mg-offc-icon"><i class="bi bi-person-plus-fill"></i></div>
            <div>
                <h5 class="offcanvas-title mb-0" id="addStaffTitle">Add new staff</h5>
                <small class="text-muted">Fill in the details to create an account.</small>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button> 
    </div>
    <div class="offcanvas-body">
        <form id="addStaffForm" asp-action="AddStaff" method="post">
            <div class="mb-3">
                <label asp-for="NewStaff.FullName" class="mg-label">Full name</label>
                <input asp-for="NewStaff.FullName" class="form-control mg-field" placeholder="e.g. Rahim Uddin" />
                <span asp-validation-for="NewStaff.FullName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewStaff.Email" class="mg-label">Email</label>
                <input asp-for="NewStaff.Email" class="form-control mg-field" placeholder="name@pharmacy.com" />
                <span asp-validation-for="NewStaff.Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewStaff.Role" class="mg-label">Role</label>
                <select asp-for="NewStaff.Role" class="form-select mg-field">
                    <option value="Staff">General Staff</option>
                    <option value="Pharmacy Manager">Pharmacy Manager</option>
                    <option value="Deliveryman">Deliveryman</option>
                </select>
            </div>
            <div class="mb-4">
                <label asp-for="NewStaff.Phone" class="mg-label">Phone</label>
                <input asp-for="NewStaff.Phone" class="form-control mg-field" placeholder="+880 1XXX-XXXXXX" /> 
                <span asp-validation-for="NewStaff.Phone" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-mg w-100">
                <i class="bi bi-check2-circle me-2"></i>Save employee
            </button>
        </form>
    </div>
</div>

<!-- Render Permission Modal (Ticket 5) -->
<partial name="_RoleAssignmentModal" />

@section Scripts {
    <script src="~/js/user-management.js"></script>
}
