@model MediGuard.Models.Order
@{
    ViewData["Title"] = $"Invoice #{Model.OrderNumber}";
    var payment = ViewBag.Payment as MediGuard.Models.Payment;
}

<div class="container py-5" style="max-width: 820px;">
    <!-- Printable Invoice Card -->
    <div class="card border-0 rounded-4 shadow-sm bg-white p-4 p-md-5" id="printableInvoice">
        <!-- Top Controls (hidden on print) -->
        <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-3 py-1.5 btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                <i class="bi bi-printer me-1"></i> Print / Save as PDF
            </button>
        </div>

        <!-- Invoice Header -->
        <div class="border-bottom pb-4 mb-4">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="p-2 rounded-3 bg-teal text-white fw-bold d-inline-flex" style="background-color: #0b6e5f;">
                            <i class="bi bi-shield-plus fs-4"></i>
                        </div>
                        <div>
                            <h3 class="fw-bold mb-0 text-dark">MediGuard</h3>
                            <small class="text-muted">Verified Pharmacy Health Network</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-0">
                        <strong>Partner Branch:</strong> @(Model.Pharmacy?.Name ?? "MediGuard Central")<br />
                        <strong>License:</strong> @(Model.Pharmacy?.LicenseNumber ?? "DH-PHARM-2026")<br />
                        <strong>Location:</strong> @(Model.Pharmacy?.Address ?? "Dhaka, Bangladesh")
                    </p>
                </div>
                <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fs-6 mb-2">
                        INVOICE
                    </span>
                    <h5 class="fw-bold text-primary mb-1">#@Model.OrderNumber</h5>
                    <div class="text-muted small">Date: @Model.CreatedAt.ToString("dd MMMM yyyy, hh:mm tt")</div>
                    <div class="mt-2">
                        @if (Model.PaymentStatus == "PAID" || (payment != null && payment.Status == "SUCCEEDED"))
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-bold">
                                <i class="bi bi-check-circle-fill me-1"></i> PAYMENT COMPLETED
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1.5 rounded-pill fw-bold">
                                <i class="bi bi-hourglass-split me-1"></i> PENDING COD PAYMENT
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Bill To / Ship To -->
        <div class="row mb-4">
            <div class="col-sm-6">
                <h6 class="text-uppercase text-muted fw-bold small mb-2" style="letter-spacing: 0.05em;">Billed To:</h6>
                <div class="fw-bold text-dark">@(Model.Customer?.FullName ?? Model.User?.FullName ?? "Customer")</div>
                <div class="text-muted small">@(Model.Customer?.Email ?? Model.User?.Email ?? "")</div>
                @if (!string.IsNullOrWhiteSpace(Model.Customer?.PhoneNumber ?? Model.User?.PhoneNumber))
                {
                    <div class="text-muted small"><i class="bi bi-telephone me-1"></i> @(Model.Customer?.PhoneNumber ?? Model.User?.PhoneNumber)</div>
                }
            </div>
            <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                <h6 class="text-uppercase text-muted fw-bold small mb-2" style="letter-spacing: 0.05em;">Delivery Address:</h6>
                <div class="text-dark small">@(string.IsNullOrWhiteSpace(Model.ShippingAddress) ? "Default customer address" : Model.ShippingAddress)</div>
                <div class="text-muted small mt-1">
                    <strong>Payment Method:</strong> @Model.PaymentMethod<br />
                    @if (payment != null && !string.IsNullOrWhiteSpace(payment.GatewayTransactionId))
                    {
                        <span><strong>Transaction Ref:</strong> @payment.GatewayTransactionId</span>
                    }
                </div>
            </div>
        </div>

        <!-- Itemized Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th style="width: 50%;">Medicine Item</th>
                        <th class="text-center" style="width: 15%;">Unit Price</th>
                        <th class="text-center" style="width: 10%;">Qty</th>
                        <th class="text-end" style="width: 20%;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 1; }
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td class="text-center text-muted small">@(idx++)</td>
                            <td>
                                <div class="fw-bold text-dark">@(item.Medicine?.BrandName ?? "Prescribed Medicine")</div>
                                @if (!string.IsNullOrWhiteSpace(item.Medicine?.GenericName))
                                {
                                    <small class="text-muted">Chemical: @item.Medicine.GenericName</small>
                                }
                            </td>
                            <td class="text-center">৳@item.UnitPrice.ToString("N2")</td>
                            <td class="text-center fw-semibold">@item.Quantity</td>
                            <td class="text-end fw-bold">৳@item.TotalPrice.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Totals & Calculations -->
        <div class="row justify-content-end mb-4">
            <div class="col-sm-6 col-md-5">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between border-0 px-0 py-1">
                        <span class="text-muted">Items Subtotal:</span>
                        <span class="fw-semibold">৳@Model.Subtotal.ToString("N2")</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between border-0 px-0 py-1">
                        <span class="text-muted">Prescription Verification Fee:</span>
                        <span class="text-success fw-semibold">FREE (৳0.00)</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between border-0 px-0 py-1">
                        <span class="text-muted">Delivery &amp; Courier:</span>
                        <span class="fw-semibold">৳@(Model.TotalAmount - Model.Subtotal > 0 ? (Model.TotalAmount - Model.Subtotal).ToString("N2") : "60.00")</span>
                    </li>
                    @if (Model.Discount > 0)
                    {
                        <li class="list-group-item d-flex justify-content-between border-0 px-0 py-1 text-danger">
                            <span>Discount:</span>
                            <span>-৳@Model.Discount.ToString("N2")</span>
                        </li>
                    }
                    <li class="list-group-item d-flex justify-content-between border-top px-0 py-2 fs-6 fw-bold text-dark">
                        <span>Total Paid / Payable:</span>
                        <span class="text-primary">৳@Model.TotalAmount.ToString("N2")</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Invoice Footer & Security Watermark -->
        <div class="border-top pt-4 text-center text-muted small">
            <div class="d-flex justify-content-center gap-4 mb-2">
                <span><i class="bi bi-shield-check text-success me-1"></i> Quality Checked</span>
                <span><i class="bi bi-patch-check text-teal me-1"></i> Licensed Pharmacy</span>
                <span><i class="bi bi-qr-code me-1"></i> Digital MediGuard ID</span>
            </div>
            <p class="mb-0">
                This is a computer-generated tax invoice issued by MediGuard e-Healthcare Platform.
                For inquiries or return requests, please contact support@mediguard.com.
            </p>
        </div>
    </div>
</div>

<style>
    @@media print {
        body { background: white !important; font-size: 12pt; }
        .d-print-none, nav, footer { display: none !important; }
        .container { max-width: 100% !important; padding: 0 !important; }
        .card { box-shadow: none !important; border: 0 !important; }
    }
</style>
