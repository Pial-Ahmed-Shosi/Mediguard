@model MediGuard.Models.ViewModels.PaymentCheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
    Layout = "_Layout";
    var primary = Model.Items.FirstOrDefault();
    var singleItem = Model.Items.Count == 1;
}

@* NOTE: If your _Layout already renders the MediGo sidebar/top bar,
   delete the <aside> and <header> blocks below. *@

<div class="mg-shell">

    <!-- ============ SIDEBAR ============ -->
    <aside class="mg-sidebar">
        <div class="mg-avatar">@Model.CustomerInitials</div>
        <div class="mg-username">@Model.CustomerName</div>
        <nav class="mg-nav">
            <a class="active" href="/Store"><i class="bi bi-cart3"></i> MediGo</a>
            <a href="/Orders/History"><i class="bi bi-clock"></i> History</a>
            <a href="/Complaint"><i class="bi bi-exclamation-circle"></i> Complain</a>
        </nav>
    </aside>

    <div class="mg-main">

        <!-- ============ TOP BAR ============ -->
        <header class="mg-topbar">
            <a href="/Store"><i class="bi bi-arrow-left"></i> Back to Store</a>
            <a href="/"><i class="bi bi-house"></i> Home</a>
            <a href="/Dashboard"><i class="bi bi-person-circle"></i> Dashboard</a>
        </header>

        <div class="mg-content">

            <!-- ============ STEPPER ============ -->
            <ol class="mg-steps" aria-label="Checkout progress">
                <li class="done"><span class="dot"><i class="bi bi-check"></i></span> Cart</li>
                <li class="line"></li>
                <li class="current" aria-current="step"><span class="dot">2</span> Checkout</li>
                <li class="line"></li>
                <li><span class="dot">3</span> Confirmation</li>
            </ol>

            <form id="payment-form" novalidate
                  data-order-id="@Model.OrderId"
                  data-publishable-key="@Model.StripePublishableKey"
                  data-currency="@Model.CurrencySymbol"
                  data-delivery-fee="@Model.DeliveryFee.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                  data-unit-price="@(primary?.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")"
                  data-quantity="@(primary?.Quantity ?? 1)"
                  data-single-item="@singleItem.ToString().ToLower()">
                @Html.AntiForgeryToken()

                <div class="mg-grid">

                    <!-- ============ LEFT REGION: ORDER CONTEXT ============ -->
                    <div class="mg-card mg-left">

                        @foreach (var item in Model.Items)
                        {
                            <div class="mg-product">
                                <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? "/images/medicine-placeholder.png" : item.ImageUrl)"
                                     alt="@item.MedicineName" />
                                <div>
                                    @if (!string.IsNullOrWhiteSpace(item.BadgeText))
                                    {
                                        <span class="mg-badge">@item.BadgeText</span>
                                    }
                                    <h2 class="mg-product-name">@item.MedicineName</h2>
                                    @if (!string.IsNullOrWhiteSpace(item.Manufacturer))
                                    {
                                        <div class="mg-meta"><i class="bi bi-building"></i> @item.Manufacturer</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.PackagingNote))
                                    {
                                        <div class="mg-meta"><i class="bi bi-shield-check"></i> @item.PackagingNote</div>
                                    }
                                    @if (!singleItem)
                                    {
                                        <div class="mg-meta">Qty @item.Quantity &times; @Model.FormatMoney(item.UnitPrice)</div>
                                    }
                                </div>
                            </div>
                        }

                        <div class="mg-pharmacy">
                            <div class="mg-pharmacy-icon"><i class="bi bi-shop"></i></div>
                            <div class="flex-grow-1">
                                <div class="mg-pharmacy-name">@Model.PharmacyName</div>
                                <div class="mg-meta"><i class="bi bi-geo-alt-fill text-danger"></i> @Model.PharmacyAddress</div>
                            </div>
                            @if (Model.PharmacyVerified)
                            {
                                <span class="mg-verified"><i class="bi bi-patch-check-fill"></i> Verified</span>
                            }
                        </div>

                        <h3 class="mg-h">Select Fulfillment Method</h3>
                        <div class="mg-options two" role="radiogroup" aria-label="Fulfillment method">
                            <label class="mg-option selected" data-group="fulfillment">
                                <input type="radio" name="fulfillment" value="delivery" checked />
                                <span class="mg-option-title"><i class="bi bi-truck"></i> Home Delivery</span>
                                <span class="mg-option-desc">Delivered to your door in 1-2 hours. Standard fee applies.</span>
                                <i class="bi bi-check-circle-fill mg-tick"></i>
                            </label>
                            @if (Model.StorePickupAvailable)
                            {
                                <label class="mg-option" data-group="fulfillment">
                                    <input type="radio" name="fulfillment" value="pickup" />
                                    <span class="mg-option-title"><i class="bi bi-bag-check"></i> Store Pickup</span>
                                    <span class="mg-option-desc">Collect directly from the pharmacy. Free of charge.</span>
                                    <i class="bi bi-check-circle-fill mg-tick"></i>
                                </label>
                            }
                        </div>

                        <section id="delivery-details">
                            <h3 class="mg-h">Delivery Details</h3>

                            <label class="mg-label" for="address">FULL ADDRESS</label>
                            <input id="address" name="address" class="mg-input" type="text" autocomplete="street-address"
                                   placeholder="12/A, Road 5, Block C, Dhanmondi, Dhaka"
                                   value="@Model.ShippingAddress" />
                            <div class="mg-field-error" data-error-for="address" hidden></div>

                            <div class="mg-row">
                                <div>
                                    <label class="mg-label" for="phone">PHONE NUMBER</label>
                                    <input id="phone" name="phone" class="mg-input" type="tel" autocomplete="tel"
                                           inputmode="tel" placeholder="01XXXXXXXXX" value="@Model.CustomerPhone" />
                                    <div class="mg-field-error" data-error-for="phone" hidden></div>
                                </div>
                                <div>
                                    <label class="mg-label" for="instructions">DELIVERY INSTRUCTIONS (OPTIONAL)</label>
                                    <textarea id="instructions" name="instructions" class="mg-input" rows="2" maxlength="300"
                                              placeholder="Please call me when you arrive. If I'm unavailable, please leave the package at the front gate."></textarea>
                                </div>
                            </div>
                        </section>

                        <h3 class="mg-h">Payment Options</h3>
                        <div class="mg-options three mb-3" role="radiogroup" aria-label="Payment method">
                            <label class="mg-option center" data-group="method">
                                <input type="radio" name="method" value="cod" />
                                <i class="bi bi-cash-coin fs-4 text-success"></i><span>Cash on Delivery</span>
                            </label>
                            <label class="mg-option center" data-group="method">
                                <input type="radio" name="method" value="mfs" />
                                <i class="bi bi-phone fs-4 text-danger"></i><span>bKash / Nagad / Rocket</span>
                            </label>
                            <label class="mg-option center selected" data-group="method">
                                <input type="radio" name="method" value="card" checked />
                                <i class="bi bi-credit-card fs-4 text-primary"></i><span>Credit / Debit Card</span>
                            </label>
                        </div>

                        <!-- COD Details Section -->
                        <section id="cod-section" class="p-3 rounded-3 border bg-light mb-3" hidden>
                            <div class="d-flex align-items-center gap-3">
                                <i class="bi bi-wallet2 fs-2 text-success"></i>
                                <div>
                                    <h6 class="fw-bold mb-1">Cash on Delivery (COD) Selected</h6>
                                    <p class="text-muted small mb-0">Pay directly to our certified delivery rider when your package arrives at your doorstep. Exact change is appreciated.</p>
                                </div>
                            </div>
                        </section>

                        <!-- MFS (bKash, Nagad, Rocket) Section -->
                        <section id="mfs-section" class="p-3 rounded-3 border mb-3" style="background-color: #fafbfc;" hidden>
                            <h6 class="fw-bold mb-2">Select Mobile Financial Service (MFS)</h6>
                            <div class="d-flex gap-3 mb-3">
                                <label class="btn btn-outline-danger btn-sm active d-flex align-items-center gap-2 rounded-pill px-3 py-2 fw-semibold" id="lbl-bkash">
                                    <input type="radio" name="mfs_provider" value="BKASH" checked class="d-none" />
                                    <span>bKash</span>
                                </label>
                                <label class="btn btn-outline-warning text-dark btn-sm d-flex align-items-center gap-2 rounded-pill px-3 py-2 fw-semibold" id="lbl-nagad">
                                    <input type="radio" name="mfs_provider" value="NAGAD" class="d-none" />
                                    <span>Nagad</span>
                                </label>
                                <label class="btn btn-outline-primary btn-sm d-flex align-items-center gap-2 rounded-pill px-3 py-2 fw-semibold" id="lbl-rocket">
                                    <input type="radio" name="mfs_provider" value="ROCKET" class="d-none" />
                                    <span>Rocket</span>
                                </label>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small fw-bold text-muted">MFS WALLET / MOBILE NUMBER</label>
                                <input type="tel" id="mfs-phone" class="form-control" placeholder="017XXXXXXXX" value="@Model.CustomerPhone" maxlength="14" />
                            </div>
                            <small class="text-muted"><i class="bi bi-shield-lock me-1"></i> Instant payment simulation with 100% verified receipt generation.</small>
                        </section>

                        <!-- Card payment container: Stripe or Direct Card -->
                        <section id="card-section" class="mg-card-section mb-3">
                            <div id="payment-element" class="mg-payment-element mb-3">
                                <p class="mg-meta mb-0">Loading secure payment form...</p>
                            </div>
                            <div id="direct-card-fallback" class="p-3 border rounded-3 bg-light" hidden>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">CARD NUMBER</label>
                                    <input type="text" id="card-number-input" class="form-control" placeholder="4242 •••• •••• 4242" />
                                </div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small fw-bold">EXPIRY</label>
                                        <input type="text" id="card-expiry-input" class="form-control" placeholder="MM/YY" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-bold">CVC / CVV</label>
                                        <input type="password" id="card-cvc-input" class="form-control" placeholder="123" maxlength="4" />
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Save Payment Method Checkbox -->
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="save-payment-method" />
                            <label class="form-check-label small text-muted" for="save-payment-method">
                                Save this payment method to my account for faster checkout next time.
                            </label>
                        </div>

                        <div id="payment-message" class="mg-alert" role="alert" aria-live="assertive" hidden></div>
                    </div>

                    <!-- ============ RIGHT REGION: ORDER SUMMARY ============ -->
                    <aside class="mg-card mg-summary">
                        <h2 class="mg-summary-title">Order Summary</h2>

                        <div class="mg-eta" id="eta">
                            <i class="bi bi-clock"></i> Estimated delivery: <span id="eta-text">@Model.EstimatedDelivery</span>
                        </div>

                        @if (singleItem)
                        {
                            <div class="mg-qty-row">
                                <span class="mg-label m-0">SELECT QUANTITY</span>
                                <div class="mg-qty">
                                    <button type="button" id="qty-minus" aria-label="Decrease quantity">-</button>
                                    <output id="qty-value">@primary!.Quantity</output>
                                    <button type="button" id="qty-plus" aria-label="Increase quantity">+</button>
                                </div>
                            </div>
                        }

                        <dl class="mg-lines">
                            <div><dt>Price per item</dt><dd id="line-unit">@Model.FormatMoney(primary?.UnitPrice ?? 0)</dd></div>
                            <div><dt>Subtotal</dt><dd id="line-subtotal">@Model.FormatMoney(Model.Subtotal)</dd></div>
                            <div><dt>Delivery Fee</dt><dd id="line-delivery">@Model.FormatMoney(Model.DeliveryFee)</dd></div>
                        </dl>

                        <div class="mg-total">
                            <span>Total Payment</span>
                            <strong id="line-total">@Model.FormatMoney(Model.TotalAmount)</strong>
                        </div>

                        <button type="submit" id="pay-button" class="mg-pay" disabled>
                            <i class="bi bi-credit-card-2-front" id="pay-icon"></i>
                            <span id="pay-button-text">Confirm &amp; Pay</span>
                            <span id="pay-spinner" class="spinner-border spinner-border-sm" role="status"
                                  aria-label="Processing payment" hidden></span>
                        </button>

                        <div class="mg-trust">
                            <div><i class="bi bi-shield-check"></i><span>Secure Payment</span></div>
                            <div><i class="bi bi-arrow-return-left"></i><span>Easy Returns</span></div>
                            <div><i class="bi bi-patch-check"></i><span>Verified Pharmacy</span></div>
                        </div>
                    </aside>
                </div>
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    :root {
        --mg-green-900: #064e45; --mg-green-700: #0b7a6b; --mg-green-600: #0f8a7a;
        --mg-green-100: #e6f2ef; --mg-ink: #14323a; --mg-muted: #6b7f84;
        --mg-border: #dfe7e6; --mg-bg: #f1f4f3; --mg-danger: #b42323;
    }
    .mg-shell { display: flex; min-height: 100vh; background: var(--mg-bg); color: var(--mg-ink); font-size: 14px; }
    .mg-shell * { box-sizing: border-box; }
    .mg-sidebar { width: 190px; flex: none; background: linear-gradient(180deg, #066154, #04443b); color: #fff; padding: 40px 14px; }
    .mg-avatar { width: 74px; height: 74px; margin: 0 auto 10px; border-radius: 50%; background: #e3f2fb; color: #0b6a8a;
                 display: grid; place-items: center; font-size: 26px; font-weight: 500; border: 3px solid #fff; }
    .mg-username { text-align: center; font-size: 11px; font-weight: 700; padding-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,.15); }
    .mg-nav { margin-top: 20px; display: grid; gap: 6px; }
    .mg-nav a { color: #d8ece8; text-decoration: none; padding: 10px 12px; border-radius: 8px; font-size: 12px; display: flex; gap: 8px; align-items: center; }
    .mg-nav a.active, .mg-nav a:hover { background: rgba(255,255,255,.14); color: #fff; }
    .mg-main { flex: 1; min-width: 0; }
    .mg-topbar { background: #fff; padding: 18px 28px; display: flex; gap: 30px; font-size: 12px; border-bottom: 1px dashed #5aa8ff; }
    .mg-topbar a { color: #52656a; text-decoration: none; display: flex; align-items: center; gap: 6px; }
    .mg-topbar a:hover { color: var(--mg-green-700); }
    .mg-content { padding: 18px 26px 40px; max-width: 1120px; }
    .mg-steps { list-style: none; display: flex; align-items: center; gap: 10px; padding: 0; margin: 0 0 18px; font-size: 11px; font-weight: 600; color: #9aa9ad; }
    .mg-steps li { display: flex; align-items: center; gap: 6px; }
    .mg-steps .dot { width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; font-size: 10px; background: #e3e9e8; color: #7c8d91; }
    .mg-steps .done, .mg-steps .current { color: var(--mg-ink); }
    .mg-steps .done .dot { background: var(--mg-green-700); color: #fff; }
    .mg-steps .current .dot { border: 1.5px solid var(--mg-green-700); background: #fff; color: var(--mg-green-700); }
    .mg-steps .line { width: 50px; height: 1px; background: #cdd8d6; }
    .mg-grid { display: grid; grid-template-columns: minmax(0, 1fr) 395px; gap: 22px; align-items: start; }
    .mg-card { background: #fff; border-radius: 14px; box-shadow: 0 2px 10px rgba(20,50,58,.05); padding: 22px; }
    .mg-product { display: flex; gap: 20px; margin-bottom: 18px; }
    .mg-product img { width: 153px; height: 86px; object-fit: cover; border-radius: 4px; background: #eef2f1; }
    .mg-badge { display: inline-block; background: #e3e6fb; color: #3b3fa0; font-size: 9px; font-weight: 700; padding: 3px 8px; border-radius: 5px; }
    .mg-product-name { font-size: 20px; font-weight: 700; margin: 6px 0 8px; }
    .mg-meta { font-size: 11px; color: #4d6065; display: flex; align-items: center; gap: 6px; margin-top: 4px; }
    .mg-meta .bi { color: var(--mg-green-700); }
    .mg-pharmacy { display: flex; align-items: center; gap: 14px; background: #f8fafa; border: 1px solid var(--mg-border); border-radius: 10px; padding: 14px 16px; margin: 18px 0 22px; }
    .mg-pharmacy-icon { width: 36px; height: 36px; border-radius: 50%; background: #fff; display: grid; place-items: center; color: var(--mg-green-700); box-shadow: 0 1px 4px rgba(0,0,0,.08); }
    .mg-pharmacy-name { font-weight: 700; font-size: 13px; }
    .mg-verified { background: #dff6e8; color: #0b6b3a; font-size: 9px; font-weight: 700; padding: 3px 8px; border-radius: 99px; }
    .mg-h { font-size: 14px; font-weight: 700; margin: 24px 0 10px; }
    .mg-options { display: grid; gap: 12px; }
    .mg-options.two { grid-template-columns: 1fr 1fr; }
    .mg-options.three { grid-template-columns: repeat(3, 1fr); }
    .mg-option { position: relative; border: 1px solid var(--mg-border); border-radius: 9px; padding: 13px 14px; cursor: pointer; display: grid; gap: 4px; background: #fff; transition: .15s; }
    .mg-option input { position: absolute; opacity: 0; pointer-events: none; }
    .mg-option:hover { border-color: #a9c7c1; }
    .mg-option.selected { background: var(--mg-green-100); border: 1.5px solid var(--mg-green-700); }
    .mg-option:has(input:focus-visible) { outline: 2px solid var(--mg-green-600); outline-offset: 2px; }
    .mg-option-title { font-weight: 700; font-size: 12px; display: flex; align-items: center; gap: 6px; }
    .mg-option-desc { font-size: 9.5px; color: var(--mg-muted); }
    .mg-tick { position: absolute; top: 8px; right: 10px; color: var(--mg-green-700); display: none; }
    .mg-options.two .mg-option.selected .mg-tick { display: block; }
    .mg-option.center { text-align: center; justify-items: center; padding: 18px 10px; font-size: 11px; font-weight: 700; }
    .mg-option.center .bi { font-size: 16px; }
    .mg-label { display: block; font-size: 9.5px; font-weight: 700; color: #4d6065; letter-spacing: .3px; margin: 12px 0 6px; }
    .mg-input { width: 100%; border: 1px solid var(--mg-border); border-radius: 8px; padding: 12px; font-size: 11px; color: var(--mg-ink); background: #fff; resize: none; font-family: inherit; }
    .mg-input:focus { outline: 2px solid rgba(15,138,122,.35); border-color: var(--mg-green-600); }
    .mg-input.invalid { border-color: var(--mg-danger); }
    .mg-field-error { color: var(--mg-danger); font-size: 10.5px; margin-top: 4px; }
    .mg-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .mg-card-section { margin-top: 14px; }
    .mg-card-section[hidden] { display: none; }
    .mg-payment-element { border: 1px solid var(--mg-border); border-radius: 10px; padding: 16px; min-height: 70px; }
    .mg-alert { margin-top: 14px; padding: 12px 14px; border-radius: 9px; color: #8f1f1f; background: #fff0f0; border: 1px solid #f3c6c6; font-size: 12.5px; }
    .mg-summary { position: sticky; top: 16px; padding: 22px 22px 18px; }
    .mg-summary-title { font-size: 14px; font-weight: 700; margin: 0 0 18px; }
    .mg-eta { border: 1px dashed #4cc3a4; background: #effbf6; color: #0b6b55; font-size: 10px; font-weight: 600; padding: 10px 12px; border-radius: 6px; margin-bottom: 18px; }
    .mg-qty-row { display: flex; align-items: center; justify-content: space-between; padding-bottom: 16px; border-bottom: 1px solid #edf1f0; }
    .mg-qty { display: flex; align-items: center; border: 1px solid var(--mg-border); border-radius: 8px; padding: 4px; background: #f8fafa; }
    .mg-qty button { width: 26px; height: 26px; border: 1px solid var(--mg-border); border-radius: 6px; background: #fff; cursor: pointer; font-weight: 700; }
    .mg-qty button:disabled { opacity: .4; cursor: not-allowed; }
    .mg-qty output { min-width: 56px; text-align: center; font-weight: 700; }
    .mg-lines { margin: 16px 0; padding-bottom: 14px; border-bottom: 1px dashed #d4dddb; }
    .mg-lines div { display: flex; justify-content: space-between; margin: 10px 0; font-size: 11.5px; }
    .mg-lines dt { font-weight: 500; }
    .mg-lines dd { margin: 0; color: #4d6065; font-size: 10.5px; }
    .mg-total { display: flex; justify-content: space-between; align-items: center; color: var(--mg-green-700); font-size: 15px; margin-bottom: 20px; }
    .mg-total span { font-weight: 800; }
    .mg-pay { width: 100%; border: 0; border-radius: 8px; padding: 14px; color: #fff; font-weight: 700; font-size: 13px; display: flex; gap: 8px; justify-content: center; align-items: center;
              background: linear-gradient(90deg, #0b7a6b, #129a88); cursor: pointer; transition: .15s; }
    .mg-pay:hover:not(:disabled) { filter: brightness(.93); }
    .mg-pay:disabled { opacity: .6; cursor: not-allowed; }
    .mg-trust { display: flex; justify-content: space-between; margin-top: 14px; font-size: 8.5px; color: #8a9a9e; text-align: center; }
    .mg-trust div { display: grid; gap: 4px; justify-items: center; flex: 1; }
    .mg-trust .bi { font-size: 12px; color: var(--mg-green-700); }
    @@media (max-width: 991px) {
        .mg-sidebar { display: none; }
        .mg-grid { grid-template-columns: 1fr; }
        .mg-summary { position: static; }
        .mg-options.three { grid-template-columns: 1fr; }
        .mg-row { grid-template-columns: 1fr; }
    }
</style>

<script src="https://js.stripe.com/v3/"></script>
<script src="~/js/payment-checkout.js" asp-append-version="true"></script>
