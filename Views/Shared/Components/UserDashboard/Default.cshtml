@model MediGuard.Models.ViewModels.DashboardSummaryViewModel

<div class="card bg-light border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <!-- User Profile Snapshot Header -->
        <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0 fw-bold text-primary">@Model.FullName</h5>
                <span class="badge bg-secondary">@Model.RoleName</span>
            </div>
            <div class="text-muted small">
                <i class="bi bi-building"></i> Pharmacy: <strong>@Model.PharmacyName</strong>
            </div>
        </div>

        <!-- Role-Specific KPI Cards -->
        <div class="row g-2">
            @if (User.IsInRole("Manager") || Model.RoleName.Equals("Manager", StringComparison.OrdinalIgnoreCase))
            {
                <div class="col-md-3">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Today's Sales Total</small>
                        <span class="fw-bold text-success fs-5">$@Model.TodaySalesTotal.ToString("F2")</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Low Stock Count</small>
                        <span class="fw-bold text-danger fs-5">@Model.LowStockCount</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Pending Orders</small>
                        <span class="fw-bold text-warning fs-5">@Model.PendingOrders</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Active Deliverymen</small>
                        <span class="fw-bold text-info fs-5">@Model.ActiveDeliverymen</span>
                    </div>
                </div>
            }
            else if (User.IsInRole("Pharmacist") || Model.RoleName.Equals("Pharmacist", StringComparison.OrdinalIgnoreCase))
            {
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Pending Prescriptions</small>
                        <span class="fw-bold text-warning fs-5">@Model.PendingPrescriptions</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Expiring Batches (&lt;30 Days)</small>
                        <span class="fw-bold text-danger fs-5">@Model.ExpiringBatchesCount</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Out of Stock Items</small>
                        <span class="fw-bold text-dark fs-5">@Model.OutOfStockCount</span>
                    </div>
                </div>
            }
            else if (User.IsInRole("Deliveryman") || Model.RoleName.Equals("Deliveryman", StringComparison.OrdinalIgnoreCase))
            {
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Pending Deliveries</small>
                        <span class="fw-bold text-warning fs-5">@Model.PendingDeliveries</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Completed Today</small>
                        <span class="fw-bold text-success fs-5">@Model.CompletedToday</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Cancelled Deliveries</small>
                        <span class="fw-bold text-danger fs-5">@Model.CancelledDeliveries</span>
                    </div>
                </div>
            }
            else if (User.IsInRole("Cashier") || Model.RoleName.Equals("Cashier", StringComparison.OrdinalIgnoreCase))
            {
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Daily Drawer Total</small>
                        <span class="fw-bold text-success fs-5">$@Model.DailyDrawerTotal.ToString("F2")</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Active Cart Items</small>
                        <span class="fw-bold text-info fs-5">@Model.ActiveCartItems</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Pending Pickups</small>
                        <span class="fw-bold text-warning fs-5">@Model.PendingPickups</span>
                    </div>
                </div>
            }
            else
            {
                <!-- Customer Default -->
                <div class="col-md-6">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Active Orders in Transit</small>
                        <span class="fw-bold text-primary fs-5">@Model.ActiveOrdersInTransit</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-2 border rounded bg-white text-center">
                        <small class="text-muted d-block">Uploaded Prescription Status</small>
                        <span class="fw-bold text-success fs-5">@Model.UploadedPrescriptionStatus</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>-