@{
    ViewData["Title"] = "Services";
}

<div class="container py-5">
    <h2 class="fw-bold mb-4" style="color: #00796b;">MediGuard Services</h2>
    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h5 class="fw-bold mb-2">Real-Time Stock Audit</h5>
                <p class="text-muted small">Monitor medicine stock levels, batch numbers, and upcoming expirations continuously.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h5 class="fw-bold mb-2">Wholesale Procurement</h5>
                <p class="text-muted small">Bulk orders directly from accredited pharmaceutical distributors with verified compliance.</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h5 class="fw-bold mb-2">Prescription Dispatch</h5>
                <p class="text-muted small">Fast, direct fulfillment for individual patients seeking reliable prescribed medications.</p>
            </div>
        </div>
    </div>
</div>