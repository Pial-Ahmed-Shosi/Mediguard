@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm p-5 bg-white">
        <h2 class="fw-bold mb-3" style="color: #00796b;">About MediGuard</h2>
        <p class="lead text-muted">MediGuard is an integrated B2B and B2C pharmaceutical supply chain and inventory management portal designed to streamline access to genuine medical products.</p>
        <hr class="my-4" />
        <div class="row g-4">
            <div class="col-md-6">
                <h5 class="fw-bold">
                    <i class="bi bi-bullseye me-2" style="color: #00796b;"></i>Our Mission
                </h5>
                <p class="text-secondary">Ensure zero supply disruption for life-saving pharmaceuticals through secure inventory control.</p>
            </div>
            <div class="col-md-6">
                <h5 class="fw-bold">
                    <i class="bi bi-eye me-2" style="color: #00796b;"></i>Our Vision
                </h5>
                <p class="text-secondary">Connecting healthcare suppliers, pharmacies, and consumers in a unified digital ecosystem.</p>
            </div>
        </div>
    </div>
</div>