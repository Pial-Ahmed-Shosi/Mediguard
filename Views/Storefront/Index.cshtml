@model MediGuard.Models.ViewModels.StorefrontViewModel

@{
    ViewData["Title"] = "Find Medicines";
}

@section Styles {
    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
    <style>
        :root {
            --mg-teal: #007a78;
            --mg-teal-dark: #005f5d;
            --mg-teal-light: #e6f2f2;
        }

        .mg-storefront-wrapper {
            background-color: #fafbfb;
            min-height: 100vh;
        }

        .mg-subheader {
            font-size: 0.85rem;
            color: #6c757d;
        }

        .mg-search-container {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
            border: 1px solid #eaeaea;
            padding: 1.25rem 1.5rem;
        }

        .mg-input-label {
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: #556060;
            margin-bottom: 0.4rem;
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }

        .mg-input-field {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 0.55rem 0.85rem;
            font-size: 0.875rem;
            background-color: #ffffff;
            color: #212529;
            transition: all 0.2s ease;
        }

        .mg-input-field:focus {
            border-color: var(--mg-teal);
            box-shadow: 0 0 0 0.2rem rgba(0, 122, 120, 0.12);
        }

        .btn-mg-search {
            background-color: var(--mg-teal);
            color: #ffffff;
            font-weight: 600;
            border-radius: 8px;
            padding: 0.6rem 1.25rem;
            border: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            font-size: 0.875rem;
            transition: background-color 0.2s ease;
            height: 42px;
        }

        .btn-mg-search:hover {
            background-color: var(--mg-teal-dark);
            color: #ffffff;
        }

        .mg-pills-row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            overflow-x: auto;
            padding-bottom: 0.5rem;
        }

        .mg-pill-btn {
            border-radius: 50rem;
            padding: 0.4rem 1.1rem;
            font-size: 0.825rem;
            font-weight: 500;
            border: 1px solid #e0e0e0;
            color: #333333;
            background-color: #ffffff;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            white-space: nowrap;
        }

        .mg-pill-btn.active, .mg-pill-btn:hover {
            background-color: var(--mg-teal);
            color: #ffffff;
            border-color: var(--mg-teal);
        }

        .mg-pill-btn.active i, .mg-pill-btn:hover i {
            color: #ffffff;
        }

        .mg-pill-btn i {
            color: var(--mg-teal);
        }
    </style>
}

<div class="mg-storefront-wrapper py-4">
    <div class="container-fluid px-lg-5">

        <!-- Header Context Line & Item Count -->
        <div class="d-flex justify-content-between align-items-center mb-3 mg-subheader">
            <span>Compare prices across verified pharmacies near you.</span>
            <span class="fw-semibold text-dark" id="productCountBadge">
                @Model.TotalProducts @(Model.TotalProducts == 1 ? "item" : "items") found
            </span>
        </div>

        <!-- 3 Search Options Panel (Medicine Name, Pharmacy Name, Pharmacy Location) -->
        <div class="mg-search-container mb-4">
            <form id="storefrontSearchForm" method="get" asp-action="Index">
                <div class="row g-3 align-items-end">

                    <!-- Search Bar 1: Medicine Name (Brand or Generic chemical name) -->
                    <div class="col-12 col-md-4">
                        <label for="search" class="mg-input-label">
                            <i class="bi bi-capsule text-teal"></i> 1. Medicine Name
                        </label>
                        <input id="search"
                               name="search"
                               value="@Model.SearchTerm"
                               class="form-control mg-input-field"
                               placeholder="e.g. Napa, Paracetamol, Amoxicillin..."
                               maxlength="200" />
                    </div>

                    <!-- Search Bar 2: Pharmacy Name (Branch) -->
                    <div class="col-12 col-md-3">
                        <label for="pharmacy" class="mg-input-label">
                            <i class="bi bi-hospital text-teal"></i> 2. Pharmacy Branch
                        </label>
                        <input id="pharmacy"
                               name="pharmacy"
                               value="@Model.PharmacyTerm"
                               list="pharmacySuggestions"
                               class="form-control mg-input-field"
                               placeholder="e.g. Lazz Pharma, Central Hub..."
                               maxlength="100" />
                        <datalist id="pharmacySuggestions">
                            @foreach (var p in Model.Pharmacies)
                            {
                                <option value="@p"></option>
                            }
                        </datalist>
                    </div>

                    <!-- Search Bar 3: Pharmacy Location (District, Area, or City) -->
                    <div class="col-12 col-md-3">
                        <label for="location" class="mg-input-label">
                            <i class="bi bi-geo-alt text-teal"></i> 3. Pharmacy Location
                        </label>
                        <input id="location"
                               name="location"
                               value="@Model.LocationTerm"
                               list="locationSuggestions"
                               class="form-control mg-input-field"
                               placeholder="e.g. Dhanmondi, Gulshan, Mirpur..."
                               maxlength="100" />
                        <datalist id="locationSuggestions">
                            @foreach (var loc in Model.Locations)
                            {
                                <option value="@loc"></option>
                            }
                        </datalist>
                    </div>

                    <!-- Action Button -->
                    <div class="col-12 col-md-2">
                        <button type="submit" id="btnFilter" class="btn btn-mg-search w-100">
                            <i class="bi bi-search"></i> Search Stock
                        </button>
                    </div>

                </div>
            </form>
        </div>

        <!-- Category Navigational Pills -->
        <div class="mg-pills-row mb-4" id="categoryPillContainer">
            <button class="btn mg-pill-btn @(string.IsNullOrEmpty(Model.SelectedCategory) || Model.SelectedCategory == "All" ? "active" : "")" data-category="All">
                <i class="bi bi-grid-fill"></i> All
            </button>
            @if (Model.Categories != null && Model.Categories.Any())
            {
                foreach (var item in Model.Categories)
                {
                    <button class="btn mg-pill-btn @(Model.SelectedCategory == item ? "active" : "")" data-category="@item">
                        <i class="bi bi-capsule"></i> @item
                    </button>
                }
            }
            else
            {
                <button class="btn mg-pill-btn" data-category="Tablets & Capsules">
                    <i class="bi bi-capsule"></i> Tablets & Capsules
                </button>
                <button class="btn mg-pill-btn" data-category="Syrups & Liquids">
                    <i class="bi bi-droplet"></i> Syrups & Liquids
                </button>
                <button class="btn mg-pill-btn" data-category="Injections">
                    <i class="bi bi-eyedropper"></i> Injections
                </button>
                <button class="btn mg-pill-btn" data-category="Devices">
                    <i class="bi bi-cpu"></i> Devices
                </button>
                <button class="btn mg-pill-btn" data-category="IV Fluids">
                    <i class="bi bi-moisture"></i> IV Fluids
                </button>
                <button class="btn mg-pill-btn" data-category="Bandages">
                    <i class="bi bi-bandaid"></i> Bandages
                </button>
            }
        </div>

        <!-- 4-Column Product Grid -->
        <div class="row g-3 g-md-4" id="productGrid">
            @if (Model.Products != null && Model.Products.Any())
            {
                foreach (var product in Model.Products)
                {
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3 product-item-col"
                         data-brand="@(product.BrandName?.ToLower() ?? "")"
                         data-generic="@(product.GenericName?.ToLower() ?? "")"
                         data-category="@(product.Category?.Name ?? "")"
                         data-pharmacy="@(product.Pharmacy?.Name?.ToLower() ?? "")"
                         data-location="@(product.Pharmacy?.City?.ToLower() ?? "") @(product.Pharmacy?.Address?.ToLower() ?? "")">
                        @await Html.PartialAsync("_ProductCard", product)
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5" id="emptyState">
                    <i class="bi bi-search fs-1 text-muted"></i>
                    <h5 class="mt-3 text-secondary">No products available</h5>
                    <p class="text-muted small">There are currently no products matching your multi-bar search criteria.</p>
                </div>
            }
        </div>

        <!-- Client-Side No Search Results Fallback -->
        <div id="noResultsMessage" class="text-center py-5 d-none">
            <i class="bi bi-search fs-1 text-muted"></i>
            <h5 class="mt-3 text-secondary">No matching products found</h5>
            <p class="text-muted small">Try refining your search terms or selecting a different category filter.</p>
        </div>

    </div>
</div>

<!-- Floating Bottom Cart Bar -->
<div id="mg-floating-cart-bar" class="position-fixed bottom-0 start-50 translate-middle-x mb-4 p-3 rounded-4 shadow-lg border d-none"
     style="z-index: 1080; background: rgba(11, 37, 69, 0.95); backdrop-filter: blur(10px); color: #fff; min-width: 320px; max-width: 90vw;">
    <div class="d-flex align-items-center justify-content-between gap-4">
        <div class="d-flex align-items-center gap-3">
            <span class="badge bg-teal p-2 rounded-circle fs-6" style="background-color: var(--mg-teal);">
                <i class="bi bi-cart3"></i>
            </span>
            <div>
                <span class="fw-bold d-block text-white" id="floatingCartCount">0 items in cart</span>
                <small class="text-light opacity-75" id="floatingCartTotal">Total: ৳0.00</small>
            </div>
        </div>
        <button type="button" id="btnFloatingCheckout" class="btn btn-light fw-bold rounded-pill px-4 py-2 d-flex align-items-center gap-2 text-primary shadow-sm">
            <span>Checkout</span> <i class="bi bi-arrow-right"></i>
        </button>
    </div>
</div>

@section Scripts {
    <script src="~/js/storefront.js" asp-append-version="true"></script>
}