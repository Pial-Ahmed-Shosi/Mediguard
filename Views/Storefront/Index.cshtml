@model MediGuard.Models.ViewModels.StorefrontViewModel

@{
    ViewData["Title"] = "Find Medicines";
}

@section Styles {
    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
    <style>
        :root {
            --mg-teal: #007a78;
            --mg-teal-hover: #005f5d;
            --mg-teal-light: #e6f2f2;
        }

        .mg-storefront-hero {
            background: linear-gradient(135deg, #f8fbfb 0%, #edf6f6 100%);
            border-radius: 16px;
            padding: 1.5rem 2rem;
            margin-bottom: 1.5rem;
            border: 1px solid #e0f0f0;
        }

        .mg-search-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 122, 120, 0.06);
            border: 1px solid #e6f0f0;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .mg-search-label {
            font-size: 0.725rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: #557070;
            margin-bottom: 0.35rem;
        }

        .mg-search-input {
            border: 1px solid #d5e5e5;
            border-radius: 8px;
            padding: 0.6rem 0.9rem;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }

            .mg-search-input:focus {
                border-color: var(--mg-teal);
                box-shadow: 0 0 0 0.2rem rgba(0, 122, 120, 0.15);
            }

        .btn-mg-teal {
            background-color: var(--mg-teal);
            color: #ffffff;
            font-weight: 600;
            border-radius: 8px;
            padding: 0.65rem 1.2rem;
            border: none;
            transition: background-color 0.2s ease;
        }

            .btn-mg-teal:hover {
                background-color: var(--mg-teal-hover);
                color: #ffffff;
            }

        .mg-pill-btn {
            border-radius: 50rem;
            padding: 0.45rem 1.1rem;
            font-size: 0.85rem;
            font-weight: 500;
            border: 1px solid #d0e2e2;
            color: #005f5d;
            background-color: #ffffff;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            white-space: nowrap;
        }

            .mg-pill-btn:hover, .mg-pill-btn.active {
                background-color: var(--mg-teal);
                color: #ffffff;
                border-color: var(--mg-teal);
            }
    </style>
}

<div class="mg-storefront">
    <div class="container py-4">

        <!-- Top Hero Context Header -->
        <div class="mg-storefront-hero d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="mg-eyebrow text-uppercase fw-bold text-success small">
                    <i class="bi bi-shield-check me-1"></i> Verified MediGuard Pharmacy Marketplace
                </span>
                <h1 class="h2 fw-bold mb-1 text-dark">Find Medicines &amp; Healthcare Items</h1>
                <p class="text-muted mb-0 small">Compare prices and availability across verified pharmacies near you.</p>
            </div>

            <div class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-sm fs-6 align-self-start align-self-md-center" id="productCountBadge">
                <i class="bi bi-box-seam me-1 text-teal"></i>
                @Model.TotalProducts @(Model.TotalProducts == 1 ? "item" : "items") found
            </div>
        </div>

        <!-- 3 Search Options Form Panel -->
        <div class="mg-search-card">
            <form asp-controller="Storefront"
                  asp-action="Index"
                  method="get"
                  id="storefrontSearchForm">

                <div class="row g-3 align-items-end">
                    <!-- Search Field 1: Medicine / Item Name -->
                    <div class="col-12 col-md-4">
                        <label for="search" class="mg-search-label form-label d-block">
                            <i class="bi bi-capsule me-1 text-teal"></i> Medicine / Item Name
                        </label>
                        <input id="search"
                               name="search"
                               value="@Model.SearchTerm"
                               class="form-control mg-search-input"
                               placeholder="e.g. Clindamycin, Napa, Syringe..."
                               maxlength="200" />
                    </div>

                    <!-- Search Field 2: Location / Area -->
                    <div class="col-12 col-md-3">
                        <label for="location" class="mg-search-label form-label d-block">
                            <i class="bi bi-geo-alt me-1 text-teal"></i> Location / Area
                        </label>
                        <input id="location"
                               name="location"
                               class="form-control mg-search-input"
                               placeholder="e.g. Dhanmondi, Gulshan..."
                               maxlength="100" />
                    </div>

                    <!-- Search Field 3: Pharmacy / Hospital -->
                    <div class="col-12 col-md-3">
                        <label for="pharmacy" class="mg-search-label form-label d-block">
                            <i class="bi bi-hospital me-1 text-teal"></i> Pharmacy / Hospital
                        </label>
                        <input id="pharmacy"
                               name="pharmacy"
                               class="form-control mg-search-input"
                               placeholder="e.g. Lazz Pharma, Square..."
                               maxlength="100" />
                    </div>

                    <!-- Submit & Reset Action Buttons -->
                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="submit" id="btnFilter" class="btn btn-mg-teal w-100">
                            <i class="bi bi-search me-1"></i> Find Items
                        </button>
                        <a asp-controller="Storefront"
                           asp-action="Index"
                           class="btn btn-outline-secondary d-flex align-items-center justify-content-center px-3"
                           title="Reset Search">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>

        <!-- Quick Filter Category Pills -->
        <div class="d-flex align-items-center gap-2 overflow-auto pb-3 mb-4" id="categoryPillContainer">
            <a asp-controller="Storefront"
               asp-action="Index"
               asp-route-search="@Model.SearchTerm"
               data-category="All"
               class="mg-pill-btn @(string.IsNullOrEmpty(Model.SelectedCategory) || Model.SelectedCategory == "All" ? "active" : "")">
                <i class="bi bi-grid-fill"></i> All Items
            </a>

            @if (Model.Categories != null && Model.Categories.Any())
            {
                foreach (var item in Model.Categories)
                {
                    var isActive = string.Equals(Model.SelectedCategory, item, StringComparison.OrdinalIgnoreCase);
                    <a asp-controller="Storefront"
                       asp-action="Index"
                       asp-route-search="@Model.SearchTerm"
                       asp-route-category="@item"
                       data-category="@item"
                       class="mg-pill-btn @(isActive ? "active" : "")">
                        <i class="bi bi-capsule"></i> @item
                    </a>
                }
            }
        </div>

        <!-- Main Product Catalog Layout -->
        <div class="mg-catalog-layout">
            <section class="mg-product-section w-100" aria-label="Medicine products">

                @if (!Model.Products.Any())
                {
                    <div class="mg-empty-state text-center py-5 bg-light rounded-4 my-3" id="emptyState">
                        <i class="bi bi-search fs-1 text-muted"></i>
                        <h3 class="mt-3 text-secondary">No products found</h3>
                        <p class="text-muted small">No active products match your search terms or category selection.</p>
                        <a asp-controller="Storefront"
                           asp-action="Index"
                           class="btn btn-mg-teal mt-2">
                            Show All Products
                        </a>
                    </div>
                }
                else
                {
                    <div class="mg-product-grid row g-3 g-md-4" id="productGrid">
                        @foreach (var product in Model.Products)
                        {
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 product-item-col"
                                 data-brand="@(product.BrandName?.ToLower() ?? "")"
                                 data-generic="@(product.GenericName?.ToLower() ?? "")"
                                 data-category="@(product.Category?.Name ?? "")"
                                 data-location=""
                                 data-pharmacy="">
                                <partial name="_ProductCard" model="product" />
                            </div>
                        }
                    </div>

                    <!-- Client-Side No Results Fallback Message -->
                    <div id="noResultsMessage" class="text-center py-5 bg-light rounded-4 my-3 d-none">
                        <i class="bi bi-search fs-1 text-muted"></i>
                        <h4 class="mt-3 text-secondary">No matching products found</h4>
                        <p class="text-muted small">Try refining your search name, location, pharmacy, or selected category.</p>
                    </div>
                }
            </section>
        </div>

    </div>
</div>

<!-- Prescription Requirement Alert Notification Container -->
<div id="mg-cart-notice"
     class="mg-cart-notice position-fixed bottom-0 end-0 p-3"
     style="z-index: 1090;"
     role="status"
     aria-live="polite"
     hidden>
    <div class="toast align-items-center text-white bg-dark border-0 shadow-lg show" role="alert">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-5 flex-shrink-0"></i>
                <span id="mg-cart-notice-text" class="small fw-normal"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" id="mg-cart-notice-close" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/storefront.js" asp-append-version="true"></script>
}