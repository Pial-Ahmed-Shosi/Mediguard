@model MediGuard.Models.ViewModels.StorefrontViewModel

@{
    ViewData["Title"] = "Storefront Catalog";
}

@section Styles {
    <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
    <style>
        :root {
            --mg-teal: #0d7a6f;
            --mg-teal-dark: #0a645b;
            --mg-teal-light: #e3f2f0;
            --mg-text: #1f2937;
            --mg-muted: #6b7280;
        }

        .mg-storefront-wrapper {
            background-color: #f4f5f5;
            min-height: 100vh;
        }

        /* ---------- Sub header ---------- */
        .mg-subheader {
            font-size: 0.72rem;
            color: var(--mg-muted);
        }

        .mg-subheader .mg-count {
            font-weight: 500;
            color: var(--mg-text);
        }

        /* ---------- Search panel ---------- */
        .mg-search-container {
            background: #ffffff;
            border-radius: 12px;
            border: 1px solid #ececec;
            box-shadow: 0 1px 6px rgba(0, 0, 0, 0.05);
            padding: 1rem 1.25rem 1.1rem;
        }

        .mg-input-label {
            font-size: 0.6rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            color: #4b5563;
            margin-bottom: 0.35rem;
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .mg-input-label i {
            font-size: 0.7rem;
            color: #4b5563;
        }

        .mg-input-field {
            border: 1px solid #e3e5e8;
            border-radius: 7px;
            padding: 0.5rem 0.75rem;
            font-size: 0.72rem;
            background-color: #ffffff;
            color: #212529;
            height: 38px;
        }

        .mg-input-field::placeholder {
            color: #9ca3af;
        }

        .mg-input-field:focus {
            border-color: var(--mg-teal);
            box-shadow: 0 0 0 0.18rem rgba(13, 122, 111, 0.12);
        }

        .btn-mg-search {
            background-color: var(--mg-teal);
            color: #ffffff;
            font-weight: 600;
            border-radius: 7px;
            border: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            font-size: 0.75rem;
            height: 38px;
            transition: background-color 0.2s ease;
        }

        .btn-mg-search:hover {
            background-color: var(--mg-teal-dark);
            color: #ffffff;
        }

        /* ---------- Category pills ---------- */
        .mg-pills-row {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            overflow-x: auto;
            padding-bottom: 0.25rem;
        }

        .mg-pill-btn {
            border-radius: 50rem;
            padding: 0.22rem 0.7rem;
            font-size: 0.66rem;
            font-weight: 500;
            border: 1px solid #e3e5e8;
            color: #374151;
            background-color: #ffffff;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            white-space: nowrap;
            line-height: 1.5;
            transition: all 0.15s ease;
        }

        .mg-pill-btn i {
            font-size: 0.68rem;
            color: #4b5563;
        }

        .mg-pill-btn.active,
        .mg-pill-btn:hover,
        .mg-pill-btn:focus-visible {
            background-color: var(--mg-teal);
            border-color: var(--mg-teal);
            color: #ffffff;
        }

        .mg-pill-btn.active i,
        .mg-pill-btn:hover i {
            color: #ffffff;
        }

        /* ---------- Product card ---------- */
        .mg-card {
            background: #ffffff;
            border: 1px solid #ececec;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
            transition: transform 0.18s ease, box-shadow 0.18s ease;
        }

        .mg-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
        }

        .mg-card-media {
            position: relative;
            height: 132px;
            background: #f6f7f7;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem 1rem 0.6rem;
        }

        .mg-card-media img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .mg-card-media .mg-placeholder {
            font-size: 2.5rem;
            color: #cbd5d1;
        }

        /* stock badge (top-left) */
        .mg-stock {
            position: absolute;
            top: 8px;
            left: 8px;
            font-size: 0.55rem;
            font-weight: 600;
            padding: 0.2rem 0.45rem;
            border-radius: 4px;
            line-height: 1.2;
        }

        .mg-stock.in { background: #dff5e5; color: #1f8a43; }
        .mg-stock.limited { background: #fdf0c8; color: #a8730a; }
        .mg-stock.out { background: #fde3e3; color: #c0262d; }

        /* rating (top-right) */
        .mg-rating {
            position: absolute;
            top: 8px;
            right: 8px;
            background: #ffffff;
            border-radius: 4px;
            font-size: 0.58rem;
            font-weight: 700;
            color: #374151;
            padding: 0.15rem 0.4rem;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
            line-height: 1.2;
        }

        .mg-rating i {
            color: #f59e0b;
            font-size: 0.55rem;
            margin-right: 1px;
        }

        .mg-card-body {
            padding: 0.8rem 0.9rem 0.85rem;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .mg-badge-row {
            display: flex;
            flex-wrap: wrap;
            gap: 0.3rem;
            margin-bottom: 0.55rem;
        }

        .mg-form-badge {
            font-size: 0.58rem;
            font-weight: 600;
            padding: 0.18rem 0.45rem;
            border-radius: 4px;
            border: 1px solid transparent;
            line-height: 1.3;
            white-space: nowrap;
        }

        .mg-form-indigo { background: #eceafd; color: #4f46e5; border-color: #dcd8fb; }
        .mg-form-green  { background: #e3f5ea; color: #1f8a43; border-color: #cdeedb; }
        .mg-form-red    { background: #fde8e8; color: #d03a3a; border-color: #f9d3d3; }
        .mg-form-blue   { background: #e3f0fb; color: #1d6fb8; border-color: #cfe3f6; }
        .mg-form-purple { background: #f1e6fb; color: #8e3bc4; border-color: #e5d2f6; }
        .mg-form-orange { background: #fdeede; color: #c4600c; border-color: #f9dfc3; }

        .mg-rx-badge {
            font-size: 0.55rem;
            font-weight: 700;
            padding: 0.2rem 0.45rem;
            border-radius: 4px;
            background: #dc3545;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: 0.02em;
            line-height: 1.3;
            white-space: nowrap;
        }

        .mg-card-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: #111827;
            margin: 0 0 0.35rem;
        }

        .mg-meta {
            display: flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.64rem;
            color: #6b7280;
            margin-bottom: 0.18rem;
            min-width: 0;
        }

        .mg-meta i { font-size: 0.68rem; flex-shrink: 0; }
        .mg-meta .ic-gray  { color: #8b949e; }
        .mg-meta .ic-green { color: #2e9a5b; }
        .mg-meta .ic-blue  { color: #3b82c4; }

        .mg-card-footer-row {
            margin-top: auto;
            padding-top: 0.7rem;
            border-top: 1px solid #f1f1f1;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .mg-price {
            font-size: 0.85rem;
            font-weight: 700;
            color: #111827;
        }

        .mg-price small {
            font-size: 0.6rem;
            font-weight: 400;
            color: #8b949e;
            margin-left: 1px;
        }

        .mg-cart-btn {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            background-color: var(--mg-teal-light);
            color: var(--mg-teal);
            border: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            transition: all 0.15s ease;
        }

        .mg-cart-btn:hover:not(:disabled) {
            background-color: var(--mg-teal);
            color: #ffffff;
        }

        .mg-cart-btn:disabled {
            background-color: #f1f3f4;
            color: #c4c9cd;
            cursor: not-allowed;
        }
    </style>
}

<div class="mg-storefront-wrapper py-3">
    <div class="container-fluid px-3 px-lg-4">

        <!-- Context line & item count -->
        <div class="d-flex justify-content-between align-items-center mb-2 mg-subheader">
            <span>Compare prices across verified pharmacies near you.</span>
            <span class="mg-count" id="productCountBadge">
                @Model.TotalProducts @(Model.TotalProducts == 1 ? "item" : "items") found
            </span>
        </div>

        <!-- Search panel -->
        <div class="mg-search-container mb-3">
            <form id="storefrontSearchForm" onsubmit="return false;">
                <div class="row g-3 align-items-end">

                    <div class="col-12 col-md-4">
                        <label for="search" class="mg-input-label">
                            <i class="bi bi-capsule"></i> Medicine / Item Name
                        </label>
                        <input id="search" name="search" value="@Model.SearchTerm"
                               class="form-control mg-input-field"
                               placeholder="e.g. Clindacin, Napa, Syringe..."
                               maxlength="200" autocomplete="off" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label for="location" class="mg-input-label">
                            <i class="bi bi-geo-alt"></i> Location / Area
                        </label>
                        <input id="location" name="location"
                               class="form-control mg-input-field"
                               placeholder="e.g. Dhanmondi, Gulshan..."
                               maxlength="100" autocomplete="off" />
                    </div>

                    <div class="col-12 col-md-3">
                        <label for="pharmacy" class="mg-input-label">
                            <i class="bi bi-hospital"></i> Pharmacy / Hospital
                        </label>
                        <input id="pharmacy" name="pharmacy"
                               class="form-control mg-input-field"
                               placeholder="e.g. Lazz Pharma, Square Hospital..."
                               maxlength="100" autocomplete="off" />
                    </div>

                    <div class="col-12 col-md-2">
                        <button type="button" id="btnFilter" class="btn btn-mg-search w-100">
                            <i class="bi bi-search"></i> Find Items
                        </button>
                    </div>

                </div>
            </form>
        </div>

        <!-- Category pills -->
        <div class="mg-pills-row mb-3" id="categoryPillContainer">
            <button type="button" class="btn mg-pill-btn active" data-category="All">
                <i class="bi bi-grid-fill"></i> All
            </button>
            <button type="button" class="btn mg-pill-btn" data-category="Tablets &amp; Capsules">
                <i class="bi bi-capsule-pill"></i> Tablets &amp; Capsules
            </button>
            <button type="button" class="btn mg-pill-btn" data-category="Syrups &amp; Liquids">
                <i class="bi bi-droplet"></i> Syrups &amp; Liquids
            </button>
            <button type="button" class="btn mg-pill-btn" data-category="Injections">
                <i class="bi bi-eyedropper"></i> Injections
            </button>
            <button type="button" class="btn mg-pill-btn" data-category="Devices">
                <i class="bi bi-gear"></i> Devices
            </button>
            <button type="button" class="btn mg-pill-btn" data-category="IV Fluids">
                <i class="bi bi-moisture"></i> IV Fluids
            </button>
            <button type="button" class="btn mg-pill-btn" data-category="Bandages">
                <i class="bi bi-bandaid"></i> Bandages
            </button>
        </div>

        <!-- 4-column responsive product grid -->
        <div class="row g-3" id="productGrid">
            @if (Model.Products != null && Model.Products.Any())
            {
                foreach (var product in Model.Products)
                {
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3 product-item-col"
                         data-brand="@(product.BrandName?.ToLowerInvariant() ?? "")"
                         data-generic="@(product.GenericName?.ToLowerInvariant() ?? "")"
                         data-category="@(product.Category?.Name ?? "")"
                         data-location="@(product.PharmacyArea?.ToLowerInvariant() ?? "")"
                         data-pharmacy="@(product.PharmacyName?.ToLowerInvariant() ?? "")">
                        @await Html.PartialAsync("_ProductCard", product)
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5" id="emptyState">
                    <i class="bi bi-search fs-1 text-muted"></i>
                    <h5 class="mt-3 text-secondary">No products available</h5>
                    <p class="text-muted small">There are currently no products matching the storefront criteria.</p>
                </div>
            }
        </div>

        <!-- Client-side no-results fallback -->
        <div id="noResultsMessage" class="text-center py-5 d-none">
            <i class="bi bi-search fs-1 text-muted"></i>
            <h5 class="mt-3 text-secondary">No matching products found</h5>
            <p class="text-muted small">Try refining your search terms or selecting a different category.</p>
        </div>

    </div>
</div>

<!-- Cart / prescription notification -->
<div id="mg-cart-notice"
     class="mg-cart-notice position-fixed bottom-0 end-0 p-3"
     style="z-index: 1090;"
     role="status"
     aria-live="polite"
     hidden>
    <div class="toast align-items-center text-white bg-dark border-0 shadow-lg show" role="alert">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-5 flex-shrink-0"></i>
                <span id="mg-cart-notice-text" class="small fw-normal"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" id="mg-cart-notice-close" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/storefront.js" asp-append-version="true"></script>
}
