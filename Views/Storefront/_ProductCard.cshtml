@model MediGuard.Models.StorefrontProduct

@{
    const int LimitedStockThreshold = 10;

    var inStock = Model.StockQuantity > 0;
    var limited = inStock && Model.StockQuantity <= LimitedStockThreshold;

    var stockClass = !inStock ? "out" : (limited ? "limited" : "in");
    var stockLabel = !inStock ? "Out of Stock" : (limited ? "Limited Stock" : "In Stock");

    // Form | Strength badge (e.g. "Capsule | 300 mg")
    var form = string.IsNullOrWhiteSpace(Model.DosageForm)
        ? (Model.Category?.Name ?? "Medicine")
        : Model.DosageForm;
    var formText = string.IsNullOrWhiteSpace(Model.Strength) ? form : $"{form} | {Model.Strength}";

    var formClass = (form ?? "").Trim().ToLowerInvariant() switch
    {
        "capsule" or "tablet"                 => "mg-form-indigo",
        "syrup" or "liquid" or "suspension"   => "mg-form-green",
        "injection"                           => "mg-form-red",
        "iv fluid" or "iv"                    => "mg-form-blue",
        "device"                              => "mg-form-purple",
        "bandage"                             => "mg-form-orange",
        _                                     => "mg-form-indigo"
    };

    var unitLabel = string.IsNullOrWhiteSpace(Model.UnitLabel) ? "unit" : Model.UnitLabel;
    var rating = Model.Rating;
}

<article class="mg-card h-100 d-flex flex-column">

    <!-- Image area with overlay badges -->
    <div class="mg-card-media">
        <span class="mg-stock @stockClass">@stockLabel</span>

        @if (rating.HasValue)
        {
            <span class="mg-rating">
                <i class="bi bi-star-fill"></i>@rating.Value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)
            </span>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.BrandName" loading="lazy" />
        }
        else
        {
            <i class="bi bi-capsule-pill mg-placeholder" aria-hidden="true"></i>
        }
    </div>

    <!-- Body -->
    <div class="mg-card-body">

        <div class="mg-badge-row">
            <span class="mg-form-badge @formClass">@formText</span>

            @if (Model.RequiresPrescription)
            {
                <span class="mg-rx-badge" title="Prescription required at checkout">Prescription Required</span>
            }
        </div>

        <h6 class="mg-card-title text-truncate" title="@Model.BrandName">@Model.BrandName</h6>

        <div class="mg-meta" title="@Model.GenericName">
            <i class="bi bi-building ic-gray"></i>
            <span class="text-truncate">@(string.IsNullOrWhiteSpace(Model.Manufacturer) ? Model.GenericName : Model.Manufacturer)</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.GenericName) && !string.IsNullOrWhiteSpace(Model.Manufacturer))
        {
            <div class="mg-meta" title="Generic: @Model.GenericName">
                <i class="bi bi-capsule ic-gray"></i>
                <span class="text-truncate">@Model.GenericName</span>
            </div>
        }

        <div class="mg-meta">
            <i class="bi bi-shield-check ic-green"></i>
            <span class="text-truncate">@(string.IsNullOrWhiteSpace(Model.PackagingType) ? "Sealed Packaging" : Model.PackagingType)</span>
        </div>

        <div class="mg-meta">
            <i class="bi bi-shop ic-blue"></i>
            <span class="text-truncate">
                @(string.IsNullOrWhiteSpace(Model.PharmacyName)
                    ? "Partner Pharmacy"
                    : (string.IsNullOrWhiteSpace(Model.PharmacyArea)
                        ? Model.PharmacyName
                        : $"{Model.PharmacyName}, {Model.PharmacyArea}"))
            </span>
        </div>

        <!-- Price + cart -->
        <div class="mg-card-footer-row mt-3">
            <div class="mg-price">
                ৳ @Model.UnitPrice.ToString("N2")<small>/@unitLabel</small>
            </div>

            <button type="button"
                    class="mg-cart-btn mg-add-to-cart"
                    data-product-id="@Model.Id"
                    data-brand-name="@Model.BrandName"
                    data-unit-price="@Model.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                    data-stock="@Model.StockQuantity"
                    data-requires-prescription="@Model.RequiresPrescription.ToString().ToLowerInvariant()"
                    disabled="@(Model.StockQuantity <= 0 ? "disabled" : null)"
                    aria-label="Add @Model.BrandName to cart"
                    title="Add to Cart">
                <i class="bi bi-bag-plus"></i>
            </button>
        </div>

    </div>
</article>
