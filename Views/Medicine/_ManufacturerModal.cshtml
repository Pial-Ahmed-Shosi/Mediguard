@model MediGuard.Models.ViewModels.QuickCreateCategoryDto

<style>
    #categoryModal {
        --mg-teal: #0d9488;
        --mg-teal-dark: #0f766e;
        --mg-teal-soft: #e6f6f4;
        --mg-ink: #12302d;
        --mg-muted: #6b7f7c;
    }

    #categoryModal .modal-content {
        border: 0;
        border-radius: 1.25rem;
        overflow: hidden;
        box-shadow: 0 24px 60px -12px rgba(13, 148, 136, .35), 0 8px 20px rgba(0, 0, 0, .08);
    }

    /* Header */
    #categoryModal .mg-header {
        position: relative;
        padding: 1.5rem 1.5rem 1.25rem;
        background: linear-gradient(135deg, var(--mg-teal-dark), var(--mg-teal) 60%, #14b8a6);
        color: #fff;
    }

    #categoryModal .mg-header::after {
        content: "";
        position: absolute;
        right: -40px;
        top: -40px;
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: rgba(255, 255, 255, .12);
        pointer-events: none;
    }

    #categoryModal .mg-icon-tile {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: grid;
        place-items: center;
        font-size: 1.4rem;
        border-radius: .9rem;
        background: rgba(255, 255, 255, .2);
        backdrop-filter: blur(4px);
    }

    #categoryModal .modal-title { font-weight: 700; letter-spacing: -.01em; }
    #categoryModal .mg-subtitle { font-size: .85rem; opacity: .85; margin: 0; }

    /* Form controls */
    #categoryModal .modal-body { padding: 1.5rem; background: #fff; }

    #categoryModal .form-label { color: var(--mg-ink); font-size: .9rem; }

    #categoryModal .input-group-text {
        background: var(--mg-teal-soft);
        color: var(--mg-teal-dark);
        border: 1.5px solid #d5e7e4;
        border-right: 0;
        border-radius: .75rem 0 0 .75rem;
    }

    #categoryModal .form-control {
        border: 1.5px solid #d5e7e4;
        border-radius: .75rem;
        padding: .65rem .9rem;
        transition: border-color .15s, box-shadow .15s;
    }

    #categoryModal .input-group .form-control { border-radius: 0 .75rem .75rem 0; }

    #categoryModal .form-control:focus {
        border-color: var(--mg-teal);
        box-shadow: 0 0 0 .25rem rgba(13, 148, 136, .15);
    }

    #categoryModal .input-group:focus-within .input-group-text { border-color: var(--mg-teal); }

    #categoryModal textarea.form-control { resize: none; }

    #categoryModal .mg-counter { font-size: .75rem; color: var(--mg-muted); }

    /* Suggestion chips */
    #categoryModal .mg-chip {
        border: 1.5px solid #d5e7e4;
        background: #fff;
        color: var(--mg-teal-dark);
        border-radius: 999px;
        padding: .2rem .75rem;
        font-size: .8rem;
        font-weight: 500;
        transition: background .15s, border-color .15s, transform .1s;
    }

    #categoryModal .mg-chip:hover { background: var(--mg-teal-soft); border-color: var(--mg-teal); }
    #categoryModal .mg-chip:active { transform: scale(.96); }

    /* Footer + buttons */
    #categoryModal .modal-footer { padding: 1rem 1.5rem 1.5rem; background: #fff; }

    #categoryModal .btn-teal-solid {
        background: linear-gradient(135deg, var(--mg-teal-dark), var(--mg-teal));
        border: 0;
        color: #fff;
        font-weight: 600;
        box-shadow: 0 6px 16px -4px rgba(13, 148, 136, .55);
        transition: transform .15s, box-shadow .15s, filter .15s;
    }

    #categoryModal .btn-teal-solid:hover:not(:disabled) {
        transform: translateY(-1px);
        filter: brightness(1.06);
        box-shadow: 0 10px 20px -6px rgba(13, 148, 136, .6);
    }

    #categoryModal .btn-teal-solid:disabled { opacity: .75; }

    #categoryModal .btn-outline-secondary { border-width: 1.5px; font-weight: 500; }

    #categoryModal .btn-close-white { filter: invert(1) grayscale(100%) brightness(200%); }

    /* Error box */
    #categoryModal #categoryModalError {
        border: 0;
        border-left: 4px solid #dc3545;
        border-radius: .6rem;
        background: #fdecee;
        color: #a52834;
    }

    /* Entrance only when the modal opens */
    #categoryModal.modal.fade .modal-dialog { transform: translateY(24px) scale(.97); }
    #categoryModal.modal.show .modal-dialog { transform: none; }

    @@media (prefers-reduced-motion: reduce) {
        #categoryModal *, #categoryModal.modal.fade .modal-dialog { transition: none !important; }
    }
</style>

<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <!-- Header -->
            <div class="mg-header d-flex align-items-center gap-3">
                <div class="mg-icon-tile"><i class="bi bi-folder-plus"></i></div>
                <div class="flex-grow-1" style="position:relative; z-index:1;">
                    <h5 class="modal-title" id="categoryModalLabel">Add new category</h5>
                    <p class="mg-subtitle">Group medicines so they're easy to find.</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="position:relative; z-index:1;"></button>
            </div>

            <form id="quickCategoryForm" novalidate>
                <div class="modal-body">
                    <!-- Validation Error Box -->
                    <div id="categoryModalError" class="alert d-none py-2 px-3 small" role="alert"></div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-end mb-1">
                            <label for="categoryModalName" class="form-label fw-semibold mb-0">Category name <span class="text-danger">*</span></label>
                            <span class="mg-counter" id="categoryNameCount">0/100</span>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-tag"></i></span>
                            <input type="text" class="form-control" id="categoryModalName" name="Name" required maxlength="100" placeholder="e.g., Antibiotics" autocomplete="off" />
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2" aria-label="Suggested categories">
                            <button type="button" class="mg-chip" data-suggest="Antibiotics">Antibiotics</button>
                            <button type="button" class="mg-chip" data-suggest="Pain relief">Pain relief</button>
                            <button type="button" class="mg-chip" data-suggest="Vitamins">Vitamins</button>
                            <button type="button" class="mg-chip" data-suggest="Antacids">Antacids</button>
                        </div>
                    </div>

                    <div class="mb-1">
                        <div class="d-flex justify-content-between align-items-end mb-1">
                            <label for="categoryModalDescription" class="form-label fw-semibold mb-0">Description <span class="text-muted fw-normal">(optional)</span></label>
                            <span class="mg-counter" id="categoryDescCount">0/250</span>
                        </div>
                        <textarea class="form-control" id="categoryModalDescription" name="Description" rows="3" maxlength="250" placeholder="What kind of medicines belong here?"></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="saveCategoryBtn" class="btn btn-teal-solid rounded-pill px-4">
                        <span class="spinner-border spinner-border-sm d-none me-1" role="status" aria-hidden="true"></span>
                        <i class="bi bi-check2-circle me-1"></i>Save category
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (function () {
        var modal = document.getElementById('categoryModal');
        var name = document.getElementById('categoryModalName');
        var desc = document.getElementById('categoryModalDescription');
        var nameCount = document.getElementById('categoryNameCount');
        var descCount = document.getElementById('categoryDescCount');

        function updateCounts() {
            nameCount.textContent = name.value.length + '/' + name.maxLength;
            descCount.textContent = desc.value.length + '/' + desc.maxLength;
        }

        name.addEventListener('input', updateCounts);
        desc.addEventListener('input', updateCounts);

        modal.querySelectorAll('[data-suggest]').forEach(function (chip) {
            chip.addEventListener('click', function () {
                name.value = chip.getAttribute('data-suggest');
                name.dispatchEvent(new Event('input', { bubbles: true }));
                name.focus();
            });
        });

        modal.addEventListener('shown.bs.modal', function () { name.focus(); updateCounts(); });
        modal.addEventListener('hidden.bs.modal', function () { setTimeout(updateCounts, 0); });
    })();
</script>

