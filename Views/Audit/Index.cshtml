
@model MediGuard.Models.ViewModels.AuditLogPageViewModel

@{
    ViewData["Title"] = "Audit Logs";
}

@section Styles {
<style>
    :root {
        --audit-teal: #007a78;
        --audit-teal-dark: #005f5d;
        --audit-teal-light: #e6f4f3;
        --audit-border: #e0e7e7;
    }

    .audit-page { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }

    /* Stat Cards */
    .audit-stat-card {
        background: #fff;
        border: 1px solid var(--audit-border);
        border-radius: 14px;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 2px 10px rgba(0,122,120,0.05);
        height: 100%;
    }

    .audit-stat-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6b7280;
        margin-bottom: 0.4rem;
    }

    .audit-stat-value {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--audit-teal);
        line-height: 1;
    }

    /* Main panel */
    .audit-panel {
        border-radius: 16px !important;
        box-shadow: 0 4px 24px rgba(0,0,0,0.06) !important;
        border: 1px solid var(--audit-border) !important;
    }

    /* Table */
    .audit-table thead th {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6b7280;
        border-bottom: 2px solid var(--audit-border);
        white-space: nowrap;
    }

    .audit-table tbody tr:hover { background: var(--audit-teal-light); }
    .audit-table tbody td { vertical-align: middle; padding: 0.85rem 1rem; font-size: 0.87rem; }

    /* Action Badges */
    .audit-action-badge {
        display: inline-block;
        padding: 0.3em 0.7em;
        border-radius: 6px;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    .audit-insert  { background: #d1fae5; color: #065f46; }
    .audit-update  { background: #dbeafe; color: #1d4ed8; }
    .audit-delete  { background: #fee2e2; color: #991b1b; }
    .audit-other   { background: #f3f4f6; color: #374151; }

    /* IP Address code */
    .audit-ip {
        font-size: 0.78rem;
        background: #f3f4f6;
        padding: 2px 7px;
        border-radius: 5px;
        color: #374151;
    }

    /* Empty state */
    .audit-empty-state { padding: 1.5rem; }
    .audit-empty-icon  { font-size: 2.5rem; color: #d1d5db; margin-bottom: 0.75rem; }

    /* JSON diff panel */
    .json-panel {
        border: 1px solid var(--audit-border);
        border-radius: 12px;
        overflow: hidden;
    }

    .json-panel-heading {
        background: #f8fafa;
        border-bottom: 1px solid var(--audit-border);
        padding: 0.6rem 1rem;
        font-size: 0.82rem;
        font-weight: 700;
        color: #4b5563;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .json-code {
        margin: 0;
        padding: 1rem;
        font-size: 0.78rem;
        line-height: 1.65;
        min-height: 160px;
        max-height: 420px;
        overflow-y: auto;
        background: #1e1e2e;
        color: #cdd6f4;
        white-space: pre-wrap;
        word-break: break-all;
    }

    /* JSON syntax highlighting */
    .json-key     { color: #89b4fa; }
    .json-string  { color: #a6e3a1; }
    .json-number  { color: #fab387; }
    .json-literal { color: #f38ba8; }

    @@media (max-width: 768px) {
        .audit-stat-value { font-size: 1.4rem; }
    }
</style>
}

<div class="audit-page container-fluid py-4">
    <div class="audit-heading d-flex flex-wrap
                justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-shield-check text-teal me-2"></i>Audit Logs & Activity Reports
            </h1>
            <p class="text-muted mb-0">
                Track security events, state changes, and staff operations in <strong>@Model.PharmacyName</strong>.
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Audit"
               asp-action="ExportCsv"
               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
               asp-route-userId="@Model.SelectedUserId"
               asp-route-actionType="@Model.SelectedAction"
               asp-route-searchTerm="@Model.SearchTerm"
               class="btn btn-outline-success d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-file-earmark-spreadsheet"></i>
                <span>Export Report (CSV)</span>
            </a>

            <button type="button"
                    class="btn btn-outline-secondary shadow-sm"
                    id="resetAuditFilters">
                Reset filters
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="audit-stat-card">
                <div class="audit-stat-label">Total matching logs</div>
                <div class="audit-stat-value" id="auditEntryCount">
                    @Model.Entries.Count
                </div>
                <div class="small text-muted mt-1">Filtered database records</div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="audit-stat-card">
                <div class="audit-stat-label">Mutations Breakdown</div>
                <div class="d-flex align-items-center gap-2 mt-2">
                    <span class="badge bg-success-subtle text-success fs-6 px-2 py-1">@Model.InsertCount Created</span>
                    <span class="badge bg-primary-subtle text-primary fs-6 px-2 py-1">@Model.UpdateCount Updated</span>
                    <span class="badge bg-danger-subtle text-danger fs-6 px-2 py-1">@Model.DeleteCount Deleted</span>
                </div>
                <div class="small text-muted mt-2">INSERT · UPDATE · DELETE actions</div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="audit-stat-card">
                <div class="audit-stat-label">Access & Compliance Scope</div>
                <div class="audit-stat-value fs-5 text-truncate" title="@Model.PharmacyName">
                    @Model.PharmacyName
                </div>
                <div class="small text-muted mt-1">
                    <i class="bi bi-lock-fill text-success me-1"></i>Strict Tenant RBAC Isolated
                </div>
            </div>
        </div>
    </div>

    <section class="card border-0 shadow-sm audit-panel">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h2 class="h5 mb-1">Activity History & Filters</h2>
            <p class="text-muted small mb-0">
                Filter and inspect recorded system changes by date, actor, action, or module.
            </p>
        </div>

        <div class="card-body px-4">
            <form method="get"
                  asp-controller="Audit"
                  asp-action="Index"
                  id="auditFilterForm">

                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-6 col-xl-2">
                        <label for="startDate"
                               class="form-label fw-semibold">
                            From date
                        </label>
                        <input type="date"
                               id="startDate"
                               name="startDate"
                               class="form-control"
                               value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-12 col-md-6 col-xl-2">
                        <label for="endDate"
                               class="form-label fw-semibold">
                            To date
                        </label>
                        <input type="date"
                               id="endDate"
                               name="endDate"
                               class="form-control"
                               value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <label for="userId"
                               class="form-label fw-semibold">
                            User
                        </label>
                        <select id="userId"
                                name="userId"
                                class="form-select">
                            <option value="">All users</option>
                            @foreach (var user in Model.Users)
                            {
                                <option value="@user.UserId"
                                        selected="@(Model.SelectedUserId == user.UserId)">
                                    @user.DisplayName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-xl-2">
                        <label for="actionType"
                               class="form-label fw-semibold">
                            Action type
                        </label>
                        <select id="actionType"
                                name="actionType"
                                class="form-select">
                            <option value="">All actions</option>
                            <option value="INSERT"
                                selected="@(Model.SelectedAction == "INSERT")">
                                INSERT / CREATE
                            </option>
                            <option value="UPDATE"
                                selected="@(Model.SelectedAction == "UPDATE")">
                                UPDATE / EDIT
                            </option>
                            <option value="DELETE"
                                selected="@(Model.SelectedAction == "DELETE")">
                                DELETE / REMOVE
                            </option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <label for="searchTerm"
                               class="form-label fw-semibold">
                            Search / Entity
                        </label>
                        <input type="text"
                               id="searchTerm"
                               name="searchTerm"
                               class="form-control"
                               placeholder="e.g. Medicine, Order, IP..."
                               value="@Model.SearchTerm" />
                    </div>

                    <div class="col-12 d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-funnel me-1"></i> Apply filters
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <div class="px-4 pb-4">
            <div id="auditError"
                 class="alert alert-danger d-none"
                 role="alert"></div>

            <div class="table-responsive">
                @await Html.PartialAsync(
                    "_AuditLogTable",
                    Model.Entries)
            </div>
        </div>
    </section>
</div>

<div class="modal fade"
     id="auditChangesModal"
     tabindex="-1"
     aria-labelledby="auditChangesModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 class="modal-title fs-5"
                        id="auditChangesModalLabel">
                        Change details
                    </h2>
                    <p class="text-muted small mb-0"
                       id="auditChangeSubtitle">
                        Compare recorded values before and after the action.
                    </p>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12 col-lg-6">
                        <div class="json-panel">
                            <div class="json-panel-heading">
                                <span>Old Values</span>
                                <span class="badge text-bg-secondary">
                                    BEFORE
                                </span>
                            </div>
                            <pre class="json-code"><code id="oldJsonContent"></code></pre>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="json-panel">
                            <div class="json-panel-heading">
                                <span>New Values</span>
                                <span class="badge text-bg-primary">
                                    AFTER
                                </span>
                            </div>
                            <pre class="json-code"><code id="newJsonContent"></code></pre>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/audit-logs.js"
            asp-append-version="true"></script>
}
